---
import Layout from '../layouts/Layout.astro';
import AgencyApplyForm from '../components/AgencyApplyForm.astro';

const lossCards = [
  { title: 'Weak monetization structure', text: 'Fans subscribe, chat a little, and disappear without entering any real sales flow.' },
  { title: 'Burned buyers', text: 'Aggressive PPV pushes kill long-term spending and reduce fan retention.' },
  { title: 'Inconsistent chatting', text: 'Different chatters create different experiences, making the page feel unstable and disconnected.' },
  { title: 'No monetization visibility', text: 'Most agencies see the revenue drop after it already happened — without knowing why.' },
];

const topAgencyReasons = [
  { title: 'Dedicated chatting teams per model.', text: 'Continuously trained through structured sales systems, QA reviews and ongoing performance analysis.' },
  { title: 'Monetization built around retention and LTV.', text: 'Focused on increasing repeat spending, stronger fan relationships and long-term revenue stability.' },
  { title: 'Native English & Spanish monetization teams.', text: 'Built to maximize conversion, retention and fan spending across different audiences and markets.' },
  { title: 'Structured monetization flows.', text: 'Warm-up, emotional engagement, upsells, retention and reactivation systems designed to maximize long-term fan value — not just short-term sales.' },
  { title: 'Advanced fan segmentation.', text: 'Different monetization strategies for whales, buyers, subscribers and dormant fans based on behavior and spending patterns.' },
  { title: 'Creator persona replication.', text: 'We deeply study each creator’s voice, personality, boundaries and audience dynamics to create authentic fan interactions that preserve immersion, strengthen emotional connection and maximize long-term fan spending.' },
  { title: 'Conversations designed to preserve immersion and emotional investment.', text: 'Because once the fan feels the page is fake, inconsistent or transactional, long-term spending drops fast.' },
  { title: 'Operational control over the monetization process.', text: 'Chats are constantly reviewed through QA systems, performance tracking and continuous optimization to maximize revenue, consistency and fan experience.' },
  { title: 'Full account management.', text: 'Content planning, posting, monetization, analytics, fan management and operational support structured to remove chaos and help creators scale more efficiently.' },
  { title: 'Structured monetization systems designed to scale.', text: 'Consistent execution, repeatable performance and reduced dependency on individual chatters as the agency grows.' },
];

const mapSteps = [
  { title: 'Fan Acquisition', text: 'Fans enter through the traffic systems.' },
  { title: 'Fan Qualification', text: 'Fans are identified based on spending potential, engagement level and behavior patterns.' },
  { title: 'Relationship Building', text: 'Conversations designed to build engagement, emotional investment and long-term retention.' },
  { title: 'Monetization Systems', text: 'Structured upsells, controlled PPV pacing, fan reactivation and long-term spender development.' },
  { title: 'Revenue Optimization', text: 'Continuous analysis of chatting performance, conversion flow, spending behavior and monetization results.' },
  { title: 'Quality Control', text: 'Conversation reviews, performance tracking and weekly monetization adjustments.' },
];

const howSteps = [
  { num: '01', title: 'Monetization Audit', text: 'We analyze the current chatting structure, fan behavior, spending patterns and monetization leaks across the page.' },
  { num: '02', title: 'System Integration', text: 'We implement the monetization workflows, segmentation systems, QA structure and chatting operations.' },
  { num: '03', title: 'Revenue Execution', text: 'We handle daily conversations, upsells, retention, fan relationships and long-term spender development.' },
  { num: '04', title: 'Analysis & Optimization', text: 'We continuously review chatting performance, conversion flow, fan spending behavior and monetization results.' },
];

const faqs = [
  { q: 'Do you work directly with my models?', a: 'No. We operate as your backend system. You keep full ownership of the relationship, the brand, and the communication. We simply handle monetization behind the scenes.' },
  { q: 'Will my models notice the difference?', a: 'No. Everything is adapted to each model’s tone, personality, and boundaries. From the outside, nothing changes. From the inside, revenue improves.' },
  { q: 'How do you ensure quality in chatting?', a: 'We use structured systems, not guesswork: dedicated chatters per model, internal QA and monitoring, performance tracking per chatter, and continuous optimization.' },
  { q: 'How fast can we start?', a: 'Once aligned, setup can be completed in 24 hours and we start optimizing immediately.' },
  { q: 'How do you get paid?', a: 'Performance-based. Each setup is different depending on your models, current revenue, and structure. We only make money if your revenue increases — that’s how we stay aligned.' },
  { q: 'Why work with you instead of building this in-house?', a: 'You can. But it requires time, hiring, training, management, and constant optimization. We give you a system that already works — without the operational complexity.' },
];
---

<Layout title="Chatting Service | MANGO" description="MANGO's chatting service for OnlyFans agencies. Dedicated chatters per model, structured sales flows and monetization systems built to scale." activeNav="for-agencies" lang="en" transparentTop={true}>

  <!-- 1. HERO — cinematic, deep overlay, atmospheric grain -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden grain">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/hero-agencies-v3.png');"></div>
    <div class="absolute inset-0" style="background-color:rgba(0,0,0,0.82);"></div>
    <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0) 30%, rgba(0,0,0,0.65));"></div>
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 50% at 78% 22%, rgba(186,154,110,0.1), transparent 65%);"></div>
    <div class="absolute inset-0 flex items-start pt-[18vh] md:items-center md:pt-0">
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full">
        <div class="max-w-[860px] flex flex-col gap-5 md:gap-7">
          <span class="text-[11px] uppercase tracking-[0.32em] text-white/55 font-medium">For Agencies &amp; Creators</span>
          <h1 class="font-display text-[30px] sm:text-5xl md:text-6xl lg:text-7xl xl:text-[76px] text-white leading-[0.96] tracking-[-0.025em]">
            <span class="block whitespace-nowrap">OnlyFans Chatting</span>
            <span class="block whitespace-nowrap">24/7 Service</span>
          </h1>
          <p class="text-white/75 text-base md:text-lg leading-relaxed font-body max-w-[820px]">
            We handle chatting 24/7 with an expert team trained to maximize revenue, retention and fan spending &mdash; so you can focus on growth and scaling.
          </p>
          <div class="mt-2">
            <a href="#agency-apply" class="inline-block bg-accent text-black font-bold px-7 py-3.5 md:py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">
              Apply now
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROBLEM positioning (cinematic editorial) -->
  <section class="relative py-24 md:py-56 section-cinematic grain">
    <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-10 flex flex-col gap-5 md:gap-10 text-center">
      <p class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[1.05] tracking-[-0.015em] md:whitespace-nowrap">You know how to generate traffic.</p>
      <p class="font-display text-3xl md:text-5xl lg:text-6xl text-white/45 leading-[1.05] tracking-[-0.015em]">We know how to maximize the monetization behind it.</p>
    </div>
  </section>

  <!-- 3. WHERE AGENCIES LOSE REVENUE (warm beige textured, the problems break) -->
  <section class="relative py-24 md:py-56 section-beige">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-24 md:mb-36 max-w-4xl">
        <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-on-surface leading-[0.94] tracking-[-0.025em]">Where agencies lose revenue</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24 gap-y-14 md:gap-y-20">
        {lossCards.map(card => (
          <div class="flex flex-col gap-4 pb-10 md:pb-12" style="border-bottom:1px solid rgba(17,17,17,0.2);">
            <h3 class="font-display text-2xl md:text-3xl lg:text-4xl text-on-surface leading-[1.05] tracking-[-0.015em]">{card.title}</h3>
            <p class="text-on-surface/65 text-base leading-relaxed max-w-md">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. WHY TOP AGENCIES CHOOSE TO WORK WITH US (sticky title left + 10 benefits right) -->
  <section class="relative py-24 md:py-56 section-panel grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <!-- Sticky headline column -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-4xl md:text-6xl lg:text-7xl xl:text-7xl text-white leading-[0.96] md:leading-[0.94] tracking-[-0.025em]">
            Why Top Agencies<br />Choose To Work<br />With Us
          </h2>
        </div>

        <!-- Benefits stacked right — editorial storytelling pattern matching the Pain section -->
        <div class="lg:col-span-7 flex flex-col">
          {topAgencyReasons.map((r, idx) => (
            <div class={`editorial-step pb-12 md:pb-20 ${idx === 0 ? '' : 'border-t pt-12 md:pt-20'}`} style="border-color:rgba(255,255,255,0.08);">
              <span class="block text-[11px] uppercase tracking-[0.32em] italic text-white/45 mb-5 md:mb-7" style="font-family:Georgia,'Times New Roman',serif;">{String(idx+1).padStart(2,'0')}</span>
              <h3 class="font-display text-2xl md:text-4xl lg:text-5xl text-white leading-[1.05] md:leading-[1.0] tracking-[-0.015em] mb-4 md:mb-6">{r.title}</h3>
              <p class="text-white/65 text-[15px] md:text-base leading-relaxed max-w-lg">{r.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Refined monetization system map: intro + 6 steps -->
      <div class="mt-28 md:mt-44">
        <div class="max-w-2xl mx-auto">
          <div class="mb-10 md:mb-14 text-center">
            <h3 class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[0.98] tracking-[-0.02em]">How Our Monetization System Works</h3>
            <p class="mt-5 md:mt-6 text-white/65 text-base md:text-lg leading-relaxed max-w-xl mx-auto">A structured chatting process designed to increase retention, fan spending and long-term revenue across your agency.</p>
          </div>
          {mapSteps.map((step, i) => (
            <div class={`py-9 md:py-11 grid grid-cols-12 gap-5 sm:gap-10 items-baseline ${i === 0 ? 'border-y' : 'border-b'}`} style="border-color:rgba(255,255,255,0.12);">
              <span class="col-span-2 text-xs uppercase tracking-[0.28em] italic text-white/45" style="font-family:Georgia,'Times New Roman',serif;">{String(i+1).padStart(2,'0')}</span>
              <div class="col-span-10 flex flex-col gap-2">
                <p class="font-display text-xl md:text-2xl text-white leading-tight tracking-[-0.01em]">{step.title}</p>
                <p class="text-white/65 text-sm md:text-base leading-relaxed max-w-lg">{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. HOW IT WORKS (dark panel, editorial workflow, no cards) -->
  <section class="relative py-24 md:py-56 section-panel grain">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-24 md:mb-36 max-w-3xl">
        <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-white leading-[0.94] tracking-[-0.025em]">How To Start With Us</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16">
        {howSteps.map(step => (
          <div class="flex flex-col gap-6">
            <span class="font-display leading-[0.85] tracking-[-0.02em]" style="font-size:clamp(56px, 8vw, 96px); color:rgba(255,255,255,0.18);">{step.num}</span>
            <h3 class="font-display text-xl md:text-2xl text-white leading-[1.1] tracking-[-0.01em]">{step.title}</h3>
            <p class="text-white/55 text-sm md:text-base leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. AGENCY APPLICATION FORM (dark, private application) -->
  <AgencyApplyForm lang="en" />

  <!-- 8. FAQ (dark panel, minimal hairline) -->
  <section class="relative py-24 md:py-48 section-panel grain">
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-10">
      <div class="mb-16 md:mb-24 max-w-3xl">
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[0.94] tracking-[-0.025em] md:whitespace-nowrap">Frequently Asked Questions</h2>
      </div>
      <div class="flex flex-col">
        {faqs.map((faq, idx) => (
          <details class={`group ${idx === 0 ? 'border-y' : 'border-b'} hover:bg-white/[0.02] transition-colors`} style="border-color:rgba(255,255,255,0.14);">
            <summary class="py-7 md:py-8 flex items-center justify-between cursor-pointer list-none select-none">
              <span class="font-display text-lg md:text-xl text-white pr-6 tracking-[-0.005em]">{faq.q}</span>
              <span class="material-symbols-outlined expand-icon flex-shrink-0 transition-transform duration-300" style="color:#C8A96A;">add</span>
            </summary>
            <div class="pb-8 text-white/65 text-sm md:text-base leading-relaxed max-w-2xl">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
