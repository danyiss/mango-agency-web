---
import Layout from '../layouts/Layout.astro';

const siteUrl = 'https://www.mangova.agency';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Aitor González Rivera",
  "jobTitle": "Founder, MANGO Agency",
  "description": "Aitor González Rivera is the founder of MANGO Agency. Five years in digital marketing and OnlyFans creator monetization, specialized in Instagram-led growth, OnlyFans monetization systems and in-house chatting operations.",
  "worksFor": {
    "@type": "Organization",
    "name": "MANGO Agency",
    "legalName": "AG MEDIA PRO LLC",
    "url": siteUrl,
  },
  "url": `${siteUrl}/about`,
  "sameAs": ["https://de.linkedin.com/in/aitorgonzalezrivera"],
};

const aboutPageSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "url": `${siteUrl}/about`,
  "name": "About MANGO Agency",
  "description": "MANGO is an OnlyFans management agency that scales content creators by combining a dedicated in-house chatting team, structured monetization systems and Instagram-led social media growth. Operating on a performance-based model, MANGO works with creators in Europe and Asia in both English and Spanish — focused on retention, fan LTV and predictable monthly revenue rather than short-term spikes.",
  "inLanguage": "en",
  "isPartOf": { "@type": "WebSite", "name": "MANGO", "url": siteUrl },
  "about": {
    "@type": "Organization",
    "name": "MANGO",
    "legalName": "AG MEDIA PRO LLC",
    "url": siteUrl,
  },
  "mainEntity": personSchema,
};
---

<Layout
  title="About MANGO Agency | OnlyFans Management Founded by Aitor González"
  description="MANGO Agency was founded by Aitor González Rivera, a digital marketing specialist with five years in OnlyFans growth and monetization. A small roster, fully personalized strategies."
  activeNav=""
  lang="en"
  transparentTop={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <!-- 1. HERO -->
  <section class="relative min-h-[60vh] -mt-16 w-full overflow-hidden flex items-end pb-16 md:pb-24 section-cinematic grain">
    <div class="atmosphere-glow magenta" style="top:14%;right:-12%;width:520px;height:520px;opacity:0.35;"></div>
    <div class="atmosphere-glow crimson" style="bottom:-10%;left:-12%;width:480px;height:480px;opacity:0.3;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full pt-32 md:pt-40">
      <div class="flex flex-col items-start gap-6 md:gap-8 max-w-4xl">
        <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style="font-family:Georgia,'Times New Roman',serif;">About MANGO</span>
        <h1 class="font-display text-[44px] sm:text-7xl md:text-8xl lg:text-[120px] xl:text-[140px] text-white leading-[0.92] tracking-[-0.03em]">A small agency,<br />by design.</h1>
        <p class="text-white/65 text-[15px] md:text-base lg:text-lg leading-relaxed max-w-2xl">MANGO Agency is an OnlyFans management agency built around a small roster of creators. Every strategy is fully personalized — no shared teams, no generic playbooks, no scaling for the sake of headcount.</p>
      </div>
    </div>
  </section>

  <!-- 2. FOUNDER STORY -->
  <section class="relative py-24 md:py-40 section-panel grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <span class="block text-[11px] uppercase tracking-[0.32em] italic text-white/45 mb-5 md:mb-7" style="font-family:Georgia,'Times New Roman',serif;">Founder</span>
          <h2 class="font-display text-5xl md:text-7xl lg:text-7xl xl:text-7xl text-white leading-[0.94] md:leading-[0.92] tracking-[-0.025em]">Aitor<br />González<br />Rivera</h2>
          <p class="mt-8 text-white/55 text-sm tracking-[0.18em] uppercase">Founder · AG Media Pro LLC</p>
          <a href="https://de.linkedin.com/in/aitorgonzalezrivera" target="_blank" rel="noopener" class="mt-6 inline-block text-accent hover:text-accent/80 text-sm tracking-[0.18em] uppercase underline underline-offset-4 transition-colors">LinkedIn →</a>
        </div>

        <div class="lg:col-span-7 flex flex-col gap-6 md:gap-8">
          <p class="font-display text-2xl md:text-3xl lg:text-4xl text-white leading-[1.15] tracking-[-0.015em] max-w-2xl">A case study turned into an agency.</p>
          <div class="flex flex-col gap-5 text-white/70 text-base md:text-lg leading-relaxed max-w-2xl">
            <p>Aitor González Rivera is the founder of MANGO Agency. Before MANGO, he built and scaled his own personal brand on social media focused entirely on driving traffic for OnlyFans — a project that became a personal case study, and the foundation of everything MANGO does today.</p>
            <p>With five years of experience in digital marketing and creator monetization, his focus has narrowed to two channels: Instagram-led organic growth and OnlyFans monetization systems. The agency is built around that combination — a marketing team focused on attention, an in-house chatting team with years of experience converting that attention into revenue, and a single founder making sure every strategy stays fully personalized.</p>
            <p>MANGO works with a deliberately small group of creators at any given time. The point is not to scale by signing more talent — it is to scale each creator's own business behind the page.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. AGENCY ENTITY -->
  <section class="relative py-24 md:py-40 section-cinematic grain">
    <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 text-center flex flex-col items-center gap-8 md:gap-12">
      <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style="font-family:Georgia,'Times New Roman',serif;">The legal entity</span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[0.98] tracking-[-0.02em] max-w-2xl">AG Media Pro LLC</h2>
      <div class="flex flex-col gap-3 text-white/70 text-base md:text-lg leading-relaxed max-w-xl">
        <p>MANGO Agency operates under <strong class="text-white/85">AG Media Pro LLC</strong>, a Wyoming-registered company founded in April 2025.</p>
        <p>Operations cover Europe and Asia, with native English and Spanish chatting teams. The agency works on a performance-based model — it earns when the creator earns more, never before.</p>
      </div>
      <a href="/#apply" class="inline-block bg-accent text-black font-bold px-8 py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all mt-4">Apply to work with us</a>
    </div>
  </section>

</Layout>
