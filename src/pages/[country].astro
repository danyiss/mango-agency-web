---
// Country hub pages: /[country]. Data in src/data/countries.ts; cities attached by ISO code.
import Layout from '../layouts/Layout.astro';
import { countries, type CountryData } from '../data/countries';
import { cities } from '../data/cities';

export async function getStaticPaths() {
  return countries.map((c) => ({ params: { country: c.slug }, props: { country: c } }));
}

interface Props { country: CountryData }
const { country } = Astro.props as Props;
const lang = 'en';
const siteUrl = 'https://www.mangova.agency';
const pageUrl = `${siteUrl}/${country.slug}`;
const altUrl = `${siteUrl}/es/${country.slug}`;
const countryCities = cities.filter((c) => c.countryCode === country.code);

const title = `OnlyFans Agency in ${country.name.en} | MANGO`;
const description = `MANGO is an OnlyFans management agency working with creators in ${country.name.en}: ${country.primaryLanguage === 'es' ? 'native Spanish' : 'bilingual English and Spanish'} chatting, marketing and content strategy for 50% of net. How the ${country.name.en} market works, how you get paid and where we operate.`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `OnlyFans Management in ${country.name.en}`,
  "provider": { "@type": "Organization", "name": "MANGO Agency", "legalName": "AG MEDIA PRO LLC", "url": siteUrl },
  "areaServed": { "@type": "Country", "name": country.name.en },
  "serviceType": "OnlyFans Talent Management",
  "description": description,
  "url": pageUrl,
  "audience": { "@type": "Audience", "audienceType": "OnlyFans creators" },
};
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": pageUrl, "name": title, "description": description, "inLanguage": lang,
  "isPartOf": { "@type": "WebSite", "name": "MANGO", "url": siteUrl },
  "about": { "@type": "Organization", "name": "MANGO", "url": siteUrl },
  "primaryImageOfPage": { "@type": "ImageObject", "url": `${siteUrl}/og-image.png` },
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": country.faqs.en.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": `OnlyFans Agency in ${country.name.en}`, "item": pageUrl },
  ],
};
const label = "block text-[11px] uppercase tracking-[0.32em] italic text-white/45 mb-5 md:mb-7";
const serif = "font-family:Georgia,'Times New Roman',serif;";
---

<Layout title={title} description={description} activeNav="" lang="en" transparentTop={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <link rel="alternate" hreflang="es" href={altUrl} />
  </Fragment>

  <!-- 1. HERO -->
  <section class="relative min-h-[55vh] -mt-16 w-full overflow-hidden flex items-end pb-16 md:pb-24 section-cinematic grain">
    <div class="atmosphere-glow magenta" style="top:14%;right:-12%;width:520px;height:520px;opacity:0.35;"></div>
    <div class="atmosphere-glow crimson" style="bottom:-10%;left:-12%;width:480px;height:480px;opacity:0.3;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full pt-32 md:pt-40">
      <div class="flex flex-col items-start gap-6 md:gap-8 max-w-4xl">
        <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style={serif}>{country.region.en} · {country.name.en}</span>
        <h1 class="font-display text-[44px] sm:text-7xl md:text-8xl lg:text-[110px] xl:text-[130px] text-white leading-[0.92] tracking-[-0.03em]">OnlyFans Agency<br />in {country.name.en}.</h1>
        <p class="text-white/65 text-[15px] md:text-base lg:text-lg leading-relaxed max-w-2xl">MANGO manages OnlyFans accounts for creators in {country.name.en}: {country.primaryLanguage === 'es' ? 'native Spanish' : 'bilingual English and Spanish'} chatting 24/7, marketing, content strategy and protection, for 50% of net. Fully remote, deliberately small roster, no minimum revenue to start.</p>
        <a href="/#apply" class="inline-block bg-accent text-black font-bold px-8 py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all mt-2">Apply to work with us</a>
      </div>
    </div>
  </section>

  <!-- 2. MARKET CONTEXT -->
  <section class="relative py-24 md:py-36 section-panel grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <div class="lg:col-span-5">
          <span class={label} style={serif}>The {country.name.en} market</span>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[1.0] tracking-[-0.02em]">How OnlyFans creators in {country.name.en} actually earn.</h2>
        </div>
        <div class="lg:col-span-7 flex flex-col gap-5 md:gap-6 text-white/75 text-base md:text-lg leading-relaxed">
          <p>{country.marketContext.en}</p>
          <p>{country.localAngle.en}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. FACTS -->
  <section class="relative py-20 md:py-28 section-cinematic grain">
    <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
        <div class="flex flex-col gap-2"><span class="text-[10px] uppercase tracking-[0.28em] text-white/45">Region</span><span class="text-white text-base md:text-lg">{country.region.en}</span></div>
        <div class="flex flex-col gap-2"><span class="text-[10px] uppercase tracking-[0.28em] text-white/45">Time zone</span><span class="text-white text-base md:text-lg">{country.utcOffset}</span></div>
        <div class="flex flex-col gap-2"><span class="text-[10px] uppercase tracking-[0.28em] text-white/45">Chatting language</span><span class="text-white text-base md:text-lg">{country.variant.en}</span></div>
        <div class="flex flex-col gap-2"><span class="text-[10px] uppercase tracking-[0.28em] text-white/45">Our fee</span><span class="text-white text-base md:text-lg">50% of net</span></div>
      </div>
    </div>
  </section>

  <!-- 4. GETTING PAID -->
  <section class="relative py-24 md:py-36 section-panel grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <div class="lg:col-span-5">
          <span class={label} style={serif}>Getting paid</span>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[1.0] tracking-[-0.02em]">How payouts work from {country.name.en}.</h2>
        </div>
        <div class="lg:col-span-7 flex flex-col gap-5 md:gap-6 text-white/75 text-base md:text-lg leading-relaxed">
          <p>{country.practical.en}</p>
          <p class="text-white/55 text-sm md:text-base">For the full breakdown of what agencies charge and why the percentage must be on net, read <a href="/blog/how-much-does-an-onlyfans-agency-charge" class="text-white/80 underline underline-offset-4 hover:text-white">how much an OnlyFans agency charges</a>.</p>
        </div>
      </div>
    </div>
  </section>

  {countryCities.length > 0 && (
  <!-- 5. CITIES -->
  <section class="relative py-20 md:py-28 section-cinematic grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <span class={label} style={serif}>Where we work in {country.name.en}</span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-white leading-[1.0] tracking-[-0.02em] mb-10">Cities with creators managed by MANGO.</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {countryCities.map((c) => (
          <a href={`/${c.slug}`} class="group flex flex-col gap-1 border border-white/10 rounded-[10px] px-5 py-5 hover:border-white/40 transition-colors">
            <span class="text-white text-lg md:text-xl font-display">{c.name}</span>
            <span class="text-white/45 text-xs uppercase tracking-[0.2em]">OnlyFans agency in {c.name} →</span>
          </a>
        ))}
      </div>
      <p class="text-white/45 text-sm mt-8">Not in one of these cities? Management is fully remote: the team is the same anywhere in {country.name.en}.</p>
    </div>
  </section>
  )}

  <!-- 6. SERVICES -->
  <section class="relative py-24 md:py-36 section-panel grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-12 md:mb-16 max-w-3xl">
        <span class={label} style={serif}>What MANGO does for creators in {country.name.en}</span>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[1.0] tracking-[-0.02em]">A small agency, by design.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
        {[
          { t: 'Chatting & Monetization', d: `24/7 ${country.variant.en} chatting team focused on fan retention, higher spending and long-term LTV.` },
          { t: 'Social Media Growth', d: 'Instagram-led organic growth built around creator branding and viral content.' },
          { t: 'Content Strategy', d: 'Content direction grounded in performance data — what to film, why, and how it converts.' },
          { t: 'Personalized Management', d: 'No shared teams. Each creator gets dedicated support around their image, audience and goals.' },
          { t: 'Operations & Scaling', d: 'Structured workflows, QA and performance tracking so scaling does not break consistency.' },
          { t: 'Protection & Support', d: 'Leak protection, DMCA, account safety and continuous operational backing.' },
        ].map((s) => (
          <div class="flex flex-col gap-3">
            <h3 class="font-display text-xl md:text-2xl text-white leading-[1.1] tracking-[-0.015em]">{s.t}</h3>
            <p class="text-white/65 text-sm md:text-base leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="relative py-24 md:py-36 section-cinematic grain">
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8">
      <span class={label} style={serif}>Questions from creators in {country.name.en}</span>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-white leading-[1.0] tracking-[-0.02em] mb-10">Frequently asked questions.</h2>
      <div class="flex flex-col divide-y divide-white/10">
        {country.faqs.en.map((f) => (
          <div class="py-7 md:py-8">
            <h3 class="text-white text-lg md:text-xl font-semibold leading-snug mb-3">{f.q}</h3>
            <p class="text-white/70 text-base md:text-lg leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. CTA -->
  <section class="relative py-24 md:py-36 section-panel grain">
    <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 text-center flex flex-col items-center gap-8 md:gap-12">
      <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style={serif}>Apply</span>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[0.98] tracking-[-0.02em] max-w-2xl">Built for creators who want more.</h2>
      <p class="text-white/70 text-base md:text-lg leading-relaxed max-w-xl">If you are based in {country.name.en} and want to scale your OnlyFans with structured systems and a dedicated team, send your application. We reply to every one.</p>
      <a href="/#apply" class="inline-block bg-accent text-black font-bold px-8 py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">Apply to work with us</a>
      <p class="text-white/45 text-sm leading-relaxed max-w-xl">Choosing an agency? Read our <a href="/blog/how-to-choose-a-trustworthy-onlyfans-agency" class="text-white/70 underline underline-offset-4 hover:text-white">10-point checklist to tell if an OnlyFans agency is legit</a> before you sign anything.</p>
    </div>
  </section>
</Layout>
