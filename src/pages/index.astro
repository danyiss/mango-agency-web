---
import Layout from '../layouts/Layout.astro';
import ApplyForm from '../components/ApplyForm.astro';
import { useTranslations } from '../i18n/translations';

const t = useTranslations('en');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": t('home.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a1') }},
    { "@type": "Question", "name": t('home.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a2') }},
    { "@type": "Question", "name": t('home.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a3') }},
    { "@type": "Question", "name": t('home.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a4') }},
    { "@type": "Question", "name": t('home.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a5') }},
    { "@type": "Question", "name": t('home.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a6') }},
    { "@type": "Question", "name": t('home.faq.q7'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a7') }},
    { "@type": "Question", "name": t('home.faq.q8'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a8') }},
    { "@type": "Question", "name": t('home.faq.q9'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a9') }},
    { "@type": "Question", "name": t('home.faq.q10'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a10') }},
    { "@type": "Question", "name": t('home.faq.q11'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a11') }},
    { "@type": "Question", "name": t('home.faq.q12'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a12') }},
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "OnlyFans Management",
  "provider": { "@type": "Organization", "name": "MANGO Agency" },
  "description": "System-driven talent management for content creators. Chatting operations, marketing strategy, traffic generation, and operational optimization.",
  "serviceType": "Talent Management Agency",
  "areaServed": ["Europe", "Asia"],
};
---

<Layout title="MANGO | For Creators, By Creators" activeNav="home" lang="en" transparentTop={true}>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/assets/hero-home.png" type="image/png" />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- 1. HERO SECTION -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/hero-home.png');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/30 to-black/10"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
        <div class="max-w-[640px] flex flex-col gap-7">
          <span class="text-[11px] font-semibold tracking-[0.3em] uppercase text-white/70">For creators, by creators</span>
          <h1 class="font-display text-5xl sm:text-6xl md:text-7xl text-white leading-[1.05]">
            Scale your OnlyFans into 5&ndash;6 figure months
          </h1>
          <p class="text-white/85 text-lg md:text-xl leading-relaxed font-body max-w-lg">
            We build the systems behind top creators &mdash; so you can focus on content while we handle growth and monetization.
          </p>
          <div class="mt-3">
            <a href="#apply" class="inline-block bg-accent text-black font-bold px-8 py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all shadow-lg">
              Apply now
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-6 md:bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/50">
      <span class="text-[10px] font-medium tracking-[0.3em] uppercase">{t('home.hero.scroll')}</span>
      <span class="material-symbols-outlined animate-bounce">keyboard_arrow_down</span>
    </div>
  </section>

  <!-- 2. FULL-WIDTH EDITORIAL #1 -->
  <section class="relative w-full overflow-hidden" style="height:min(80vh,720px);">
    <!-- TODO: Replace with image provided by user -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/hero-system.webp');"></div>
    <div class="absolute inset-0" style="background-color: rgba(17,17,17,0.55);"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 text-center flex flex-col gap-8 items-center">
        <h2 class="font-display text-4xl md:text-6xl text-white leading-[1.05]">The next level of your creator career starts here.</h2>
        <p class="text-white/80 text-lg md:text-xl leading-relaxed max-w-2xl">We help creators build influence, audience and long-term income.</p>
        <div class="mt-2">
          <a href="#apply" class="inline-block bg-accent text-black font-bold px-9 py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">
            Apply to work with us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SERVICES SPLIT EDITORIAL -->
  <section class="py-32 md:py-40 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

        <!-- Left: Copy -->
        <div class="flex flex-col gap-10 order-2 lg:order-1">
          <div class="flex flex-col gap-6">
            <span class="text-[11px] font-semibold tracking-[0.3em] uppercase" style="color:#707B66;">The work</span>
            <h2 class="font-display text-4xl md:text-6xl text-on-surface leading-[1.05]">Everything your creator brand needs &mdash; handled for you.</h2>
            <p class="text-on-surface-variant text-lg leading-relaxed max-w-lg">A discreet, hands-on team built around your career. Three pillars, executed every day, so you can focus on creating.</p>
          </div>

          <div class="flex flex-col divide-y divide-outline-variant/40">
            {[
              { num: '01', title: 'Monetization', text: '24/7 chatting focused on building real fan connections, stronger relationships and higher spending fans.' },
              { num: '02', title: 'Growth', text: 'Instagram growth systems and high-intent traffic built to grow your audience and bring in paying fans.' },
              { num: '03', title: 'Protection', text: 'Leak removals and ongoing DMCA support to protect your content and your brand.' },
            ].map(p => (
              <div class="py-8 flex gap-6 items-start">
                <span class="font-display text-2xl md:text-3xl flex-shrink-0" style="color:#C8A96A;">{p.num}</span>
                <div class="flex flex-col gap-2">
                  <h3 class="font-display text-2xl md:text-3xl text-on-surface">{p.title}</h3>
                  <p class="text-on-surface-variant text-base leading-relaxed">{p.text}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Editorial image -->
        <!-- TODO: Replace with lifestyle image provided by user -->
        <div class="order-1 lg:order-2 w-full overflow-hidden" style="aspect-ratio: 4/5;">
          <img src="/assets/hero-agencies-v3.png" alt="Creator brand visual" class="w-full h-full object-cover block" loading="lazy" />
        </div>

      </div>
    </div>
  </section>

  <!-- 4. FULL-WIDTH EDITORIAL #2 -->
  <section class="relative w-full overflow-hidden" style="height:min(75vh,680px);">
    <!-- TODO: Replace with image provided by user -->
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/hero-results.webp');"></div>
    <div class="absolute inset-0" style="background-color: rgba(17,17,17,0.5);"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 text-center flex flex-col gap-8 items-center">
        <h2 class="font-display text-5xl md:text-7xl text-white leading-[1.05]">Mango suits you.</h2>
        <p class="text-white/85 text-lg md:text-xl leading-relaxed">Ready for your next level?</p>
        <div class="mt-2">
          <a href="#apply" class="inline-block bg-accent text-black font-bold px-9 py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">
            Apply to work with us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. APPLY FORM (centered editorial) -->
  <ApplyForm lang="en" />

  <!-- 6. FAQ SECTION -->
  <section class="py-32 md:py-40" style="background-color:#D8C8B8;">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="mb-16 text-center flex flex-col gap-4 items-center">
        <span class="text-[11px] font-semibold tracking-[0.3em] uppercase" style="color:#707B66;">Questions</span>
        <h2 class="font-display text-4xl md:text-6xl text-on-surface leading-[1.05]">Frequently asked.</h2>
      </div>
      <div class="flex flex-col">
        {[
          {
            q: "What makes you different from other agencies?",
            a: `<p>Most agencies rely on volume — more content, more posts, more messages.</p><p>We focus on performance.</p><p>We combine:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>A marketing team focused on generating consistent traffic</li><li>A dedicated in-house chatting team per model (not shared across accounts)</li><li>Structured sales systems (dripping, upsells, retention)</li><li>Weekly optimization based on real performance data (revenue, conversion, LTV)</li></ul><p>We don't work with everyone. We select the right creators and focus on scaling them properly.</p>`,
          },
          {
            q: "Why should I work with an agency?",
            a: `<p>Because most creators are leaving money on the table — on both sides.</p><p>Traffic without monetization doesn't scale.<br />Monetization without traffic doesn't grow.</p><p>We handle both.</p><p>Marketing brings consistent traffic.<br />Chatting turns that traffic into revenue.</p><p>So you can focus on content while everything behind the scenes is optimized.</p>`,
          },
          {
            q: "How much can I expect to grow?",
            a: `<p>It depends on your starting point.</p><p>Most creators we work with see:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>Higher revenue per subscriber</li><li>Better conversion from fans to buyers</li><li>More consistent daily income</li></ul><p>In many cases, creators move from unstable income to predictable monthly revenue by improving both traffic and monetization.</p>`,
          },
          {
            q: "Is it safe to give access to my account?",
            a: `<p>Yes.</p><p>We only require your credentials once to securely connect your account to our CRM.</p><p>After that, our team works through the platform without needing direct access to your login details.</p><p>Your account stays protected, and you keep full control at all times.</p>`,
          },
          {
            q: "Will you change my personality or how I interact with fans?",
            a: `<p>No.</p><p>We adapt to your personality — not the other way around.</p><p>Before starting, we collect detailed information about your tone, preferences, and boundaries to replicate your style as accurately as possible.</p>`,
          },
          {
            q: "Do you help with content creation?",
            a: `<p>Yes.</p><p>We provide clear content strategies, references, and direction based on what performs best.</p><p>You don't have to guess what to post — we guide you on what actually converts.</p>`,
          },
          {
            q: "How does the process work?",
            a: `<p>Apply &rarr; Evaluation call &rarr; System setup &rarr; Launch &amp; optimization</p><p>Once everything is aligned, we can start quickly and begin improving your revenue from day one.</p>`,
          },
          {
            q: "Do I keep control of my account?",
            a: `<p>Always.</p><p>You keep full ownership, visibility, and control at all times.</p>`,
          },
          {
            q: "How is chatting quality maintained?",
            a: `<p>We use a system-based approach:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>24/7 monitoring</li><li>Dedicated QA team</li><li>Performance tracking per chatter</li><li>Continuous optimization</li></ul><p>Everything is measured and improved constantly.</p>`,
          },
          {
            q: "Can I stop anytime?",
            a: `<p>Yes.</p><p>We don't lock creators into long-term contracts.</p><p>We only work together if it makes sense for both sides.</p>`,
          },
          {
            q: "How do payments work?",
            a: `<p>We work on a performance-based model.</p><p>That means we only make money if you make more money.</p><p>Details are discussed during the evaluation call to fit your specific situation.</p>`,
          },
          {
            q: "Who is this NOT for?",
            a: `<p>Creators who are not consistent, don't take this seriously, or are just starting.</p><p>We don't take everyone.</p><p>We work with creators who already have traction and want to scale their revenue properly.<br />We focus on building systems — not chasing short-term spikes.</p>`,
          },
        ].map(faq => (
          <details class="group border-b border-on-surface/15">
            <summary class="py-7 flex items-center justify-between cursor-pointer list-none select-none">
              <span class="font-display text-lg md:text-xl text-on-surface pr-6">{faq.q}</span>
              <span class="material-symbols-outlined expand-icon flex-shrink-0 transition-transform duration-300" style="color:#707B66;">add</span>
            </summary>
            <div class="pb-8 text-on-surface-variant text-sm md:text-base leading-relaxed flex flex-col gap-3 max-w-2xl" set:html={faq.a}></div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
