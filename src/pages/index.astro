---
import Layout from '../layouts/Layout.astro';
import ApplyForm from '../components/ApplyForm.astro';
import { useTranslations } from '../i18n/translations';

const t = useTranslations('en');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": t('home.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a1') }},
    { "@type": "Question", "name": t('home.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a2') }},
    { "@type": "Question", "name": t('home.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a3') }},
    { "@type": "Question", "name": t('home.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a4') }},
    { "@type": "Question", "name": t('home.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a5') }},
    { "@type": "Question", "name": t('home.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a6') }},
    { "@type": "Question", "name": t('home.faq.q7'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a7') }},
    { "@type": "Question", "name": t('home.faq.q8'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a8') }},
    { "@type": "Question", "name": t('home.faq.q9'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a9') }},
    { "@type": "Question", "name": t('home.faq.q10'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a10') }},
    { "@type": "Question", "name": t('home.faq.q11'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a11') }},
    { "@type": "Question", "name": t('home.faq.q12'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a12') }},
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "OnlyFans Management",
  "provider": { "@type": "Organization", "name": "MANGO Agency" },
  "description": "System-driven talent management for content creators. Chatting operations, marketing strategy, traffic generation, and operational optimization.",
  "serviceType": "Talent Management Agency",
  "areaServed": ["Europe", "Asia"],
};
---

<Layout title="MANGO | OnlyFans Management Agency for Creators" description="Modern OnlyFans management agency. Full-service growth, monetization and creator branding built to scale OnlyFans creators long-term." activeNav="home" lang="en" transparentTop={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- 1. HERO — Unified full-bleed cinematic scene. Desktop: smooth left fade, no split. Mobile: distinct portrait crop. -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden">
    <!-- Full-bleed cinematic image — desktop: wide composition with creator on right third -->
    <div class="absolute inset-0 bg-cover bg-no-repeat hidden md:block" style="background-image:url('/assets/hero-home-v4.jpg'); background-position: 62% center; background-size: cover; filter: brightness(0.92) contrast(1.06) saturate(1.04);"></div>
    <!-- Full-bleed cinematic image — mobile: tighter crop, creator centered vertically -->
    <div class="absolute inset-0 bg-cover bg-no-repeat md:hidden" style="background-image:url('/assets/hero-mobile-v2.jpg'); background-position: 56% 62%; background-size: cover; filter: brightness(0.96) contrast(1.04) saturate(1.03);"></div>

    <!-- Desktop: soft left-to-transparent atmospheric fade — atmosphere stays visible behind text -->
    <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: linear-gradient(to right, rgba(5,5,5,0.72) 0%, rgba(5,5,5,0.55) 16%, rgba(5,5,5,0.34) 32%, rgba(5,5,5,0.16) 48%, rgba(5,5,5,0.05) 62%, transparent 75%);"></div>
    <!-- Desktop: magenta bleed from image into the text zone (extends the image's atmosphere) -->
    <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: radial-gradient(ellipse 50% 60% at 30% 52%, rgba(168,52,92,0.12), transparent 70%), radial-gradient(ellipse 35% 45% at 12% 38%, rgba(132,38,62,0.08), transparent 65%);"></div>
    <!-- Desktop: subtle vertical vignette (top + bottom) -->
    <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: linear-gradient(to bottom, rgba(0,0,0,0.32) 0%, transparent 16%, transparent 76%, rgba(0,0,0,0.55) 100%);"></div>
    <!-- Desktop: soft full-frame vignette -->
    <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: radial-gradient(ellipse 110% 100% at 55% 50%, transparent 60%, rgba(0,0,0,0.4));"></div>

    <!-- Mobile: top-left diagonal darkness — softer so the cinematic atmosphere remains visible behind text -->
    <div class="absolute inset-0 pointer-events-none md:hidden" style="background: linear-gradient(150deg, rgba(5,5,5,0.74) 0%, rgba(5,5,5,0.52) 22%, rgba(5,5,5,0.26) 44%, rgba(5,5,5,0.08) 62%, transparent 78%);"></div>
    <!-- Mobile: subtle top fade behind headline -->
    <div class="absolute inset-x-0 top-0 pointer-events-none md:hidden" style="height:50%; background: linear-gradient(to bottom, rgba(5,5,5,0.38) 0%, transparent);"></div>
    <!-- Mobile: bottom soft vignette -->
    <div class="absolute inset-x-0 bottom-0 pointer-events-none md:hidden" style="height:30%; background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);"></div>

    <!-- Subtle grain — adds cinematic film texture to the whole scene -->
    <div class="grain absolute inset-0 pointer-events-none" style="opacity:0.55;"></div>

    <!-- CONTENT — mobile: top-left, clear of nav; desktop: vertically centered, left half -->
    <div class="relative z-10 h-full max-w-7xl mx-auto px-6 lg:px-10 flex items-start md:items-center pt-28 md:pt-0">
      <div class="flex flex-col items-start gap-5 md:gap-9 md:w-[55%] max-w-[15ch] md:max-w-none">
        <h1 class="font-display text-[34px] sm:text-6xl md:text-6xl lg:text-7xl xl:text-[96px] text-white leading-[1.02] md:leading-[0.92] tracking-[-0.025em] text-left">
          <span class="md:hidden">Premium<br />OnlyFans<br />Management</span>
          <span class="hidden md:inline">Premium OnlyFans<br />Management</span>
        </h1>
        <p class="text-white/80 text-[14px] md:text-base lg:text-lg leading-relaxed font-body max-w-[22ch] sm:max-w-md text-left">
          We scale OnlyFans creators through strategic social media growth, stronger monetization and personalized support built for long-term success.
        </p>
        <a href="#apply" class="inline-block bg-accent text-black font-bold px-7 py-3.5 md:py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">
          Apply to work with us
        </a>
        <p class="text-[10px] uppercase tracking-[0.3em] text-white/45 font-medium mt-1">For creators, by creators.</p>
      </div>
    </div>
  </section>

  <!-- 1b. EDITORIAL METRICS — 4 horizontal cards (unified magenta/burgundy atmosphere) -->
  <section class="relative py-20 md:py-52 overflow-hidden">
    <div class="grain absolute inset-0 pointer-events-none"></div>
    <div class="atmosphere-glow magenta" style="top:-10%;right:-6%;width:520px;height:520px;opacity:0.5;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {[
          { metric: '24/7', size: 'text-7xl md:text-7xl lg:text-[5.5rem]', title: 'Monetization', text: 'Native English & Spanish chatting focused on retention and long-term LTV.', glow: 'warm' },
          { metric: '5–6 Figures', size: 'text-5xl md:text-5xl lg:text-[3.5rem]', title: 'Monthly Scaling', text: 'Structured growth designed to scale creators from $1k to multi 6-figures.', glow: null },
          { metric: '+5 Billion', size: 'text-5xl md:text-6xl lg:text-[4rem]', title: 'Views Generated', text: 'Instagram growth built around virality, positioning and creator branding.', glow: 'crimson' },
          { metric: '+30% LTV', size: 'text-5xl md:text-5xl lg:text-[3.25rem]', title: 'Higher Fan Value', text: 'Chatting designed to increase fan spending and long-term monetization.', glow: null },
        ].map(c => (
          <div
            class="relative rounded-2xl px-7 py-10 md:px-10 md:py-16 lg:px-11 lg:py-20 flex flex-col justify-between min-h-[240px] md:min-h-[420px] transition-all duration-300 hover:bg-white/[0.028] overflow-hidden"
            style="background-color:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);"
          >
            {c.glow === 'warm' && (
              <div class="absolute pointer-events-none" style="top:-20%;right:-25%;width:80%;height:75%;border-radius:9999px;background:radial-gradient(circle, rgba(214,183,122,0.16), transparent 70%);filter:blur(36px);"></div>
            )}
            {c.glow === 'crimson' && (
              <div class="absolute pointer-events-none" style="bottom:-25%;left:-25%;width:85%;height:80%;border-radius:9999px;background:radial-gradient(circle, rgba(184,42,72,0.18), transparent 70%);filter:blur(40px);"></div>
            )}

            <div class="relative z-10">
              <p class={`font-display ${c.size} text-white leading-[0.92] tracking-[-0.025em]`} style="text-wrap:balance;">{c.metric}</p>
            </div>

            <div class="relative z-10 flex flex-col gap-4 mt-10 md:mt-16">
              <p class="text-[13px] uppercase tracking-[0.21em] font-semibold" style="color:#c8a96a;">{c.title}</p>
              <p class="text-[13px] md:text-sm text-white/65 leading-[1.6] max-w-[26ch] font-normal">{c.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2a. REELS ECOSYSTEM (virality / attention / creator culture) -->
  <section class="relative py-20 md:py-52 overflow-hidden">
    <div class="grain absolute inset-0 pointer-events-none"></div>
    <div class="atmosphere-glow magenta" style="top:8%;right:-8%;width:560px;height:560px;"></div>
    <div class="atmosphere-glow crimson" style="bottom:-10%;left:-8%;width:480px;height:480px;"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 mb-12 md:mb-24">
      <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-white leading-[0.96] md:leading-[0.94] tracking-[-0.025em] max-w-4xl">Millions of views generated organically through our strategies</h2>
      <p class="mt-5 md:mt-9 text-white/60 text-sm md:text-lg leading-relaxed max-w-2xl">Our expert marketing team builds strategic social media growth around creator branding, audience psychology and constant performance analysis &mdash; using real content metrics to identify what works, scale winning content and build strong personal brands that consistently generate organic traffic.</p>
    </div>

    <div class="relative z-10 flex flex-col gap-5 md:gap-6">
      {[
        { ids: [1, 2, 3, 4, 5, 6], reverse: false, opacity: 1 },
        { ids: [7, 8, 9, 10, 11, 12], reverse: true, opacity: 0.92 },
        { ids: [13, 14, 15, 16, 17, 18], reverse: false, opacity: 1 },
      ].map(row => (
        <div class="reels-marquee" style={`opacity:${row.opacity};`}>
          <div class={row.reverse ? 'reels-track reverse' : 'reels-track'}>
            {[...row.ids, ...row.ids, ...row.ids].map(n => (
              <div class="reel-card">
                <img src={`/assets/reels/${n}.jpg`} alt={`Instagram reel ${n}`} loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 2b. PAIN / PROBLEM (unified deep black + magenta/burgundy atmosphere) -->
  <section class="relative py-24 md:py-56 overflow-hidden grain">
    <div class="atmosphere-glow crimson" style="top:18%;right:-12%;width:520px;height:520px;opacity:0.35;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-4xl md:text-7xl lg:text-7xl xl:text-8xl text-white leading-[0.95] md:leading-[0.92] tracking-[-0.025em]">Why Most Creators Struggle To Scale</h2>
          <p class="mt-8 md:mt-10 text-white/65 text-base md:text-lg leading-relaxed max-w-sm">The creators scaling fastest today are backed by professional teams.</p>
        </div>

        <div class="lg:col-span-7 flex flex-col">
          {[
            { title: 'Bad chatting kills page growth.', text: 'Aggressive selling, weak conversations and poor execution slowly damage retention, fan trust and long-term spending. Strong monetization requires structure, training and consistency behind every interaction.' },
            { title: 'Having followers doesn’t always mean making real money.', text: 'Many creators already have views and followers — the real difference comes from monetization behind the page. Long-term growth depends on retention, fan spending and strong execution inside the DMs.' },
            { title: 'Many creators feel like just another account inside their agency.', text: 'Generic strategies, shared teams and poor communication eventually limit long-term growth. Serious scaling requires personalized strategy and dedicated support behind the page.' },
            { title: 'Without real systems and quality control, growth becomes inconsistent.', text: 'Strong months become unpredictable, revenue fluctuates and scaling becomes difficult to sustain long-term. Consistency comes from structure, execution and operational support.' },
            { title: 'Most creators can’t scale alone forever.', text: 'At some point, content, messaging, posting and monetization become too much for one person to manage properly. Real growth requires the right team behind the page.' },
          ].map((row, idx) => (
            <div class={`py-10 md:py-20 ${idx === 0 ? '' : 'border-t'}`} style="border-color:rgba(255,255,255,0.08);">
              <h3 class="font-display text-2xl md:text-4xl lg:text-5xl text-white leading-[1.0] md:leading-[0.98] tracking-[-0.015em] mb-4 md:mb-6">{row.title}</h3>
              <p class="text-white/65 text-[15px] md:text-base leading-relaxed max-w-lg">{row.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2c. OUR RESULTS — tightened editorial layout, one connected block -->
  <section class="relative py-20 md:py-36 section-cinematic grain overflow-hidden">
    <div class="atmosphere-glow magenta" style="top:14%;right:-14%;width:480px;height:480px;opacity:0.35;"></div>
    <div class="atmosphere-glow crimson" style="bottom:10%;left:-14%;width:420px;height:420px;opacity:0.35;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <!-- Header -->
      <div class="mb-10 md:mb-16 max-w-4xl">
        <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-on-surface leading-[0.96] md:leading-[0.94] tracking-[-0.025em]">Our Results</h2>
        <div class="mt-4 md:mt-6 flex flex-col gap-3 md:gap-3.5 max-w-xl">
          <p class="text-on-surface/72 text-sm md:text-lg leading-relaxed">At Mango, growth means more than views.</p>
          <p class="text-on-surface/65 text-sm md:text-lg leading-relaxed">We combine creator branding, social media positioning and monetization systems designed to turn attention into long-term revenue.</p>
          <p class="text-on-surface/65 text-sm md:text-lg leading-relaxed">Every strategy is built around the creator &mdash; their image, audience, positioning and conversion potential.</p>
          <p class="text-on-surface/65 text-sm md:text-lg leading-relaxed">From viral reach to fan retention, everything is structured to build scalable and profitable creator businesses.</p>
        </div>
      </div>

      <!-- Case 1 — MONETIZATION (text left / screenshot right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-20 items-center mb-12 md:mb-20">
        <div class="lg:col-span-5 flex flex-col gap-4 md:gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Monetization</span>
          <p class="font-display text-2xl md:text-4xl lg:text-5xl text-on-surface leading-[1.05] md:leading-[1.0] tracking-[-0.015em]">$24,586/month generated in 30 days</p>
          <p class="text-on-surface/65 text-sm md:text-base leading-relaxed max-w-sm">Through our chatting strategies designed to increase fan spending, improve retention and turn existing traffic into significantly higher long-term revenue.</p>
          <a href="/results" class="self-start inline-block bg-accent text-black font-bold px-7 py-3.5 md:py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all mt-2">
            See full results
          </a>
        </div>
        <div class="lg:col-span-7">
          <img src="/assets/results/monetization.jpeg" alt="Monthly revenue screenshot — $24,586 in 30 days" class="w-full h-auto block rounded-sm" style="box-shadow: 0 30px 80px -25px rgba(186,154,110,0.16), 0 30px 60px -25px rgba(0,0,0,0.7); border:1px solid rgba(255,255,255,0.08);" loading="lazy" />
        </div>
      </div>

      <!-- Case 2 — SOCIAL MEDIA GROWTH (mobile: text above image; desktop: image left / text right, image at ~68%) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8 lg:gap-20 items-center">
        <div class="lg:col-span-5 lg:order-2 flex flex-col gap-4 md:gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Social Media Growth</span>
          <p class="font-display text-2xl md:text-4xl lg:text-5xl text-on-surface leading-[1.05] md:leading-[1.0] tracking-[-0.015em]">53k+ new followers generated in 30 days</p>
          <p class="text-on-surface/65 text-sm md:text-base leading-relaxed max-w-sm">Through our social media growth strategies focused on creator positioning, content optimization and constant performance analysis &mdash; using real metrics to identify what works, scale winning content and maximize organic reach.</p>
        </div>
        <div class="lg:col-span-7 lg:order-1">
          <img src="/assets/results/growth.jpeg" alt="Instagram analytics — 53k+ new followers in 30 days" class="max-w-[80%] mx-auto lg:max-w-[68%] lg:ml-auto lg:mr-0 w-full h-auto block rounded-sm" style="box-shadow: 0 30px 80px -25px rgba(186,154,110,0.16), 0 30px 60px -25px rgba(0,0,0,0.7); border:1px solid rgba(255,255,255,0.08);" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. HOW WE SCALE CREATORS (panel, sticky multi-line title + 6 system blocks) -->
  <section class="relative py-24 md:py-56 section-panel grain overflow-hidden">
    <div class="atmosphere-glow magenta" style="top:-8%;left:30%;width:560px;height:560px;opacity:0.35;"></div>
    <div class="atmosphere-glow crimson" style="bottom:10%;right:-10%;width:480px;height:480px;opacity:0.4;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <!-- Sticky headline column -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-5xl md:text-7xl lg:text-7xl xl:text-8xl text-white leading-[0.94] md:leading-[0.9] tracking-[-0.025em]">
            How<br />We<br />Scale<br />Creators
          </h2>
          <p class="mt-6 md:mt-10 font-display text-xl md:text-3xl lg:text-4xl text-white/65 leading-[1.1] tracking-[-0.015em]">
            More revenue.<br />Less chaos.
          </p>
        </div>

        <!-- Systems stacked right -->
        <div class="lg:col-span-7 flex flex-col gap-14 md:gap-24">
          {[
            {
              id: 'chatting-monetization',
              title: 'Chatting & Monetization',
              paragraphs: [
                'Our in-house chatting team focuses on fan relationships, retention and higher spending — adapting every conversation to the creator’s personality, audience and boundaries.',
                'The goal is simple: turn existing traffic into stable long-term revenue instead of short-term spikes.',
                'Many creators working with us significantly increase their revenue within the first months through stronger monetization systems, retention and better execution behind the page.',
              ],
            },
            {
              id: 'social-media-growth',
              title: 'Social Media Growth',
              paragraphs: [
                'Our expert marketing team builds strategic social media growth around creator branding, audience psychology and constant performance analysis.',
                'We use real metrics to identify what works, scale winning content and consistently bring new fans into the creator ecosystem through diversified traffic strategies and creator collaborations.',
              ],
            },
            {
              id: 'content-strategy',
              title: 'Content Strategy',
              paragraphs: [
                'We help creators know exactly what to film, why it matters and how it connects to growth.',
                'Every content plan is built around virality, positioning, conversion and performance data — giving creators clear direction instead of random posting.',
              ],
            },
            {
              id: 'personalized-management',
              title: 'Personalized Management',
              paragraphs: [
                'No generic strategies or one-size-fits-all systems.',
                'Every creator receives personalized direction, communication and support built around their image, audience, goals and long-term potential.',
              ],
            },
            {
              id: 'operations-scaling',
              title: 'Operations & Scaling',
              paragraphs: [
                'Structured workflows, internal teams, performance tracking and quality control designed to help creators scale without chaos, inconsistency or burnout.',
                'Our goal is to maximize revenue while removing the stress of planning, managing and operating the page — allowing creators to focus more on content and creativity.',
              ],
            },
            {
              id: 'protection-support',
              title: 'Protection & Support',
              paragraphs: [
                'Leak protection, DMCA support, account safety and ongoing support designed to help creators scale confidently without losing control of their content or business.',
                'Our team supports creators through every stage of growth, so they can focus on creating while we manage the systems behind the page.',
              ],
            },
          ].map(s => (
            <div id={s.id} class="flex flex-col gap-5 md:gap-6 scroll-mt-24">
              <h3 class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[1.05] md:leading-[1.0] tracking-[-0.02em]">{s.title}</h3>
              <div class="flex flex-col gap-3 md:gap-4 max-w-lg">
                {s.paragraphs.map(p => (
                  <p class="text-white/65 text-base md:text-lg leading-relaxed">{p}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. HOW IT WORKS (dark panel, oversized step numbers) -->
  <section class="relative py-24 md:py-56 section-panel grain overflow-hidden">
    <div class="atmosphere-glow magenta" style="top:20%;right:-12%;width:480px;height:480px;opacity:0.35;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-16 md:mb-40 max-w-4xl">
        <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-on-surface leading-[0.96] md:leading-[0.94] tracking-[-0.025em]">How it works</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-12 lg:gap-16">
        {[
          { num: '01', title: 'Apply', text: 'Short application to understand your profile, content and current stage.' },
          { num: '02', title: 'Audit', text: 'We review your page, positioning, traffic and monetization structure.' },
          { num: '03', title: 'System Setup', text: 'Growth, chatting and monetization systems are built around your page.' },
          { num: '04', title: 'Scale & Optimize', text: 'Continuous optimization focused on long-term growth, retention and revenue.' },
        ].map(step => (
          <div class="flex flex-col gap-6">
            <span class="font-display text-5xl md:text-7xl lg:text-8xl text-white/18 leading-[0.85] tracking-[-0.02em]">{step.num}</span>
            <h3 class="font-display text-2xl md:text-3xl text-on-surface leading-[1.05] tracking-[-0.015em]">{step.title}</h3>
            <p class="text-on-surface/65 text-base leading-relaxed max-w-xs">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

