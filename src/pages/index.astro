---
import Layout from '../layouts/Layout.astro';
import ApplyForm from '../components/ApplyForm.astro';
import { useTranslations } from '../i18n/translations';

const t = useTranslations('en');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": t('home.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a1') }},
    { "@type": "Question", "name": t('home.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a2') }},
    { "@type": "Question", "name": t('home.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a3') }},
    { "@type": "Question", "name": t('home.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a4') }},
    { "@type": "Question", "name": t('home.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a5') }},
    { "@type": "Question", "name": t('home.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a6') }},
    { "@type": "Question", "name": t('home.faq.q7'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a7') }},
    { "@type": "Question", "name": t('home.faq.q8'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a8') }},
    { "@type": "Question", "name": t('home.faq.q9'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a9') }},
    { "@type": "Question", "name": t('home.faq.q10'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a10') }},
    { "@type": "Question", "name": t('home.faq.q11'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a11') }},
    { "@type": "Question", "name": t('home.faq.q12'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a12') }},
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "OnlyFans Management",
  "provider": { "@type": "Organization", "name": "MANGO Agency" },
  "description": "System-driven talent management for content creators. Chatting operations, marketing strategy, traffic generation, and operational optimization.",
  "serviceType": "Talent Management Agency",
  "areaServed": ["Europe", "Asia"],
};
---

<Layout title="MANGO | OnlyFans Management Agency for Creators" description="Modern OnlyFans management agency. Full-service growth, monetization and creator branding built to scale OnlyFans creators long-term." activeNav="home" lang="en" transparentTop={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- 1. HERO (minimal black editorial, asymmetric, oversized) -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden" style="background-color:#111111;">
    <div class="absolute inset-0 flex items-center">
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full">
        <div class="flex flex-col items-start gap-10 md:gap-14 max-w-[20ch]">
          <h1 class="font-display text-[40px] sm:text-6xl md:text-7xl lg:text-8xl xl:text-[120px] text-white leading-[0.92] tracking-[-0.025em] text-left">
            OnlyFans Management<br />for creators who want more.
          </h1>
          <p class="text-white/65 text-[15px] md:text-base lg:text-lg leading-relaxed font-body max-w-md text-left">
            Growth, monetization and management built to scale creators long-term.
          </p>
          <p class="text-[10px] uppercase tracking-[0.3em] text-white/35 font-medium mt-1 md:mt-2">For creators, by creators.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 1b. AUTHORITY STRIP (thin editorial, off-white) -->
  <section class="py-32 md:py-44" style="background-color:#f7f3ee;">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-y-6 md:gap-x-8 lg:gap-x-12 text-center md:text-left">
        {[
          'Focused on long-term growth.',
          'Millions of views generated.',
          'Behind high-performing creators.',
          'Built on systems, not guesswork.',
        ].map(line => (
          <p class="text-[13px] md:text-sm text-on-surface/70 font-medium leading-relaxed tracking-tight">{line}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- 2b. PAIN / PROBLEM (warm beige, sticky-header magazine) -->
  <section class="py-36 md:py-56" style="background-color:#D8C8B8;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
        <!-- Sticky headline column -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-5xl md:text-7xl lg:text-7xl xl:text-8xl text-on-surface leading-[0.92] tracking-[-0.025em]">OnlyFans growth is now a systems game.</h2>
          <p class="mt-8 md:mt-10 text-on-surface/65 text-base md:text-lg leading-relaxed max-w-sm">The creators scaling fastest today are backed by professional teams.</p>
        </div>

        <!-- Pain points column -->
        <div class="lg:col-span-7 flex flex-col">
          {[
            { title: 'Bad chatting kills page growth.', text: 'Aggressive selling, weak conversations and poor execution slowly damage retention, fan trust and long-term spending. Strong monetization requires structure, training and consistency behind every interaction.' },
            { title: 'Having followers doesn’t always mean making real money.', text: 'Many creators already have views and followers — the real difference comes from monetization behind the page. Long-term growth depends on retention, fan spending and strong execution inside the DMs.' },
            { title: 'Many creators feel like just another account inside their agency.', text: 'Generic strategies, shared teams and poor communication eventually limit long-term growth. Serious scaling requires personalized strategy and dedicated support behind the page.' },
            { title: 'Without real systems and quality control, growth becomes inconsistent.', text: 'Strong months become unpredictable, revenue fluctuates and scaling becomes difficult to sustain long-term. Consistency comes from structure, execution and operational support.' },
            { title: 'Most creators can’t scale alone forever.', text: 'At some point, content, messaging, posting and monetization become too much for one person to manage properly. Real growth requires the right team behind the page.' },
          ].map((row, idx) => (
            <div class={`py-14 md:py-20 ${idx === 0 ? '' : 'border-t'}`} style="border-color:rgba(17,17,17,0.22);">
              <h3 class="font-display text-3xl md:text-4xl lg:text-5xl text-on-surface leading-[0.98] tracking-[-0.015em] mb-5 md:mb-6">{row.title}</h3>
              <p class="text-on-surface/65 text-[15px] md:text-base leading-relaxed max-w-lg">{row.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2c. RESULTS PREVIEW (off-white, alternating case-study spreads) -->
  <section class="py-36 md:py-56 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <!-- Header -->
      <div class="mb-28 md:mb-40 max-w-4xl">
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-on-surface leading-[0.94] tracking-[-0.025em]">Results built on systems.</h2>
        <p class="mt-7 md:mt-9 text-on-surface/65 text-base md:text-lg leading-relaxed max-w-md">Growth is only valuable when monetization scales behind it.</p>
      </div>

      <!-- Case 1: text left / screenshot right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center mb-32 md:mb-44">
        <div class="lg:col-span-5 flex flex-col gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Growth</span>
          <p class="font-display text-3xl md:text-4xl lg:text-5xl text-on-surface leading-[1.0] tracking-[-0.015em]">53k+ followers generated in 30 days.</p>
        </div>
        <div class="lg:col-span-7">
          <img src="/assets/results/growth.jpeg" alt="Instagram analytics — 53k+ followers in 30 days" class="w-full h-auto block" style="box-shadow: 0 24px 60px -24px rgba(17,17,17,0.15);" loading="lazy" />
        </div>
      </div>

      <!-- Case 2: screenshot left / text right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center mb-32 md:mb-40">
        <div class="lg:col-span-7 lg:order-1">
          <img src="/assets/results/monetization.jpeg" alt="Monthly revenue screenshot — $24,586" class="w-full h-auto block" style="box-shadow: 0 24px 60px -24px rgba(17,17,17,0.15);" loading="lazy" />
        </div>
        <div class="lg:col-span-5 lg:order-2 flex flex-col gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Monetization</span>
          <p class="font-display text-3xl md:text-4xl lg:text-5xl text-on-surface leading-[1.0] tracking-[-0.015em]">$24,586/month.</p>
        </div>
      </div>

      <!-- Editorial CTA link -->
      <div class="flex justify-start lg:justify-end">
        <a href="/results" class="group inline-flex items-baseline gap-4 text-on-surface font-display text-2xl md:text-3xl tracking-[-0.01em] hover:gap-6 transition-all duration-300">
          See full results
          <span class="text-on-surface/55 group-hover:text-on-surface transition-colors">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. SYSTEMS BEHIND THE REVENUE (BLACK, sticky header + staggered systems) -->
  <section class="py-36 md:py-56" style="background-color:#111111;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
        <!-- Sticky headline column -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-5xl md:text-7xl lg:text-7xl xl:text-8xl text-white leading-[0.92] tracking-[-0.025em]">The Systems Behind the Revenue.</h2>
        </div>

        <!-- Systems stacked right -->
        <div class="lg:col-span-7 flex flex-col gap-24 md:gap-32">
          {[
            { num: '01', title: 'Chatting & Monetization', text: 'Our in-house chatting team focuses on retention, fan relationships and long-term spending — building stronger monetization behind the page, not just short-term sales.' },
            { num: '02', title: 'Growth Systems', text: 'Multi-platform growth systems combining Instagram, viral content strategy and external traffic sources designed to consistently bring new fans into the ecosystem.' },
            { num: '03', title: 'Protection & Infrastructure', text: 'Leak protection, DMCA support and account safety designed to help creators scale confidently without losing control of their content.' },
          ].map(s => (
            <div class="flex flex-col gap-6">
              <span class="text-[11px] uppercase tracking-[0.3em] text-white/40 font-medium">{s.num}</span>
              <h3 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[1.0] tracking-[-0.02em]">{s.title}</h3>
              <p class="text-white/65 text-base md:text-lg leading-relaxed max-w-lg">{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. HOW IT WORKS (off-white, oversized step numbers) -->
  <section class="py-36 md:py-56" style="background-color:#f7f3ee;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-28 md:mb-40 max-w-4xl">
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-on-surface leading-[0.94] tracking-[-0.025em]">How it works.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16">
        {[
          { num: '01', title: 'Apply', text: 'Short application to understand your profile, content and current stage.' },
          { num: '02', title: 'Audit', text: 'We review your page, positioning, traffic and monetization structure.' },
          { num: '03', title: 'System Setup', text: 'Growth, chatting and monetization systems are built around your page.' },
          { num: '04', title: 'Scale & Optimize', text: 'Continuous optimization focused on long-term growth, retention and revenue.' },
        ].map(step => (
          <div class="flex flex-col gap-6">
            <span class="font-display text-6xl md:text-7xl lg:text-8xl text-on-surface/22 leading-[0.85] tracking-[-0.02em]">{step.num}</span>
            <h3 class="font-display text-2xl md:text-3xl text-on-surface leading-[1.05] tracking-[-0.015em]">{step.title}</h3>
            <p class="text-on-surface/65 text-base leading-relaxed max-w-xs">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. APPLY -->
  <ApplyForm lang="en" />

  <!-- 7. FAQ (white) -->
  <section class="py-32 md:py-40 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="mb-20 md:mb-28">
        <h2 class="font-display text-5xl md:text-7xl text-on-surface leading-[0.96] tracking-[-0.025em]">Frequently asked.</h2>
      </div>
      <div class="flex flex-col">
        {[
          {
            q: "What makes you different from other agencies?",
            a: `<p>Most agencies rely on volume — more content, more posts, more messages.</p><p>We focus on performance.</p><p>We combine:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>A marketing team focused on generating consistent traffic</li><li>A dedicated in-house chatting team per model (not shared across accounts)</li><li>Structured sales systems (dripping, upsells, retention)</li><li>Weekly optimization based on real performance data (revenue, conversion, LTV)</li></ul><p>We don't work with everyone. We select the right creators and focus on scaling them properly.</p>`,
          },
          {
            q: "Why should I work with an agency?",
            a: `<p>Because most creators are leaving money on the table — on both sides.</p><p>Traffic without monetization doesn't scale.<br />Monetization without traffic doesn't grow.</p><p>We handle both.</p><p>Marketing brings consistent traffic.<br />Chatting turns that traffic into revenue.</p><p>So you can focus on content while everything behind the scenes is optimized.</p>`,
          },
          {
            q: "How much can I expect to grow?",
            a: `<p>It depends on your starting point.</p><p>Most creators we work with see:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>Higher revenue per subscriber</li><li>Better conversion from fans to buyers</li><li>More consistent daily income</li></ul><p>In many cases, creators move from unstable income to predictable monthly revenue by improving both traffic and monetization.</p>`,
          },
          {
            q: "Is it safe to give access to my account?",
            a: `<p>Yes.</p><p>We only require your credentials once to securely connect your account to our CRM.</p><p>After that, our team works through the platform without needing direct access to your login details.</p><p>Your account stays protected, and you keep full control at all times.</p>`,
          },
          {
            q: "Will you change my personality or how I interact with fans?",
            a: `<p>No.</p><p>We adapt to your personality — not the other way around.</p><p>Before starting, we collect detailed information about your tone, preferences, and boundaries to replicate your style as accurately as possible.</p>`,
          },
          {
            q: "Do you help with content creation?",
            a: `<p>Yes.</p><p>We provide clear content strategies, references, and direction based on what performs best.</p><p>You don't have to guess what to post — we guide you on what actually converts.</p>`,
          },
          {
            q: "How does the process work?",
            a: `<p>Apply &rarr; Evaluation call &rarr; System setup &rarr; Launch &amp; optimization</p><p>Once everything is aligned, we can start quickly and begin improving your revenue from day one.</p>`,
          },
          {
            q: "Do I keep control of my account?",
            a: `<p>Always.</p><p>You keep full ownership, visibility, and control at all times.</p>`,
          },
          {
            q: "How is chatting quality maintained?",
            a: `<p>We use a system-based approach:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>24/7 monitoring</li><li>Dedicated QA team</li><li>Performance tracking per chatter</li><li>Continuous optimization</li></ul><p>Everything is measured and improved constantly.</p>`,
          },
          {
            q: "Can I stop anytime?",
            a: `<p>Yes.</p><p>We don't lock creators into long-term contracts.</p><p>We only work together if it makes sense for both sides.</p>`,
          },
          {
            q: "How do payments work?",
            a: `<p>We work on a performance-based model.</p><p>That means we only make money if you make more money.</p><p>Details are discussed during the evaluation call to fit your specific situation.</p>`,
          },
          {
            q: "Who is this NOT for?",
            a: `<p>Creators who are not consistent, don't take this seriously, or are just starting.</p><p>We don't take everyone.</p><p>We work with creators who already have traction and want to scale their revenue properly.<br />We focus on building systems — not chasing short-term spikes.</p>`,
          },
        ].map((faq, idx) => (
          <details class={`group ${idx === 0 ? 'border-y' : 'border-b'} hover:bg-on-surface/[0.02] transition-colors`} style="border-color:rgba(17,17,17,0.12);">
            <summary class="py-7 flex items-center justify-between cursor-pointer list-none select-none">
              <span class="font-display text-lg md:text-xl text-on-surface pr-6">{faq.q}</span>
              <span class="material-symbols-outlined expand-icon flex-shrink-0 transition-transform duration-300" style="color:#707B66;">add</span>
            </summary>
            <div class="pb-8 text-on-surface-variant text-sm md:text-base leading-relaxed flex flex-col gap-3 max-w-2xl" set:html={faq.a}></div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
