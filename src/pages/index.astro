---
import Layout from '../layouts/Layout.astro';
import ApplyForm from '../components/ApplyForm.astro';
import { useTranslations } from '../i18n/translations';

const t = useTranslations('en');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": t('home.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a1') }},
    { "@type": "Question", "name": t('home.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a2') }},
    { "@type": "Question", "name": t('home.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a3') }},
    { "@type": "Question", "name": t('home.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a4') }},
    { "@type": "Question", "name": t('home.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a5') }},
    { "@type": "Question", "name": t('home.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a6') }},
    { "@type": "Question", "name": t('home.faq.q7'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a7') }},
    { "@type": "Question", "name": t('home.faq.q8'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a8') }},
    { "@type": "Question", "name": t('home.faq.q9'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a9') }},
    { "@type": "Question", "name": t('home.faq.q10'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a10') }},
    { "@type": "Question", "name": t('home.faq.q11'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a11') }},
    { "@type": "Question", "name": t('home.faq.q12'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a12') }},
  ]
};

// HowTo — describes the 4-step onboarding flow ("How To Start With Us") so
// AI engines can surface it as a procedural answer to "how to start with
// MANGO" / "how does MANGO onboard creators" queries.
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to start working with MANGO Agency",
  "description": "The four-step onboarding flow MANGO uses to evaluate, set up and scale OnlyFans creators.",
  "totalTime": "PT14D",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Apply",
      "text": "Short application to understand the creator's profile, content and current stage.",
      "url": "https://www.mangova.agency/#apply",
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Audit",
      "text": "MANGO reviews the page, positioning, traffic sources and current monetization structure.",
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "System Setup",
      "text": "Growth, chatting and monetization systems are built around the creator's specific page and audience.",
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Scale & Optimize",
      "text": "Continuous weekly optimization focused on long-term growth, fan retention and revenue.",
    },
  ],
};

// WebPage with speakable — tells voice assistants / AI summaries which parts
// of the page are safe to read aloud (hero, FAQ summaries and answers).
// Description carries the canonical 60-word brand definition so AI engines
// ingest it without needing visible UI copy.
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": "https://www.mangova.agency/",
  "name": "MANGO | OnlyFans Management Agency for Creators",
  "description": "MANGO is an OnlyFans management agency that scales content creators by combining a dedicated in-house chatting team, structured monetization systems and Instagram-led social media growth. Operating on a performance-based model, MANGO works with creators in Europe and Asia in both English and Spanish — focused on retention, fan LTV and predictable monthly revenue rather than short-term spikes.",
  "inLanguage": "en",
  "isPartOf": { "@type": "WebSite", "name": "MANGO", "url": "https://www.mangova.agency" },
  "about": { "@type": "Organization", "name": "MANGO", "url": "https://www.mangova.agency" },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "details summary span", "details > div"],
  },
};

const provider = { "@type": "Organization", "name": "MANGO Agency", "url": "https://www.mangova.agency" };
const areaServed = [
  { "@type": "Place", "name": "Europe" },
  { "@type": "Place", "name": "Asia" },
];

const serviceSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "OnlyFans Chatting & Monetization",
    "provider": provider,
    "areaServed": areaServed,
    "serviceType": "OnlyFans Chatting Service",
    "description": "24/7 in-house chatting team focused on fan retention, higher spending and long-term LTV. Each conversation adapts to the creator's personality, audience and boundaries.",
    "url": "https://www.mangova.agency/#chatting-monetization",
    "audience": { "@type": "Audience", "audienceType": "OnlyFans creators" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "OnlyFans Social Media Growth",
    "provider": provider,
    "areaServed": areaServed,
    "serviceType": "Creator Marketing & Growth",
    "description": "Strategic Instagram-led growth built around creator branding, audience psychology and constant performance analysis. Real metrics drive what gets scaled.",
    "url": "https://www.mangova.agency/#social-media-growth",
    "audience": { "@type": "Audience", "audienceType": "OnlyFans creators" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "OnlyFans Content Strategy",
    "provider": provider,
    "areaServed": areaServed,
    "serviceType": "Content Direction & Strategy",
    "description": "Content direction built around virality, positioning, conversion and performance data — giving creators clear guidance on what to film and why.",
    "url": "https://www.mangova.agency/#content-strategy",
    "audience": { "@type": "Audience", "audienceType": "OnlyFans creators" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Personalized OnlyFans Management",
    "provider": provider,
    "areaServed": areaServed,
    "serviceType": "Talent Management",
    "description": "No generic playbooks. Each creator gets dedicated direction, communication and support tailored to their image, audience, goals and long-term potential.",
    "url": "https://www.mangova.agency/#personalized-management",
    "audience": { "@type": "Audience", "audienceType": "OnlyFans creators" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "OnlyFans Operations & Scaling",
    "provider": provider,
    "areaServed": areaServed,
    "serviceType": "Creator Operations",
    "description": "Structured workflows, internal teams, performance tracking and quality control designed to scale creators without chaos, inconsistency or burnout.",
    "url": "https://www.mangova.agency/#operations-scaling",
    "audience": { "@type": "Audience", "audienceType": "OnlyFans creators" },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "OnlyFans Protection & Support",
    "provider": provider,
    "areaServed": areaServed,
    "serviceType": "Creator Protection",
    "description": "Leak protection, DMCA support, account safety and ongoing operational support so creators can scale confidently without losing control of their content.",
    "url": "https://www.mangova.agency/#protection-support",
    "audience": { "@type": "Audience", "audienceType": "OnlyFans creators" },
  },
];
---

<Layout title="MANGO | OnlyFans Management Agency for Creators" description="Modern OnlyFans management agency. Full-service growth, monetization and creator branding built to scale OnlyFans creators long-term." activeNav="home" lang="en" transparentTop={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    {serviceSchemas.map(s => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </Fragment>

  <!-- 1. HERO — Luxury editorial photo collage. Desktop: 4 columns × 3 images with subtle column parallax. Mobile: 2 columns × 3 of the strongest images. Unified cinematic grading via CSS filters + tint. -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden" style="background-color:#070707;">

    <!-- DESKTOP: 4-column collage (12 images) -->
    <div class="absolute inset-0 hidden md:block">
      <div class="absolute inset-0 grid grid-cols-4 gap-5 lg:gap-6 px-5 lg:px-6">
        <div class="relative h-full"><div class="collage-column collage-column-1"><picture><source srcset="/assets/hero-collage/c1-t.webp" type="image/webp" /><img src="/assets/hero-collage/c1-t.jpg" alt="Editorial portrait of an OnlyFans creator — soft natural light" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c1-m.webp" type="image/webp" /><img src="/assets/hero-collage/c1-m.jpg" alt="Lifestyle photo of a content creator — neutral palette" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c1-b.webp" type="image/webp" /><img src="/assets/hero-collage/c1-b.jpg" alt="Premium studio portrait — moody atmosphere" class="collage-img" loading="eager" decoding="async" /></picture></div></div>
        <div class="relative h-full"><div class="collage-column collage-column-2"><picture><source srcset="/assets/hero-collage/c2-t.webp" type="image/webp" /><img src="/assets/hero-collage/c2-t.jpg" alt="Creator portrait — golden hour lighting" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c2-m.webp" type="image/webp" /><img src="/assets/hero-collage/c2-m.jpg" alt="Editorial frame of an OnlyFans model — soft contrast" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c2-b.webp" type="image/webp" /><img src="/assets/hero-collage/c2-b.jpg" alt="Full-body studio composition — warm tones" class="collage-img" loading="eager" decoding="async" /></picture></div></div>
        <div class="relative h-full"><div class="collage-column collage-column-3"><picture><source srcset="/assets/hero-collage/c3-t.webp" type="image/webp" /><img src="/assets/hero-collage/c3-t.jpg" alt="Editorial photo of a creator — intimate scene" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c3-m.webp" type="image/webp" /><img src="/assets/hero-collage/c3-m.jpg" alt="Outdoor lifestyle frame — natural backdrop" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c3-b.webp" type="image/webp" /><img src="/assets/hero-collage/c3-b.jpg" alt="Studio portrait of an OnlyFans creator — soft beige palette" class="collage-img" loading="eager" decoding="async" /></picture></div></div>
        <div class="relative h-full"><div class="collage-column collage-column-4"><picture><source srcset="/assets/hero-collage/c4-t.webp" type="image/webp" /><img src="/assets/hero-collage/c4-t.jpg" alt="Close-up portrait — dramatic studio lighting" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c4-m.webp" type="image/webp" /><img src="/assets/hero-collage/c4-m.jpg" alt="Lifestyle photo — candid creator moment" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c4-b.webp" type="image/webp" /><img src="/assets/hero-collage/c4-b.jpg" alt="Editorial portrait — high-key studio lighting" class="collage-img" loading="eager" decoding="async" /></picture></div></div>
      </div>
    </div>

    <!-- MOBILE: 2-column collage with the 6 strongest images (11, 14, 12 | 19, 10, 16) -->
    <div class="absolute inset-0 md:hidden">
      <div class="absolute inset-0 grid grid-cols-2 gap-3 px-3">
        <div class="relative h-full"><div class="collage-column collage-column-1"><picture><source srcset="/assets/hero-collage/c2-t.webp" type="image/webp" /><img src="/assets/hero-collage/c2-t.jpg" alt="Creator portrait — golden hour lighting" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c1-m.webp" type="image/webp" /><img src="/assets/hero-collage/c1-m.jpg" alt="Lifestyle photo of a content creator — neutral palette" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c1-b.webp" type="image/webp" /><img src="/assets/hero-collage/c1-b.jpg" alt="Premium studio portrait — moody atmosphere" class="collage-img" loading="eager" decoding="async" /></picture></div></div>
        <div class="relative h-full"><div class="collage-column collage-column-2"><picture><source srcset="/assets/hero-collage/c2-m.webp" type="image/webp" /><img src="/assets/hero-collage/c2-m.jpg" alt="Editorial frame of an OnlyFans model — soft contrast" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c3-t.webp" type="image/webp" /><img src="/assets/hero-collage/c3-t.jpg" alt="Editorial photo of a creator — intimate scene" class="collage-img" loading="eager" decoding="async" /></picture><picture><source srcset="/assets/hero-collage/c4-m.webp" type="image/webp" /><img src="/assets/hero-collage/c4-m.jpg" alt="Lifestyle photo — candid creator moment" class="collage-img" loading="eager" decoding="async" /></picture></div></div>
      </div>
    </div>

    <!-- Unifying cinematic tint (multiply blend → warm/burgundy across all photos) -->
    <div class="collage-tint" style="z-index:2;"></div>

    <!-- Centered radial darkening — focuses light in the middle where the text lives, collage stays visible at the edges -->
    <div class="absolute inset-0 pointer-events-none" style="z-index:3; background: radial-gradient(ellipse 72% 62% at 50% 50%, rgba(0,0,0,0.68) 0%, rgba(0,0,0,0.45) 28%, rgba(0,0,0,0.22) 52%, rgba(0,0,0,0.08) 75%, transparent 92%);"></div>
    <!-- Subtle top + bottom vignette so the collage edges feel cinematic -->
    <div class="absolute inset-0 pointer-events-none" style="z-index:3; background: linear-gradient(to bottom, rgba(0,0,0,0.32) 0%, transparent 18%, transparent 80%, rgba(0,0,0,0.50) 100%);"></div>

    <!-- Film grain over everything -->
    <div class="grain absolute inset-0 pointer-events-none" style="opacity:0.5; z-index:4;"></div>

    <!-- CONTENT — centered horizontally and vertically, premium fashion-campaign layout -->
    <div class="relative h-full max-w-7xl mx-auto px-6 lg:px-10 flex items-center justify-center" style="z-index:10;">
      <div class="relative w-full max-w-md sm:max-w-xl md:max-w-2xl lg:max-w-3xl xl:max-w-4xl">
        <!-- Localized blurred dark halo concentrated directly behind the text block for an extra contrast lift -->
        <div class="absolute -inset-x-6 -inset-y-10 md:-inset-x-12 md:-inset-y-16 pointer-events-none rounded-[2rem]" style="background: radial-gradient(ellipse 100% 88% at 50% 50%, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.25) 50%, transparent 88%); filter: blur(14px);"></div>

        <div class="relative flex flex-col items-center text-center gap-9 md:gap-16">
          <h1 class="font-display text-[28px] sm:text-6xl md:text-6xl lg:text-7xl xl:text-[88px] text-white leading-[1.0] md:leading-[0.96] tracking-[-0.025em]" style="text-wrap:nowrap;">
            <span class="block">Premium</span>
            <span class="block whitespace-nowrap">OnlyFans Management</span>
          </h1>
          <p class="text-white/85 text-[13px] md:text-base lg:text-lg leading-[1.55] md:leading-relaxed font-body max-w-xs sm:max-w-md md:max-w-xl">
            We scale OnlyFans creators through strategic growth, stronger monetization and personalized support built for long-term success.
          </p>
          <a href="#apply" class="inline-block bg-accent text-black font-bold px-8 py-3.5 md:px-9 md:py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">
            Apply to work with us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 1b. EDITORIAL METRICS — 4 horizontal cards (unified magenta/burgundy atmosphere) -->
  <section class="relative py-20 md:py-52 overflow-hidden">
    <div class="grain absolute inset-0 pointer-events-none"></div>
    <div class="atmosphere-glow magenta" style="top:-10%;right:-6%;width:520px;height:520px;opacity:0.5;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {[
          { metric: '24/7', size: 'text-7xl md:text-7xl lg:text-[5.5rem]', title: 'Monetization', text: 'Native English & Spanish chatting focused on retention and long-term LTV.', glow: 'warm' },
          { metric: '5–6 Figures', size: 'text-5xl md:text-5xl lg:text-[3.5rem]', title: 'Monthly Scaling', text: 'Structured growth designed to scale creators from $1k to multi 6-figures.', glow: null },
          { metric: '+5 Billion', size: 'text-5xl md:text-6xl lg:text-[4rem]', title: 'Views Generated', text: 'Instagram growth built around virality, positioning and creator branding.', glow: 'crimson' },
          { metric: '+30% LTV', size: 'text-5xl md:text-5xl lg:text-[3.25rem]', title: 'Higher Fan Value', text: 'Chatting designed to increase fan spending and long-term monetization.', glow: null },
        ].map(c => (
          <div
            class="relative rounded-2xl px-7 py-10 md:px-10 md:py-16 lg:px-11 lg:py-20 flex flex-col justify-between min-h-[240px] md:min-h-[420px] transition-all duration-300 hover:bg-white/[0.028] overflow-hidden"
            style="background-color:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);"
          >
            {c.glow === 'warm' && (
              <div class="absolute pointer-events-none" style="top:-20%;right:-25%;width:80%;height:75%;border-radius:9999px;background:radial-gradient(circle, rgba(214,183,122,0.16), transparent 70%);filter:blur(36px);"></div>
            )}
            {c.glow === 'crimson' && (
              <div class="absolute pointer-events-none" style="bottom:-25%;left:-25%;width:85%;height:80%;border-radius:9999px;background:radial-gradient(circle, rgba(184,42,72,0.18), transparent 70%);filter:blur(40px);"></div>
            )}

            <div class="relative z-10">
              <p class={`font-display ${c.size} text-white leading-[0.92] tracking-[-0.025em]`} style="text-wrap:balance;">{c.metric}</p>
            </div>

            <div class="relative z-10 flex flex-col gap-4 mt-10 md:mt-16">
              <p class="text-[13px] uppercase tracking-[0.21em] font-semibold" style="color:#c8a96a;">{c.title}</p>
              <p class="text-[13px] md:text-sm text-white/65 leading-[1.6] max-w-[26ch] font-normal">{c.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2a. REELS ECOSYSTEM (virality / attention / creator culture) -->
  <section class="relative py-20 md:py-52 overflow-hidden">
    <div class="grain absolute inset-0 pointer-events-none"></div>
    <div class="atmosphere-glow magenta" style="top:8%;right:-8%;width:560px;height:560px;"></div>
    <div class="atmosphere-glow crimson" style="bottom:-10%;left:-8%;width:480px;height:480px;"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 mb-16 md:mb-24">
      <div class="text-center mx-auto max-w-full md:max-w-5xl">
        <h2 class="font-display text-[24px] sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-white leading-[1.05] md:leading-[0.96] tracking-[-0.025em] whitespace-nowrap">Millions of views<br />generated organically<br />through our strategies</h2>
        <p class="mt-6 md:mt-9 text-white/60 text-sm md:text-lg leading-relaxed max-w-[85%] mx-auto md:max-w-2xl">Our expert marketing team builds strategic social media growth around creator branding, audience psychology and constant performance analysis &mdash; using real content metrics to identify what works, scale winning content and build strong personal brands that consistently generate organic traffic.</p>
      </div>
    </div>

    <div class="relative z-10 flex flex-col gap-5 md:gap-6">
      {[
        { ids: [1, 2, 3, 4, 5, 6], reverse: false, opacity: 1 },
        { ids: [7, 8, 9, 10, 11, 12], reverse: true, opacity: 0.92 },
        { ids: [13, 14, 15, 16, 17, 18], reverse: false, opacity: 1 },
      ].map(row => (
        <div class="reels-marquee" style={`opacity:${row.opacity};`}>
          <div class={row.reverse ? 'reels-track reverse' : 'reels-track'}>
            {[...row.ids, ...row.ids, ...row.ids].map(n => (
              <div class="reel-card">
                <picture>
                  <source srcset={`/assets/reels/${n}.webp`} type="image/webp" />
                  <img src={`/assets/reels/${n}.jpg`} alt={`Instagram reel ${n}`} loading="lazy" decoding="async" />
                </picture>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 2c. OUR RESULTS — tightened editorial layout, one connected block -->
  <section class="relative py-20 md:py-36 section-cinematic grain overflow-hidden">
    <div class="atmosphere-glow magenta" style="top:14%;right:-14%;width:480px;height:480px;opacity:0.35;"></div>
    <div class="atmosphere-glow crimson" style="bottom:10%;left:-14%;width:420px;height:420px;opacity:0.35;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <!-- Header — fully centered editorial intro -->
      <div class="mb-16 md:mb-24 max-w-4xl mx-auto text-center">
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-on-surface leading-[0.96] md:leading-[0.94] tracking-[-0.025em]">Our Results</h2>
        <div class="mt-10 md:mt-8 flex flex-col gap-3 md:gap-3.5 max-w-2xl mx-auto items-center">
          <p class="hidden md:block text-on-surface/72 text-sm md:text-lg leading-relaxed">At Mango, growth means more than views.</p>
          <p class="text-on-surface/65 text-[15px] md:text-lg leading-[1.65] md:leading-relaxed">We combine creator branding, social media positioning and monetization systems designed to turn attention into long-term revenue.</p>
          <p class="text-on-surface/65 text-[15px] md:text-lg leading-[1.65] md:leading-relaxed">Every strategy is built around the creator &mdash; their image, audience, positioning and conversion potential.</p>
          <p class="text-on-surface/65 text-[15px] md:text-lg leading-[1.65] md:leading-relaxed">From viral reach to fan retention, everything is structured to build scalable and profitable creator businesses.</p>
        </div>
      </div>

      <!-- Case 1 — MONETIZATION (text left / image right, top-aligned, locked to the same 5/7 grid) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-20 items-start mb-20 md:mb-28">
        <div class="lg:col-span-5 flex flex-col gap-4 md:gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Monetization</span>
          <p class="font-display text-2xl md:text-4xl lg:text-5xl text-on-surface leading-[1.05] md:leading-[1.0] tracking-[-0.015em]">$24,586/month generated in 30 days</p>
          <p class="text-on-surface/65 text-sm md:text-base leading-relaxed max-w-sm">Through our chatting strategies designed to increase fan spending, improve retention and turn existing traffic into significantly higher long-term revenue.</p>
          <a href="/results" class="self-start inline-block bg-accent text-black font-bold px-7 py-3.5 md:py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all mt-2">
            See full results
          </a>
        </div>
        <div class="lg:col-span-7">
          <picture>
