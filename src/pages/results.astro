---
import Layout from '../layouts/Layout.astro';

const cases = [
  {
    label: 'Case 01 — Male creator',
    subhead: 'OnlyFans monetization case study — male creator scaled to 5-figure months',
    headline: 'High traffic alone wasn’t translating into revenue.',
    paragraphs: [
      'This male creator was already generating strong visibility and consistent traffic, but monetization per subscriber remained underperforming.',
      'After restructuring chatting flows, retention systems and higher-value monetization strategies, spending per fan and overall LTV increased significantly — leading to consistent 5-figure months despite a smaller subscriber base.',
    ],
    image: '/assets/results/growth-monthly.jpeg',
    imageAlt: 'Monthly earnings scaling to five-figure months — +1,034% growth',
    layout: 'text-left',
    theme: 'cream',
  },
  {
    label: 'Case 02 — Lifestyle creator',
    subhead: 'Revenue stability case study — lifestyle creator on OnlyFans',
    headline: 'Revenue became more stable once the backend was structured properly.',
    paragraphs: [
      'This creator already had active fans and regular traffic, but revenue remained inconsistent month to month due to weak retention and monetization systems behind the page.',
      'After improving chatting structure, retention systems and overall fan experience, subscriber longevity and LTV increased significantly — making revenue far more stable and predictable over time.',
    ],
    image: '/assets/results/results-grid1.jpeg',
    imageAlt: 'Stabilized monthly revenue — lifestyle creator',
    layout: 'image-left',
    theme: 'dark',
  },
  {
    label: 'Case 03 — Tattoo creator',
    subhead: 'OnlyFans monetization optimization — tattoo creator',
    headline: 'Most of the revenue potential was being left on the table.',
    paragraphs: [
      'The page already had active subscribers and strong traffic, but monetization behind the account lacked structure and consistency.',
      'By improving upsell execution, chatting systems and retention flows, overall fan spending and customer LTV increased substantially — creating stronger monthly performance without relying purely on new traffic.',
    ],
    image: '/assets/results/statement-july.jpeg',
    imageAlt: 'Monthly OnlyFans statement — five-figure month, top 1.2% of creators',
    layout: 'text-left',
    theme: 'cream',
  },
  {
    label: 'Case 04 — Fitness creator',
    subhead: 'Daily revenue uplift case study — fitness creator on OnlyFans',
    headline: 'Better monetization created stronger daily revenue behind the same traffic.',
    paragraphs: [
      'Instead of depending purely on subscriber volume, the focus shifted toward fan retention, monetization structure and higher-value spending behavior.',
      'This created significantly stronger daily revenue performance, higher LTV and more profitable monetization behind the same audience.',
    ],
    image: '/assets/results/results-grid3-v2.jpeg',
    imageAlt: 'Daily revenue uplift — fitness creator',
    layout: 'image-left',
    theme: 'dark',
  },
];

const finalCase = {
  label: 'Case 05 — Lifestyle creator',
  subhead: 'Single-day OnlyFans earnings — what better backend systems produce',
  headline: 'Even a single day can look completely different with the right backend systems.',
  paragraphs: [
    'The difference wasn’t traffic volume — it was monetization execution behind the page.',
    'Through stronger chatting systems, retention structure and fan conversion flows, overall spending per fan and LTV increased significantly, leading to stronger daily revenue spikes and more profitable long-term performance.',
  ],
  image: '/assets/results/daily-performance-block1.jpeg',
  imageAlt: 'Single-day $2k+ revenue proof',
};
---

<Layout title="OnlyFans Case Studies & Revenue Results | MANGO Agency" description="Real revenue results from OnlyFans creators managed by MANGO — case studies, monthly earnings and growth metrics built on structured monetization systems." activeNav="results" lang="en" transparentTop={true}>

  <!-- 1. HERO (cinematic editorial atmosphere, oversized) -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden flex items-center hero-editorial-bg-alt grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full">
      <div class="flex flex-col items-start gap-7 md:gap-10 w-full max-w-4xl">
        <h1 class="font-display text-[44px] sm:text-7xl md:text-8xl lg:text-[140px] xl:text-[160px] text-white leading-[0.92] tracking-[-0.03em] text-left">Our Results</h1>
        <p class="text-white/65 text-[15px] md:text-base lg:text-lg leading-relaxed max-w-3xl">Creators working with us often double or triple their earnings within the first months through strategic social media growth, stronger monetization systems and personalized support.</p>
      </div>
    </div>
  </section>

  <!-- 2-5. CASE STUDIES (alternating cream / dark, alternating layout) -->
  {cases.map((c, i) => {
    const isImageLeft = c.layout === 'image-left';
    const sectionClass = i % 2 === 0 ? 'section-cinematic' : 'section-panel';
    const imgBorder = '1px solid rgba(255,255,255,0.08)';
    const imgShadow = '0 30px 80px -25px rgba(186,154,110,0.16), 0 30px 60px -25px rgba(0,0,0,0.7)';
    return (
      <section class={`relative py-12 md:py-24 ${sectionClass} grain`}>
        <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-20 items-center">
            <div class={`flex flex-col gap-4 md:gap-6 lg:col-span-6 ${isImageLeft ? 'lg:order-2' : 'lg:order-1'}`}>
              <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style="font-family:Georgia,'Times New Roman',serif;">{c.label}</span>
              <h2 class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[0.98] tracking-[-0.02em]">{c.headline}</h2>
              <h3 class="text-white/55 text-[13px] md:text-sm uppercase tracking-[0.22em] font-medium max-w-lg">{c.subhead}</h3>
              <div class="flex flex-col gap-4 text-white/70 text-base md:text-lg leading-relaxed max-w-lg">
                {c.paragraphs.map(p => <p>{p}</p>)}
              </div>
            </div>
            <div class={`lg:col-span-6 ${isImageLeft ? 'lg:order-1' : 'lg:order-2'}`}>
              <picture>
                <source srcset={c.image.replace(/\.jpe?g$/, '.webp')} type="image/webp" />
                <img
                  src={c.image}
                  alt={c.imageAlt}
                  class="w-full h-auto block rounded-sm"
                  style={`box-shadow:${imgShadow}; border:${imgBorder};`}
                  loading="lazy"
                />
              </picture>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <!-- 6. CASE 05 (centered editorial proof, cinematic, borderless image) -->
  <section class="relative py-12 md:py-24 section-cinematic grain">
    <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 flex flex-col items-center text-center gap-8 md:gap-10">
      <div class="flex flex-col gap-4 md:gap-6 items-center">
        <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style="font-family:Georgia,'Times New Roman',serif;">{finalCase.label}</span>
        <h2 class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[0.98] tracking-[-0.02em] max-w-2xl">{finalCase.headline}</h2>
        <h3 class="text-white/55 text-[13px] md:text-sm uppercase tracking-[0.22em] font-medium max-w-xl">{finalCase.subhead}</h3>
        <div class="flex flex-col gap-4 text-white/70 text-base md:text-lg leading-relaxed max-w-xl">
          {finalCase.paragraphs.map(p => <p>{p}</p>)}
        </div>
      </div>
      <div class="w-full max-w-2xl mt-2 md:mt-4">
        <picture>
          <source srcset={finalCase.image.replace(/\.jpe?g$/, '.webp')} type="image/webp" />
          <img
            src={finalCase.image}
            alt={finalCase.imageAlt}
            class="w-full h-auto block rounded-sm"
            style="box-shadow:0 30px 80px -25px rgba(186,154,110,0.16), 0 30px 60px -25px rgba(0,0,0,0.7);"
            loading="lazy"
          />
        </picture>
      </div>
    </div>
  </section>

</Layout>
