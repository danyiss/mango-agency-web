---
import Layout from '../layouts/Layout.astro';

const cases = [
  {
    label: 'Case 01',
    headline: 'High traffic alone wasn’t translating into revenue.',
    paragraphs: [
      'This creator was already generating consistent attention and followers, but monetization behind the page was weak.',
      'After implementing structured chatting, retention systems and stronger monetization flows, revenue scaled into consistent 5-figure months.',
    ],
    image: '/assets/results/main-feature-block.jpeg',
    imageAlt: '$24k+ monthly revenue screenshot',
    reverse: false,
  },
  {
    label: 'Case 02',
    headline: 'Revenue became more stable once the backend was structured properly.',
    paragraphs: [
      'The page already had active fans, but monetization lacked consistency and long-term retention.',
      'By improving chatting structure, fan spending and monetization systems, revenue became significantly more predictable over time.',
    ],
    image: '/assets/results/results-grid1.jpeg',
    imageAlt: 'Stabilized monthly revenue screenshot',
    supporting: '/assets/results/results-grid2.jpeg',
    supportingAlt: 'Supporting revenue analytics screenshot',
    reverse: true,
  },
  {
    label: 'Case 03',
    headline: 'Better monetization created stronger daily revenue behind the same traffic.',
    paragraphs: [
      'By restructuring chatting, retention and monetization systems behind the page, overall fan spending increased significantly — leading to more profitable and consistent performance.',
    ],
    image: '/assets/results/daily-performance-block1.jpeg',
    imageAlt: '$2k+ daily revenue screenshot',
    supporting: '/assets/results/daily-performance-block2.jpeg',
    supportingAlt: 'Additional $2k+ daily performance proof',
    reverse: false,
  },
];
---

<Layout title="OnlyFans Case Studies & Revenue Results | MANGO Agency" description="Real revenue results from OnlyFans creators managed by MANGO — case studies, monthly earnings and growth metrics built on structured monetization systems." activeNav="results" lang="en" transparentTop={true}>

  <!-- 1. HERO (minimal black editorial) -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden flex items-center justify-center" style="background-color:#111111;">
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 w-full text-center flex flex-col items-center gap-7 md:gap-10">
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-white leading-[1.0]">A system-driven OnlyFans agency.</h1>
      <p class="text-white/70 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto">Predictable revenue built through structured monetization systems &mdash; no guesswork.</p>
    </div>
  </section>

  <!-- 2-4. CASE STUDIES (editorial vertical, staggered text/screenshot) -->
  {cases.map((c, i) => (
    <section class="py-24 md:py-36 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class={`grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center ${c.reverse ? '' : ''}`}>
          <!-- Text block -->
          <div class={`flex flex-col gap-6 lg:col-span-5 ${c.reverse ? 'lg:order-2' : 'lg:order-1'}`}>
            <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">{c.label}</span>
            <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-on-surface leading-[1.1]">{c.headline}</h2>
            <div class="flex flex-col gap-4 text-on-surface/75 text-base md:text-lg leading-relaxed max-w-lg">
              {c.paragraphs.map(p => <p>{p}</p>)}
            </div>
          </div>

          <!-- Screenshot block -->
          <div class={`lg:col-span-7 ${c.reverse ? 'lg:order-1' : 'lg:order-2'}`}>
            <img
              src={c.image}
              alt={c.imageAlt}
              class="w-full h-auto block"
              style="box-shadow: 0 20px 50px -20px rgba(17,17,17,0.15);"
              loading="lazy"
            />
          </div>
        </div>

        {c.supporting && i === 2 && (
          <!-- Supporting proof below CASE 3, smaller, aligned with editorial grid -->
          <div class="mt-20 md:mt-28 max-w-3xl mx-auto">
            <img
              src={c.supporting}
              alt={c.supportingAlt}
              class="w-full h-auto block"
              style="box-shadow: 0 16px 40px -16px rgba(17,17,17,0.12);"
              loading="lazy"
            />
          </div>
        )}

        {c.supporting && i === 1 && (
          <!-- Case 2 supporting analytics, secondary visual below -->
          <div class="mt-16 md:mt-20 max-w-3xl ml-auto">
            <img
              src={c.supporting}
              alt={c.supportingAlt}
              class="w-full h-auto block"
              style="box-shadow: 0 16px 40px -16px rgba(17,17,17,0.12);"
              loading="lazy"
            />
          </div>
        )}
      </div>
    </section>
  ))}

</Layout>
