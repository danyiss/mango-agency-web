---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'es' && !data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const siteUrl = 'https://www.mangova.agency';
const url = `${siteUrl}/es/blog/${post.data.slug}`;
const altUrl = `${siteUrl}/blog/${post.data.slug}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.coverImage ? `${siteUrl}${post.data.coverImage}` : `${siteUrl}/og-image-es.png`,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": `${siteUrl}/es/about`,
  },
  "publisher": {
    "@type": "Organization",
    "name": "MANGO Agency",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/logo.png` },
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": url },
  "inLanguage": "es",
  "keywords": post.data.tags.join(', '),
};
---

<Layout
  title={`${post.data.title} | Blog de MANGO`}
  description={post.data.description}
  activeNav=""
  lang="es"
  ogImage={post.data.coverImage ?? '/og-image-es.png'}
  transparentTop={true}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <link rel="alternate" hreflang="en" href={altUrl} />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    {post.data.updatedDate && <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
    <meta property="article:author" content={post.data.author} />
    {post.data.tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <article class="relative">
    <header class="relative min-h-[55vh] -mt-16 w-full overflow-hidden flex items-end pb-16 md:pb-24 section-cinematic grain">
      <div class="atmosphere-glow magenta" style="top:14%;right:-12%;width:520px;height:520px;opacity:0.35;"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-10 w-full pt-32 md:pt-40">
        <div class="flex flex-col items-start gap-6 md:gap-8">
          <div class="flex items-center gap-3 text-[11px] uppercase tracking-[0.28em] text-white/45">
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            {post.data.tags.length > 0 && <span>·</span>}
            <span>{post.data.tags.join(', ')}</span>
          </div>
          <h1 class="font-display text-[36px] sm:text-5xl md:text-6xl lg:text-7xl text-white leading-[1.0] tracking-[-0.025em]">{post.data.title}</h1>
          <p class="text-white/65 text-[15px] md:text-base lg:text-lg leading-relaxed max-w-3xl">{post.data.description}</p>
          <p class="text-white/45 text-sm">Por <a href="/es/about" class="text-white/65 hover:text-white underline underline-offset-4">{post.data.author}</a></p>
        </div>
      </div>
    </header>

    <section class="relative py-20 md:py-32 section-panel grain">
      <div class="relative z-10 max-w-2xl mx-auto px-6 lg:px-10">
        <div class="prose-mango text-white/80 text-base md:text-lg leading-[1.75]">
          <Content />
        </div>
      </div>
    </section>
  </article>

</Layout>
