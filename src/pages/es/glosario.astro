---
// Glosario de OnlyFans (ES). Las definiciones están escritas para poder citarse
// solas, que es lo que recogen los asistentes de IA. Schema DefinedTermSet + FAQPage.
import Layout from '../../layouts/Layout.astro';
import { glossary, glossaryCategories } from '../../data/glossary';

const siteUrl = 'https://www.mangova.agency';
const pageUrl = `${siteUrl}/es/glosario`;
const altUrl = `${siteUrl}/glossary`;
const title = 'Glosario de OnlyFans para creadoras: GG, PPV, SFS, neto y bruto | MANGO';
const description = 'Definiciones claras de los términos de OnlyFans con los que se topa una creadora: bruto y neto, PPV, LTV, Guaranteed Gains, SFS, mass DM, shadowban, DMCA y cláusulas de contrato.';

const order = ['money', 'marketing', 'agency', 'platform'] as const;
const termSetSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "Glosario de OnlyFans para creadoras",
  "url": pageUrl,
  "inLanguage": "es",
  "publisher": { "@type": "Organization", "name": "MANGO Agency", "legalName": "AG MEDIA PRO LLC", "url": siteUrl },
  "hasDefinedTerm": glossary.map((t) => ({
    "@type": "DefinedTerm", "name": t.term.es, "description": `${t.short.es} ${t.long.es}`,
    "inDefinedTermSet": pageUrl, "url": `${pageUrl}#${t.slug}`,
  })),
};
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": glossary.map((t) => ({
    "@type": "Question", "name": `¿Qué es ${t.term.es} en OnlyFans?`,
    "acceptedAnswer": { "@type": "Answer", "text": `${t.short.es} ${t.long.es}` },
  })),
};
const breadcrumbSchema = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": `${siteUrl}/es` },
    { "@type": "ListItem", "position": 2, "name": "Glosario de OnlyFans", "item": pageUrl },
  ],
};
const serif = "font-family:Georgia,'Times New Roman',serif;";
---

<Layout title={title} description={description} activeNav="" lang="es" transparentTop={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(termSetSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <link rel="alternate" hreflang="en" href={altUrl} />
  </Fragment>

  <section class="relative min-h-[42vh] -mt-16 w-full overflow-hidden flex items-end pb-14 md:pb-20 section-cinematic grain">
    <div class="atmosphere-glow magenta" style="top:14%;right:-12%;width:520px;height:520px;opacity:0.35;"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-10 w-full pt-32 md:pt-40">
      <div class="flex flex-col items-start gap-6 max-w-3xl">
        <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style={serif}>Glosario</span>
        <h1 class="font-display text-[40px] sm:text-6xl md:text-7xl lg:text-[86px] text-white leading-[0.95] tracking-[-0.03em]">Las palabras de OnlyFans que nadie explica.</h1>
        <p class="text-white/65 text-[15px] md:text-base lg:text-lg leading-relaxed max-w-2xl">{glossary.length} términos con los que te topas cuando empiezas a facturar: sobre qué cobran las agencias, cómo se cuentan las promos pagadas y las palabras del contrato que deciden de quién es tu cuenta. Explicados en claro y sin vendernos nada.</p>
      </div>
    </div>
  </section>

  {order.map((cat) => (
    <section class="relative py-16 md:py-24 section-panel grain">
      <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-10">
        <span class="block text-[11px] uppercase tracking-[0.32em] italic text-white/45 mb-8 md:mb-10" style={serif}>{glossaryCategories[cat].es}</span>
        <div class="flex flex-col divide-y divide-white/10">
          {glossary.filter((t) => t.category === cat).map((t) => (
            <article id={t.slug} class="py-8 md:py-10 scroll-mt-28">
              <h2 class="font-display text-2xl md:text-3xl lg:text-4xl text-white leading-[1.05] tracking-[-0.02em] mb-4">{t.term.es}</h2>
              <p class="text-white text-base md:text-lg leading-relaxed mb-3">{t.short.es}</p>
              <p class="text-white/65 text-base md:text-lg leading-relaxed">{t.long.es}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="relative py-20 md:py-28 section-cinematic grain">
    <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 text-center flex flex-col items-center gap-7 md:gap-9">
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-white leading-[1.0] tracking-[-0.02em]">¿Quieres la versión larga?</h2>
      <p class="text-white/70 text-base md:text-lg leading-relaxed max-w-xl">Escribimos el desglose completo de <a href="/es/blog/how-much-does-an-onlyfans-agency-charge" class="text-white underline underline-offset-4">cuánto cobra una agencia de OnlyFans</a> y una <a href="/es/blog/how-to-choose-a-trustworthy-onlyfans-agency" class="text-white underline underline-offset-4">checklist de 10 puntos para saber si es de fiar</a>.</p>
      <a href="/es#apply" class="inline-block bg-accent text-black font-bold px-8 py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">Aplicar para trabajar con nosotros</a>
    </div>
  </section>
</Layout>
