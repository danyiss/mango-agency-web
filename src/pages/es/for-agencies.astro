---
import Layout from '../../layouts/Layout.astro';
import AgencyApplyForm from '../../components/AgencyApplyForm.astro';

const lossCards = [
  { title: 'Estructura de monetización débil', text: 'Los fans se suscriben, chatean un poco y desaparecen sin entrar en ningún flujo de ventas real.' },
  { title: 'Compradores quemados', text: 'Pushes agresivos de PPV matan el gasto a largo plazo y reducen la retención de fans.' },
  { title: 'Chatting inconsistente', text: 'Distintos chatters crean experiencias distintas, haciendo que la página se sienta inestable y desconectada.' },
  { title: 'Sin visibilidad de monetización', text: 'La mayoría de agencias ven la caída de ingresos cuando ya ha pasado — sin saber por qué.' },
];

const solutionBullets = [
  { title: 'Chatters dedicados por modelo.', text: 'Tono, ritmo y construcción de relaciones consistentes en cada turno.' },
  { title: 'Equipos nativos de monetización en inglés y español.', text: 'Construidos para maximizar conversión, retención y gasto del fan en distintas audiencias.' },
  { title: 'Flujos de monetización estructurados.', text: 'Warm-up, engagement emocional, upsell, retención y sistemas de reactivación.' },
  { title: 'Segmentación avanzada de fans.', text: 'Estrategias de monetización distintas para whales, compradores, suscriptores y fans dormidos.' },
  { title: 'Desarrollo de spenders a largo plazo.', text: 'Construido para aumentar retención, compras repetidas y LTV total del fan — no solo picos puntuales de PPV.' },
  { title: 'QA interno y revisiones de conversación.', text: 'Las conversaciones se revisan constantemente para mantener calidad, consistencia, experiencia del fan y valor a largo plazo.' },
];

const mapSteps = [
  { title: 'Adquisición de fans', text: 'Los fans entran a través de los sistemas de tráfico.' },
  { title: 'Cualificación de fans', text: 'Los fans se identifican según potencial de gasto, nivel de engagement y patrones de comportamiento.' },
  { title: 'Construcción de relación', text: 'Conversaciones diseñadas para construir engagement, inversión emocional y retención a largo plazo.' },
  { title: 'Sistemas de monetización', text: 'Upsells estructurados, ritmo controlado de PPV, reactivación de fans y desarrollo de spenders a largo plazo.' },
  { title: 'Optimización de ingresos', text: 'Análisis continuo del rendimiento del chatting, flujo de conversión, comportamiento de gasto y resultados de monetización.' },
  { title: 'Control de calidad', text: 'Revisiones de conversaciones, seguimiento de rendimiento y ajustes semanales de monetización.' },
];

const howSteps = [
  { num: '01', title: 'Auditoría de monetización', text: 'Analizamos la estructura actual de chatting, comportamiento de fans, patrones de gasto y fugas de monetización en la página.' },
  { num: '02', title: 'Integración del sistema', text: 'Implementamos los flujos de monetización, sistemas de segmentación, estructura de QA y operaciones de chatting.' },
  { num: '03', title: 'Ejecución de ingresos', text: 'Nos encargamos de las conversaciones diarias, upsells, retención, relaciones con fans y desarrollo de spenders a largo plazo.' },
  { num: '04', title: 'Análisis y Optimización', text: 'Revisamos continuamente el rendimiento del chatting, flujo de conversión, comportamiento de gasto y resultados de monetización.' },
];

const whyBullets = [
  { title: 'Equipos de monetización dedicados por modelo.', text: 'Formados continuamente con sistemas de venta estructurados, revisiones de QA y análisis de rendimiento continuo.' },
  { title: 'Monetización construida sobre retención y LTV.', text: 'Enfocada en aumentar el gasto recurrente, las relaciones con fans y la estabilidad de ingresos a largo plazo.' },
  { title: 'Conversaciones diseñadas para preservar la inmersión y la inversión emocional.', text: 'Porque cuando el fan siente que la página es fake o inconsistente, el gasto a largo plazo cae rápido.' },
  { title: 'Control operativo sobre el proceso de monetización.', text: 'Revisiones de QA, seguimiento de rendimiento y optimización continua — no delegación a ciegas.' },
  { title: 'Sistemas de monetización estructurados diseñados para escalar.', text: 'Ejecución consistente, rendimiento repetible y menor dependencia de chatters individuales.' },
];

const faqs = [
  { q: '¿Trabajáis directamente con mis modelos?', a: 'No. Operamos como tu sistema backend. Tú mantienes la propiedad total de la relación, la marca y la comunicación. Nosotros simplemente nos encargamos de la monetización por detrás.' },
  { q: '¿Notarán mis modelos la diferencia?', a: 'No. Todo se adapta al tono, personalidad y límites de cada modelo. Por fuera no cambia nada. Por dentro, los ingresos mejoran.' },
  { q: '¿Cómo aseguráis la calidad en el chatting?', a: 'Usamos sistemas estructurados, no improvisación: chatters dedicados por modelo, QA interno y monitorización, seguimiento de rendimiento por chatter y optimización continua.' },
  { q: '¿En cuánto podemos empezar?', a: 'Una vez alineados, el setup puede completarse en 24 horas y empezamos a optimizar inmediatamente.' },
  { q: '¿Cómo se cobra?', a: 'Modelo basado en rendimiento. Cada setup es distinto según tus modelos, ingresos actuales y estructura. Solo ganamos dinero si tus ingresos suben — así nos mantenemos alineados.' },
  { q: '¿Por qué trabajar con vosotros en lugar de montarlo internamente?', a: 'Puedes hacerlo. Pero requiere tiempo, contratación, formación, gestión y optimización constante. Te damos un sistema que ya funciona — sin la complejidad operativa.' },
];
---

<Layout title="Sistemas de Chatting OnlyFans para Agencias | MANGO" description="Colabora con MANGO para gestionar el chatting y la monetización de tu agencia OnlyFans. Chatters dedicados por modelo, flujos de venta estructurados y sistemas de monetización diseñados para escalar." activeNav="for-agencies" lang="es" transparentTop={true}>

  <!-- 1. HERO — cinematic, darker overlay, oversized type -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/hero-agencies-v3.png');"></div>
    <div class="absolute inset-0" style="background-color:rgba(0,0,0,0.72);"></div>
    <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, rgba(0,0,0,0.35), rgba(0,0,0,0) 30%, rgba(0,0,0,0.55));"></div>
    <div class="absolute inset-0 flex items-start pt-[18vh] md:items-center md:pt-0">
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full">
        <div class="max-w-[640px] flex flex-col gap-7 md:gap-10">
          <span class="text-xs uppercase tracking-[0.28em] italic text-white/55" style="font-family:Georgia,'Times New Roman',serif;">Para agencias</span>
          <h1 class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[120px] text-white leading-[0.92] tracking-[-0.025em]">
            Hecho para agencias de OnlyFans.
          </h1>
          <p class="text-white/70 text-base md:text-lg leading-relaxed font-body max-w-md">
            Nos encargamos del chatting y la monetizaci&oacute;n para que t&uacute; te centres en el tr&aacute;fico y el crecimiento.
          </p>
          <div class="border-l border-white/25 pl-5 text-[13px] md:text-sm text-white/55 leading-snug max-w-xs">
            <p>T&uacute; mantienes la modelo, la marca y la relaci&oacute;n.</p>
            <p class="mt-1">Nosotros subimos los ingresos.</p>
          </div>
          <div class="mt-3">
            <a href="#agency-apply" class="group inline-flex items-baseline gap-3 text-white text-xs md:text-sm uppercase tracking-[0.22em] font-medium border-b border-white/45 pb-2 hover:border-white transition-colors duration-300">
              Solicitar ahora <span class="group-hover:translate-x-1 transition-transform duration-300">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROBLEM (CREAM editorial) -->
  <section class="py-36 md:py-56" style="background-color:#f5f2ee;">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 flex flex-col gap-7 md:gap-10 text-center">
      <p class="font-display text-3xl md:text-5xl lg:text-6xl text-on-surface leading-[1.05] tracking-[-0.015em]">T&uacute; sabes generar tr&aacute;fico.</p>
      <p class="font-display text-3xl md:text-5xl lg:text-6xl text-on-surface/45 leading-[1.05] tracking-[-0.015em]">Nosotros sabemos maximizar la monetizaci&oacute;n detr&aacute;s.</p>
    </div>
  </section>

  <!-- 3. WHERE AGENCIES LOSE REVENUE (deep black, editorial 2-col) -->
  <section class="py-36 md:py-56" style="background-color:#0a0a0a;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-24 md:mb-36 max-w-4xl">
        <span class="text-xs uppercase tracking-[0.28em] italic text-white/45 mb-6 block" style="font-family:Georgia,'Times New Roman',serif;">Secci&oacute;n 01 &mdash; El problema</span>
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-white leading-[0.94] tracking-[-0.025em]">D&oacute;nde las agencias pierden ingresos.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24 gap-y-14 md:gap-y-20">
        {lossCards.map(card => (
          <div class="flex flex-col gap-4 pb-10 md:pb-12" style="border-bottom:1px solid rgba(255,255,255,0.1);">
            <h3 class="font-display text-2xl md:text-3xl lg:text-4xl text-white leading-[1.05] tracking-[-0.015em]">{card.title}</h3>
            <p class="text-white/55 text-base leading-relaxed max-w-md">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. SOLUTION (CREAM) — operator-level -->
  <section class="py-36 md:py-56" style="background-color:#f5f2ee;">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <div class="mb-20 md:mb-28 max-w-3xl">
        <span class="text-xs uppercase tracking-[0.28em] italic text-on-surface/45 mb-6 block" style="font-family:Georgia,'Times New Roman',serif;">Secci&oacute;n 02 &mdash; La soluci&oacute;n</span>
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-on-surface leading-[0.94] tracking-[-0.025em]">Nos convertimos en tu sistema de monetizaci&oacute;n.</h2>
      </div>

      <ul class="flex flex-col">
        {solutionBullets.map((item, idx) => (
          <li class={`py-9 md:py-11 grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-12 items-baseline ${idx === 0 ? 'border-y' : 'border-b'}`} style="border-color:rgba(17,17,17,0.12);">
            <p class="font-display text-xl md:text-2xl text-on-surface leading-tight tracking-[-0.01em] lg:col-span-5">{item.title}</p>
            <p class="text-on-surface/65 text-base leading-relaxed lg:col-span-7 lg:max-w-lg">{item.text}</p>
          </li>
        ))}
      </ul>

      <!-- Refined monetization system map -->
      <div class="mt-32 md:mt-44">
        <span class="text-xs uppercase tracking-[0.28em] italic text-on-surface/45 mb-12 md:mb-16 block text-center" style="font-family:Georgia,'Times New Roman',serif;">El mapa del sistema de monetizaci&oacute;n</span>
        <div class="max-w-2xl mx-auto">
          {mapSteps.map((step, i) => (
            <div class={`py-9 md:py-11 grid grid-cols-12 gap-5 sm:gap-10 items-baseline ${i === 0 ? 'border-y' : 'border-b'}`} style="border-color:rgba(17,17,17,0.12);">
              <span class="col-span-2 text-xs uppercase tracking-[0.28em] italic text-on-surface/45" style="font-family:Georgia,'Times New Roman',serif;">{String(i+1).padStart(2,'0')}</span>
              <div class="col-span-10 flex flex-col gap-2">
                <p class="font-display text-xl md:text-2xl text-on-surface leading-tight tracking-[-0.01em]">{step.title}</p>
                <p class="text-on-surface/65 text-sm md:text-base leading-relaxed max-w-lg">{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. HOW IT WORKS (BLACK, editorial workflow, no cards) -->
  <section class="py-36 md:py-56" style="background-color:#111111;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-24 md:mb-36 max-w-3xl">
        <span class="text-xs uppercase tracking-[0.28em] italic text-white/45 mb-6 block" style="font-family:Georgia,'Times New Roman',serif;">Secci&oacute;n 03 &mdash; El proceso</span>
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-white leading-[0.94] tracking-[-0.025em]">C&oacute;mo funciona.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16">
        {howSteps.map(step => (
          <div class="flex flex-col gap-6">
            <span class="font-display leading-[0.85] tracking-[-0.02em]" style="font-size:clamp(56px, 8vw, 96px); color:rgba(255,255,255,0.18);">{step.num}</span>
            <h3 class="font-display text-xl md:text-2xl text-white leading-[1.1] tracking-[-0.01em]">{step.title}</h3>
            <p class="text-white/55 text-sm md:text-base leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. WHY TOP AGENCIES (CREAM, quiet confidence) -->
  <section class="py-36 md:py-56" style="background-color:#f5f2ee;">
    <div class="max-w-5xl mx-auto px-6 lg:px-10">
      <div class="mb-20 md:mb-28 max-w-3xl">
        <span class="text-xs uppercase tracking-[0.28em] italic text-on-surface/45 mb-6 block" style="font-family:Georgia,'Times New Roman',serif;">Secci&oacute;n 04 &mdash; La diferenciaci&oacute;n</span>
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-on-surface leading-[0.94] tracking-[-0.025em]">Por qu&eacute; las top agencias trabajan con nosotros.</h2>
      </div>
      <ul class="flex flex-col max-w-3xl">
        {whyBullets.map((item, idx) => (
          <li class={`py-9 md:py-11 ${idx === 0 ? 'border-y' : 'border-b'}`} style="border-color:rgba(17,17,17,0.12);">
            <p class="font-display text-xl md:text-2xl text-on-surface leading-tight tracking-[-0.01em] mb-3">{item.title}</p>
            <p class="text-on-surface/65 text-base leading-relaxed max-w-xl">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. AGENCY APPLICATION FORM (dark, private application) -->
  <AgencyApplyForm lang="es" />

  <!-- 8. FAQ (CREAM, minimal hairline) -->
  <section class="py-36 md:py-48" style="background-color:#f5f2ee;">
    <div class="max-w-4xl mx-auto px-6 lg:px-10">
      <div class="mb-16 md:mb-24 max-w-3xl">
        <h2 class="font-display text-5xl md:text-7xl text-on-surface leading-[0.94] tracking-[-0.025em]">Preguntas frecuentes.</h2>
      </div>
      <div class="flex flex-col">
        {faqs.map((faq, idx) => (
          <details class={`group ${idx === 0 ? 'border-y' : 'border-b'}`} style="border-color:rgba(17,17,17,0.14);">
            <summary class="py-7 md:py-8 flex items-center justify-between cursor-pointer list-none select-none">
              <span class="font-display text-lg md:text-xl text-on-surface pr-6 tracking-[-0.005em]">{faq.q}</span>
              <span class="material-symbols-outlined expand-icon text-on-surface/40 flex-shrink-0 transition-transform duration-300">add</span>
            </summary>
            <div class="pb-8 text-on-surface/65 text-sm md:text-base leading-relaxed max-w-2xl">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
