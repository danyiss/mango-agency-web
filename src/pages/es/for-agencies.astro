---
import Layout from '../../layouts/Layout.astro';
import AgencyApplyForm from '../../components/AgencyApplyForm.astro';

const lossCards = [
  { title: 'Estructura de monetización débil', text: 'Los fans se suscriben, chatean un poco y desaparecen sin entrar en ningún flujo de ventas real.' },
  { title: 'Compradores quemados', text: 'Pushes agresivos de PPV matan el gasto a largo plazo y reducen la retención de fans.' },
  { title: 'Chatting inconsistente', text: 'Distintos chatters crean experiencias distintas, haciendo que la página se sienta inestable y desconectada.' },
  { title: 'Sin visibilidad de monetización', text: 'La mayoría de agencias ven la caída de ingresos cuando ya ha pasado — sin saber por qué.' },
];

const topAgencyReasons = [
  { title: 'Equipos de chatting dedicados por modelo.', text: 'Formados continuamente a través de sistemas estructurados de ventas, revisiones de QA y análisis continuo de rendimiento.' },
  { title: 'Monetización construida alrededor de la retención y el LTV.', text: 'Enfocada en aumentar el gasto recurrente, relaciones más fuertes con los fans y estabilidad de ingresos a largo plazo.' },
  { title: 'Equipos de monetización nativos en inglés y español.', text: 'Diseñados para maximizar la conversión, la retención y el gasto de los fans en diferentes audiencias y mercados.' },
  { title: 'Flujos de monetización estructurados.', text: 'Sistemas de warm-up, engagement emocional, upsells, retención y reactivación diseñados para maximizar el valor a largo plazo del fan — no solo ventas a corto plazo.' },
  { title: 'Segmentación avanzada de fans.', text: 'Diferentes estrategias de monetización para whales, compradores, suscriptores y fans inactivos basadas en patrones de comportamiento y gasto.' },
  { title: 'Replicación de la persona de la creadora.', text: 'Estudiamos en profundidad la voz, personalidad, límites y dinámica de audiencia de cada creadora para crear interacciones auténticas con los fans que preserven la inmersión, fortalezcan la conexión emocional y maximicen el gasto a largo plazo.' },
  { title: 'Conversaciones diseñadas para preservar la inmersión y la inversión emocional.', text: 'Porque una vez que el fan siente que la página es falsa, inconsistente o transaccional, el gasto a largo plazo cae rápido.' },
  { title: 'Control operativo sobre el proceso de monetización.', text: 'Los chats se revisan constantemente a través de sistemas de QA, seguimiento de rendimiento y optimización continua para maximizar los ingresos, la consistencia y la experiencia del fan.' },
  { title: 'Gestión completa de cuenta.', text: 'Planificación de contenido, publicación, monetización, analíticas, gestión de fans y soporte operativo estructurado para eliminar el caos y ayudar a las creadoras a escalar de forma más eficiente.' },
  { title: 'Sistemas de monetización estructurados diseñados para escalar.', text: 'Ejecución consistente, rendimiento repetible y reducción de la dependencia de chatters individuales a medida que la agencia crece.' },
];

const mapSteps = [
  { title: 'Adquisición de fans', text: 'Los fans entran a través de los sistemas de tráfico.' },
  { title: 'Cualificación de fans', text: 'Los fans se identifican según potencial de gasto, nivel de engagement y patrones de comportamiento.' },
  { title: 'Construcción de relación', text: 'Conversaciones diseñadas para construir engagement, inversión emocional y retención a largo plazo.' },
  { title: 'Sistemas de monetización', text: 'Upsells estructurados, ritmo controlado de PPV, reactivación de fans y desarrollo de spenders a largo plazo.' },
  { title: 'Optimización de ingresos', text: 'Análisis continuo del rendimiento del chatting, flujo de conversión, comportamiento de gasto y resultados de monetización.' },
  { title: 'Control de calidad', text: 'Revisiones de conversaciones, seguimiento de rendimiento y ajustes semanales de monetización.' },
];

const howSteps = [
  { num: '01', title: 'Auditoría de monetización', text: 'Analizamos la estructura actual de chatting, comportamiento de fans, patrones de gasto y fugas de monetización en la página.' },
  { num: '02', title: 'Integración del sistema', text: 'Implementamos los flujos de monetización, sistemas de segmentación, estructura de QA y operaciones de chatting.' },
  { num: '03', title: 'Ejecución de ingresos', text: 'Nos encargamos de las conversaciones diarias, upsells, retención, relaciones con fans y desarrollo de spenders a largo plazo.' },
  { num: '04', title: 'Análisis y Optimización', text: 'Revisamos continuamente el rendimiento del chatting, flujo de conversión, comportamiento de gasto y resultados de monetización.' },
];

const faqs = [
  { q: '¿Trabajáis directamente con mis modelos?', a: 'No. Operamos como tu sistema backend. Tú mantienes la propiedad total de la relación, la marca y la comunicación. Nosotros simplemente nos encargamos de la monetización por detrás.' },
  { q: '¿Notarán mis modelos la diferencia?', a: 'No. Todo se adapta al tono, personalidad y límites de cada modelo. Por fuera no cambia nada. Por dentro, los ingresos mejoran.' },
  { q: '¿Cómo aseguráis la calidad en el chatting?', a: 'Usamos sistemas estructurados, no improvisación: chatters dedicados por modelo, QA interno y monitorización, seguimiento de rendimiento por chatter y optimización continua.' },
  { q: '¿En cuánto podemos empezar?', a: 'Una vez alineados, el setup puede completarse en 24 horas y empezamos a optimizar inmediatamente.' },
  { q: '¿Cómo se cobra?', a: 'Modelo basado en rendimiento. Cada setup es distinto según tus modelos, ingresos actuales y estructura. Solo ganamos dinero si tus ingresos suben — así nos mantenemos alineados.' },
  { q: '¿Por qué trabajar con vosotros en lugar de montarlo internamente?', a: 'Puedes hacerlo. Pero requiere tiempo, contratación, formación, gestión y optimización constante. Te damos un sistema que ya funciona — sin la complejidad operativa.' },
];
---

<Layout title="Servicio de Chatting | MANGO" description="Servicio de chatting de MANGO para agencias de OnlyFans. Chatters dedicados por modelo, flujos de venta estructurados y sistemas de monetización diseñados para escalar." activeNav="for-agencies" lang="es" transparentTop={true}>

  <!-- 1. HERO — cinematic, deep overlay, atmospheric grain -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden grain">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/hero-agencies-v3.png');"></div>
    <div class="absolute inset-0" style="background-color:rgba(0,0,0,0.82);"></div>
    <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0) 30%, rgba(0,0,0,0.65));"></div>
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 50% at 78% 22%, rgba(186,154,110,0.1), transparent 65%);"></div>
    <div class="absolute inset-0 flex items-start pt-[18vh] md:items-center md:pt-0">
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full">
        <div class="max-w-[860px] flex flex-col gap-5 md:gap-7">
          <span class="text-[11px] uppercase tracking-[0.32em] text-white/55 font-medium">Para Agencias y Creadoras</span>
          <h1 class="font-display text-[28px] sm:text-5xl md:text-6xl lg:text-7xl xl:text-[72px] text-white leading-[0.96] tracking-[-0.025em]">
            <span class="block whitespace-nowrap">Chatting de OnlyFans</span>
            <span class="block whitespace-nowrap">Servicio 24/7</span>
          </h1>
          <p class="text-white/75 text-base md:text-lg leading-relaxed font-body max-w-[820px]">
            Gestionamos el chatting 24/7 con un equipo experto entrenado para maximizar los ingresos, la retenci&oacute;n y el gasto de los fans &mdash; para que puedas enfocarte en crecimiento y escalado.
          </p>
          <div class="mt-2">
            <a href="#agency-apply" class="inline-block bg-accent text-black font-bold px-7 py-3.5 md:py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">
              Solicitar ahora
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PROBLEM positioning (cinematic editorial) -->
  <section class="relative py-24 md:py-56 section-cinematic grain">
    <div class="relative z-10 max-w-5xl mx-auto px-6 lg:px-10 flex flex-col gap-5 md:gap-10 text-center">
      <p class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[1.05] tracking-[-0.015em] md:whitespace-nowrap">T&uacute; sabes generar tr&aacute;fico.</p>
      <p class="font-display text-3xl md:text-5xl lg:text-6xl text-white/45 leading-[1.05] tracking-[-0.015em]">Nosotros sabemos maximizar la monetizaci&oacute;n detr&aacute;s.</p>
    </div>
  </section>

  <!-- 3. WHERE AGENCIES LOSE REVENUE (warm beige textured, the problems break) -->
  <section class="relative py-24 md:py-56 section-beige">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-24 md:mb-36 max-w-4xl">
        <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-on-surface leading-[0.94] tracking-[-0.025em]">D&oacute;nde las agencias pierden ingresos</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-24 gap-y-14 md:gap-y-20">
        {lossCards.map(card => (
          <div class="flex flex-col gap-4 pb-10 md:pb-12" style="border-bottom:1px solid rgba(17,17,17,0.2);">
            <h3 class="font-display text-2xl md:text-3xl lg:text-4xl text-on-surface leading-[1.05] tracking-[-0.015em]">{card.title}</h3>
            <p class="text-on-surface/65 text-base leading-relaxed max-w-md">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. POR QUÉ LAS MEJORES AGENCIAS ELIGEN TRABAJAR CON NOSOTROS (sticky title left + 10 benefits right) -->
  <section class="relative py-24 md:py-56 section-panel grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <!-- Sticky headline column -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-5xl md:text-7xl lg:text-7xl xl:text-7xl text-white leading-[0.94] md:leading-[0.92] tracking-[-0.025em]">
            Por qu&eacute;<br class="hidden md:inline" /> las<br class="hidden md:inline" /> Mejores<br class="hidden md:inline" /> Agencias<br /> Eligen<br class="hidden md:inline" /> Trabajar<br /> con<br class="hidden md:inline" /> Nosotros
          </h2>
        </div>

        <!-- Benefits stacked right — editorial storytelling pattern matching the Pain section -->
        <div class="lg:col-span-7 flex flex-col">
          {topAgencyReasons.map((r, idx) => (
            <div class={`editorial-step pb-12 md:pb-20 ${idx === 0 ? '' : 'border-t pt-12 md:pt-20'}`} style="border-color:rgba(255,255,255,0.08);">
              <span class="block text-[11px] uppercase tracking-[0.32em] italic text-white/45 mb-5 md:mb-7" style="font-family:Georgia,'Times New Roman',serif;">{String(idx+1).padStart(2,'0')}</span>
              <h3 class="font-display text-2xl md:text-4xl lg:text-5xl text-white leading-[1.05] md:leading-[1.0] tracking-[-0.015em] mb-4 md:mb-6">{r.title}</h3>
              <p class="text-white/65 text-[15px] md:text-base leading-relaxed max-w-lg">{r.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Refined monetization system map: intro + 6 steps -->
      <div class="mt-28 md:mt-44">
        <div class="max-w-2xl mx-auto">
          <div class="mb-10 md:mb-14 text-center">
            <h3 class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[0.98] tracking-[-0.02em]">C&oacute;mo Funciona Nuestro Sistema de Monetizaci&oacute;n</h3>
            <p class="mt-5 md:mt-6 text-white/65 text-base md:text-lg leading-relaxed max-w-xl mx-auto">Un proceso de chatting estructurado dise&ntilde;ado para aumentar la retenci&oacute;n, el gasto de los fans y los ingresos a largo plazo en tu agencia.</p>
          </div>
          {mapSteps.map((step, i) => (
            <div class={`py-9 md:py-11 grid grid-cols-12 gap-5 sm:gap-10 items-baseline ${i === 0 ? 'border-y' : 'border-b'}`} style="border-color:rgba(255,255,255,0.12);">
              <span class="col-span-2 text-xs uppercase tracking-[0.28em] italic text-white/45" style="font-family:Georgia,'Times New Roman',serif;">{String(i+1).padStart(2,'0')}</span>
              <div class="col-span-10 flex flex-col gap-2">
                <p class="font-display text-xl md:text-2xl text-white leading-tight tracking-[-0.01em]">{step.title}</p>
                <p class="text-white/65 text-sm md:text-base leading-relaxed max-w-lg">{step.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. HOW IT WORKS (dark panel, editorial workflow, no cards) -->
  <section class="relative py-24 md:py-56 section-panel grain">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-24 md:mb-36 max-w-3xl">
        <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-white leading-[0.94] tracking-[-0.025em]">C&oacute;mo Empezar con Nosotros</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16">
        {howSteps.map(step => (
          <div class="flex flex-col gap-6">
            <span class="font-display leading-[0.85] tracking-[-0.02em]" style="font-size:clamp(56px, 8vw, 96px); color:rgba(255,255,255,0.18);">{step.num}</span>
            <h3 class="font-display text-xl md:text-2xl text-white leading-[1.1] tracking-[-0.01em]">{step.title}</h3>
            <p class="text-white/55 text-sm md:text-base leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- 7. AGENCY APPLICATION FORM (dark, private application) -->
  <AgencyApplyForm lang="es" />

  <!-- 8. FAQ (dark panel, minimal hairline) -->
  <section class="relative py-24 md:py-48 section-panel grain">
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-10">
      <div class="mb-16 md:mb-24 max-w-3xl">
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[0.94] tracking-[-0.025em] md:whitespace-nowrap">Preguntas Frecuentes</h2>
      </div>
      <div class="flex flex-col">
        {faqs.map((faq, idx) => (
          <details class={`group ${idx === 0 ? 'border-y' : 'border-b'} hover:bg-white/[0.02] transition-colors`} style="border-color:rgba(255,255,255,0.14);">
            <summary class="py-7 md:py-8 flex items-center justify-between cursor-pointer list-none select-none">
              <span class="font-display text-lg md:text-xl text-white pr-6 tracking-[-0.005em]">{faq.q}</span>
              <span class="material-symbols-outlined expand-icon flex-shrink-0 transition-transform duration-300" style="color:#C8A96A;">add</span>
            </summary>
            <div class="pb-8 text-white/65 text-sm md:text-base leading-relaxed max-w-2xl">{faq.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
