---
import Layout from '../../layouts/Layout.astro';

const cases = [
  {
    label: 'Caso 01',
    headline: 'El tráfico alto por sí solo no se traducía en ingresos.',
    paragraphs: [
      'Esta creadora ya generaba atención y seguidores de forma constante, pero la monetización detrás de la página era débil.',
      'Tras implementar chatting estructurado, sistemas de retención y flujos de monetización más fuertes, los ingresos escalaron a meses de 5 cifras consistentes.',
    ],
    image: '/assets/results/main-feature-block.jpeg',
    imageAlt: 'Screenshot de ingresos mensuales superiores a $24k',
    reverse: false,
  },
  {
    label: 'Caso 02',
    headline: 'Los ingresos se volvieron más estables una vez que el backend se estructuró bien.',
    paragraphs: [
      'La página ya tenía fans activos, pero a la monetización le faltaba consistencia y retención a largo plazo.',
      'Mejorando la estructura del chatting, el gasto de los fans y los sistemas de monetización, los ingresos se volvieron significativamente más predecibles con el tiempo.',
    ],
    image: '/assets/results/results-grid1.jpeg',
    imageAlt: 'Screenshot de ingresos mensuales estabilizados',
    supporting: '/assets/results/results-grid2.jpeg',
    supportingAlt: 'Analítica de ingresos como soporte',
    reverse: true,
  },
  {
    label: 'Caso 03',
    headline: 'Una mejor monetización creó ingresos diarios más fuertes detrás del mismo tráfico.',
    paragraphs: [
      'Al reestructurar el chatting, la retención y los sistemas de monetización detrás de la página, el gasto total de los fans aumentó significativamente — generando un rendimiento más rentable y consistente.',
    ],
    image: '/assets/results/daily-performance-block1.jpeg',
    imageAlt: 'Screenshot de ingresos diarios superiores a $2k',
    supporting: '/assets/results/daily-performance-block2.jpeg',
    supportingAlt: 'Prueba adicional de rendimiento diario superior a $2k',
    reverse: false,
  },
];
---

<Layout title="Casos y Resultados OnlyFans | MANGO Agency" description="Resultados reales de ingresos de creadoras de OnlyFans gestionadas por MANGO — casos, ingresos mensuales y métricas de crecimiento basados en sistemas estructurados de monetización." activeNav="results" lang="es" transparentTop={true}>

  <!-- 1. HERO (minimal black editorial) -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden flex items-center justify-center" style="background-color:#111111;">
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 w-full text-center flex flex-col items-center gap-7 md:gap-10">
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl text-white leading-[1.0]">Una agencia OnlyFans basada en sistemas.</h1>
      <p class="text-white/70 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto">Ingresos predecibles construidos con sistemas estructurados de monetizaci&oacute;n &mdash; sin improvisaciones.</p>
    </div>
  </section>

  <!-- 2-4. CASE STUDIES (editorial vertical, staggered text/screenshot) -->
  {cases.map((c, i) => (
    <section class="py-24 md:py-36 bg-white">
      <div class="max-w-6xl mx-auto px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
          <!-- Text block -->
          <div class={`flex flex-col gap-6 lg:col-span-5 ${c.reverse ? 'lg:order-2' : 'lg:order-1'}`}>
            <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">{c.label}</span>
            <h2 class="font-display text-3xl md:text-4xl lg:text-5xl text-on-surface leading-[1.1]">{c.headline}</h2>
            <div class="flex flex-col gap-4 text-on-surface/75 text-base md:text-lg leading-relaxed max-w-lg">
              {c.paragraphs.map(p => <p>{p}</p>)}
            </div>
          </div>

          <!-- Screenshot block -->
          <div class={`lg:col-span-7 ${c.reverse ? 'lg:order-1' : 'lg:order-2'}`}>
            <img
              src={c.image}
              alt={c.imageAlt}
              class="w-full h-auto block"
              style="box-shadow: 0 20px 50px -20px rgba(17,17,17,0.15);"
              loading="lazy"
            />
          </div>
        </div>

        {c.supporting && i === 2 && (
          <!-- Soporte bajo el Caso 3 -->
          <div class="mt-20 md:mt-28 max-w-3xl mx-auto">
            <img
              src={c.supporting}
              alt={c.supportingAlt}
              class="w-full h-auto block"
              style="box-shadow: 0 16px 40px -16px rgba(17,17,17,0.12);"
              loading="lazy"
            />
          </div>
        )}

        {c.supporting && i === 1 && (
          <!-- Soporte analítico del Caso 2 -->
          <div class="mt-16 md:mt-20 max-w-3xl ml-auto">
            <img
              src={c.supporting}
              alt={c.supportingAlt}
              class="w-full h-auto block"
              style="box-shadow: 0 16px 40px -16px rgba(17,17,17,0.12);"
              loading="lazy"
            />
          </div>
        )}
      </div>
    </section>
  ))}

</Layout>
