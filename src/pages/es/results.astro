---
import Layout from '../../layouts/Layout.astro';

const cases = [
  {
    label: 'Caso 01 — Creador masculino',
    subhead: 'Caso de monetización OnlyFans — creador masculino escalado a 5 cifras',
    headline: 'El tráfico alto por sí solo no se traducía en ingresos.',
    paragraphs: [
      'Este creador masculino ya generaba visibilidad fuerte y tráfico constante, pero la monetización por suscriptor seguía por debajo de su potencial.',
      'Tras reestructurar los flujos de chatting, los sistemas de retención y estrategias de monetización de mayor valor, el gasto por fan y el LTV total aumentaron significativamente — llevando a meses consistentes de 5 cifras pese a una base de suscriptores más pequeña.',
    ],
    image: '/assets/results/growth-monthly.jpeg',
    imageAlt: 'Ingresos mensuales escalando a cinco cifras — +1.034% de crecimiento',
    layout: 'text-left',
    theme: 'cream',
  },
  {
    label: 'Caso 02 — Creadora lifestyle',
    subhead: 'Caso de estabilidad de ingresos — creadora lifestyle en OnlyFans',
    headline: 'Los ingresos se volvieron más estables una vez que el backend se estructuró bien.',
    paragraphs: [
      'Esta creadora ya tenía fans activos y tráfico regular, pero los ingresos eran inconsistentes mes a mes por una retención y unos sistemas de monetización débiles detrás de la página.',
      'Tras mejorar la estructura del chatting, los sistemas de retención y la experiencia general del fan, la longevidad de los suscriptores y el LTV aumentaron significativamente — haciendo los ingresos mucho más estables y predecibles con el tiempo.',
    ],
    image: '/assets/results/results-grid1.jpeg',
    imageAlt: 'Ingresos mensuales estabilizados — creadora lifestyle',
    layout: 'image-left',
    theme: 'dark',
  },
  {
    label: 'Caso 03 — Creadora con tatuajes',
    subhead: 'Optimización de monetización OnlyFans — creadora con tatuajes',
    headline: 'La mayor parte del potencial de ingresos se estaba dejando sobre la mesa.',
    paragraphs: [
      'La página ya tenía suscriptores activos y tráfico fuerte, pero la monetización detrás de la cuenta carecía de estructura y consistencia.',
      'Mejorando la ejecución de upsells, los sistemas de chatting y los flujos de retención, el gasto total del fan y el LTV del cliente aumentaron sustancialmente — generando un rendimiento mensual más fuerte sin depender únicamente de tráfico nuevo.',
    ],
    image: '/assets/results/statement-july.jpeg',
    imageAlt: 'Extracto mensual de OnlyFans — mes de cinco cifras, top 1,2% de creadores',
    layout: 'text-left',
    theme: 'cream',
  },
  {
    label: 'Caso 04 — Creadora fitness',
    subhead: 'Subida de ingresos diarios — creadora fitness en OnlyFans',
    headline: 'Una mejor monetización creó ingresos diarios más fuertes detrás del mismo tráfico.',
    paragraphs: [
      'En lugar de depender solo del volumen de suscriptores, el foco pasó a la retención de fans, la estructura de monetización y un comportamiento de gasto de mayor valor.',
      'Esto creó un rendimiento diario de ingresos significativamente más fuerte, un LTV mayor y una monetización más rentable detrás de la misma audiencia.',
    ],
    image: '/assets/results/results-grid3-v2.jpeg',
    imageAlt: 'Subida de ingresos diarios — creadora fitness',
    layout: 'image-left',
    theme: 'dark',
  },
];

const finalCase = {
  label: 'Caso 05 — Creadora lifestyle',
  subhead: 'Ingresos OnlyFans en un solo día — qué producen los sistemas backend correctos',
  headline: 'Incluso un solo día puede verse completamente diferente con los sistemas backend correctos.',
  paragraphs: [
    'La diferencia no estaba en el volumen de tráfico — estaba en la ejecución de la monetización detrás de la página.',
    'A través de sistemas de chatting más fuertes, estructura de retención y flujos de conversión de fans, el gasto total por fan y el LTV aumentaron significativamente, llevando a picos de ingresos diarios más fuertes y un rendimiento a largo plazo más rentable.',
  ],
  image: '/assets/results/daily-performance-block1.jpeg',
  imageAlt: 'Prueba de un solo día con ingresos superiores a $2k',
};
---

<Layout title="Casos y Resultados OnlyFans | MANGO Agency" description="Resultados reales de creadoras OnlyFans gestionadas por MANGO — ingresos mensuales, métricas de crecimiento y casos de monetización estructurada." activeNav="results" lang="es" transparentTop={true}>

  <!-- 1. HERO (cinematic editorial atmosphere, oversized) -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden flex items-center hero-editorial-bg-alt grain">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full">
      <div class="flex flex-col items-start gap-7 md:gap-10 w-full max-w-4xl">
        <h1 class="font-display text-[44px] sm:text-7xl md:text-8xl lg:text-[140px] xl:text-[160px] text-white leading-[0.92] tracking-[-0.03em] text-left">Nuestros Resultados</h1>
        <p class="text-white/65 text-[15px] md:text-base lg:text-lg leading-relaxed max-w-3xl">Las creadoras que trabajan con nosotros suelen duplicar o triplicar sus ingresos en los primeros meses a trav&eacute;s de crecimiento estrat&eacute;gico en redes sociales, sistemas de monetizaci&oacute;n m&aacute;s s&oacute;lidos y soporte personalizado.</p>
      </div>
    </div>
  </section>

  <!-- 2-5. CASE STUDIES (alternating cream / dark, alternating layout) -->
  {cases.map((c, i) => {
    const isImageLeft = c.layout === 'image-left';
    const sectionClass = i % 2 === 0 ? 'section-cinematic' : 'section-panel';
    const imgBorder = '1px solid rgba(255,255,255,0.08)';
    const imgShadow = '0 30px 80px -25px rgba(186,154,110,0.16), 0 30px 60px -25px rgba(0,0,0,0.7)';
    return (
      <section class={`relative py-12 md:py-24 ${sectionClass} grain`}>
        <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-20 items-center">
            <div class={`flex flex-col gap-4 md:gap-6 lg:col-span-6 ${isImageLeft ? 'lg:order-2' : 'lg:order-1'}`}>
              <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style="font-family:Georgia,'Times New Roman',serif;">{c.label}</span>
              <h2 class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[0.98] tracking-[-0.02em]">{c.headline}</h2>
              <h3 class="text-white/55 text-[13px] md:text-sm uppercase tracking-[0.22em] font-medium max-w-lg">{c.subhead}</h3>
              <div class="flex flex-col gap-4 text-white/70 text-base md:text-lg leading-relaxed max-w-lg">
                {c.paragraphs.map(p => <p>{p}</p>)}
              </div>
            </div>
            <div class={`lg:col-span-6 ${isImageLeft ? 'lg:order-1' : 'lg:order-2'}`}>
              <picture>
                <source srcset={c.image.replace(/\.jpe?g$/, '.webp')} type="image/webp" />
                <img
                  src={c.image}
                  alt={c.imageAlt}
                  class="w-full h-auto block rounded-sm"
                  style={`box-shadow:${imgShadow}; border:${imgBorder};`}
                  loading="lazy"
                />
              </picture>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <!-- 6. CASE 05 (centered editorial proof, cinematic, borderless image) -->
  <section class="relative py-12 md:py-24 section-cinematic grain">
    <div class="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 flex flex-col items-center text-center gap-8 md:gap-10">
      <div class="flex flex-col gap-4 md:gap-6 items-center">
        <span class="text-[11px] uppercase tracking-[0.32em] italic text-white/45" style="font-family:Georgia,'Times New Roman',serif;">{finalCase.label}</span>
        <h2 class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[0.98] tracking-[-0.02em] max-w-2xl">{finalCase.headline}</h2>
        <h3 class="text-white/55 text-[13px] md:text-sm uppercase tracking-[0.22em] font-medium max-w-xl">{finalCase.subhead}</h3>
        <div class="flex flex-col gap-4 text-white/70 text-base md:text-lg leading-relaxed max-w-xl">
          {finalCase.paragraphs.map(p => <p>{p}</p>)}
        </div>
      </div>
      <div class="w-full max-w-2xl mt-2 md:mt-4">
        <picture>
          <source srcset={finalCase.image.replace(/\.jpe?g$/, '.webp')} type="image/webp" />
          <img
            src={finalCase.image}
            alt={finalCase.imageAlt}
            class="w-full h-auto block rounded-sm"
            style="box-shadow:0 30px 80px -25px rgba(186,154,110,0.16), 0 30px 60px -25px rgba(0,0,0,0.7);"
            loading="lazy"
          />
        </picture>
      </div>
    </div>
  </section>

</Layout>
