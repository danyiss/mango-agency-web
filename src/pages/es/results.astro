---
import Layout from '../../layouts/Layout.astro';

const slides = [
  {
    value: '$24,586',
    unit: '/mes',
    text: 'Esta cuenta ya publicaba de forma constante pero no convertía. Implementamos chatting estructurado, upsells y sistemas de retención — y los ingresos se compusieron desde ahí.',
    img: '/assets/results/main-feature-block.jpeg',
  },
  {
    value: '$19,025',
    unit: '/mes',
    text: 'Impulsado por sistemas de chatting optimizados y mejor monetización.',
    img: '/assets/results/results-grid1.jpeg',
  },
  {
    value: '$13,098',
    unit: '/mes',
    text: 'Crecimiento alineando la estrategia de contenido con los sistemas de conversión.',
    img: '/assets/results/results-grid2.jpeg',
  },
  {
    value: '+558%',
    unit: 'crecimiento',
    text: 'De ingresos inconsistentes a ingresos estructurados y predecibles.',
    img: '/assets/results/results-grid3-v2.jpeg',
  },
];
---

<Layout title="Resultados | MANGO Agency" activeNav="results" lang="es" transparentTop={true}>

  <!-- 1. HERO -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/hero-results.webp');"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-black/55 via-black/30 to-black/10"></div>
    <div class="absolute inset-0 flex items-center">
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
        <div class="max-w-[640px] flex flex-col gap-7">
          <h1 class="font-display text-5xl sm:text-6xl md:text-7xl text-white leading-[1.05]">
            Resultados por sistemas <span class="text-white/65">&mdash; no por suerte.</span>
          </h1>
          <p class="text-white/85 text-lg md:text-xl leading-relaxed font-body max-w-lg">
            Ingresos predecibles, construidos sobre sistemas. Ni viralidad. Ni suerte. Solo sistemas estructurados.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PREMIUM CASE STUDY SLIDER -->
  <section class="py-28 md:py-40 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-14 md:mb-20 text-center">
      <h2 class="font-display text-4xl md:text-6xl text-on-surface leading-[1.05]">Casos seleccionados.</h2>
    </div>

    <div class="relative" data-slider>
      <!-- Prev arrow -->
      <button data-slider-prev
        class="hidden md:flex absolute left-4 lg:left-10 top-1/2 -translate-y-1/2 z-20 w-12 h-12 lg:w-14 lg:h-14 items-center justify-center bg-white hover:bg-on-surface text-on-surface hover:text-white rounded-full border border-on-surface/15 transition-all duration-300"
        style="box-shadow: 0 8px 24px -8px rgba(17,17,17,0.18);"
        aria-label="Caso anterior">
        <span class="material-symbols-outlined" style="font-size:26px;">chevron_left</span>
      </button>

      <!-- Track -->
      <div class="results-slider-track flex overflow-x-auto snap-x snap-mandatory scroll-smooth">
        {slides.map((slide, idx) => (
          <article class="flex-none w-full snap-center px-6 md:px-12 lg:px-20" role="group" aria-roledescription="slide" aria-label={`Caso ${idx + 1} de ${slides.length}`}>
            <div class="max-w-5xl mx-auto flex flex-col gap-10 md:gap-14 items-center">
              <!-- Top: oversized metric + short text -->
              <div class="text-center flex flex-col gap-5">
                <div class="flex items-baseline gap-3 justify-center flex-nowrap whitespace-nowrap">
                  <span class="font-display text-7xl md:text-9xl text-on-surface leading-none tracking-tight">{slide.value}</span>
                  <span class="font-body text-xl md:text-2xl text-on-surface-variant">{slide.unit}</span>
                </div>
                <p class="text-on-surface-variant text-base md:text-lg max-w-2xl mx-auto leading-relaxed">{slide.text}</p>
              </div>
              <!-- Screenshot dominant -->
              <div class="w-full p-3 md:p-5 bg-surface-container-low" style="box-shadow: 0 24px 60px -24px rgba(17,17,17,0.18);">
                <img src={slide.img} alt={slide.value} class="w-full h-auto block" loading="lazy" />
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Next arrow -->
      <button data-slider-next
        class="hidden md:flex absolute right-4 lg:right-10 top-1/2 -translate-y-1/2 z-20 w-12 h-12 lg:w-14 lg:h-14 items-center justify-center bg-white hover:bg-on-surface text-on-surface hover:text-white rounded-full border border-on-surface/15 transition-all duration-300"
        style="box-shadow: 0 8px 24px -8px rgba(17,17,17,0.18);"
        aria-label="Caso siguiente">
        <span class="material-symbols-outlined" style="font-size:26px;">chevron_right</span>
      </button>
    </div>
  </section>

  <!-- 3. PREDICTABLE REVENUE (single screenshot, centered) -->
  <section class="py-32 md:py-44 bg-white">
    <div class="max-w-5xl mx-auto px-6 lg:px-8 flex flex-col gap-16 md:gap-20 items-center text-center">
      <div class="flex flex-col gap-5">
        <h2 class="font-display text-5xl md:text-7xl text-on-surface leading-[1.05]">Ingresos predecibles. Construidos sobre sistemas.</h2>
        <p class="text-on-surface-variant text-lg md:text-xl max-w-2xl mx-auto leading-relaxed">Rendimiento consistente impulsado por monetizaci&oacute;n estructurada.</p>
      </div>
      <div class="w-full max-w-4xl p-3 md:p-5 bg-surface-container-low" style="box-shadow: 0 24px 60px -24px rgba(17,17,17,0.18);">
        <img src="/assets/results/daily-performance-block1.jpeg" alt="Rendimiento consistente de ingresos" class="w-full h-auto block" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- 4. FINAL CTA "Mango te sienta bien." -->
  <section class="py-32 md:py-44 bg-white">
    <div class="max-w-2xl mx-auto px-6 lg:px-8 text-center flex flex-col gap-8 items-center">
      <h2 class="font-display text-5xl md:text-7xl text-on-surface leading-[1.05]">Mango te sienta bien.</h2>
      <p class="text-on-surface-variant text-lg md:text-xl leading-relaxed">&iquest;Lista para tu siguiente nivel?</p>
      <div class="mt-2">
        <a href="/es/#apply" class="inline-block bg-accent text-black font-bold px-9 py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">
          Aplicar para trabajar con nosotros
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  .results-slider-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .results-slider-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  (function(){
    const slider = document.querySelector('[data-slider]');
    if (!slider) return;
    const track = slider.querySelector('.results-slider-track');
    const prev = slider.querySelector('[data-slider-prev]');
    const next = slider.querySelector('[data-slider-next]');
    if (!track) return;
    function scrollByOne(direction) {
      const w = track.clientWidth;
      track.scrollBy({ left: direction * w, behavior: 'smooth' });
    }
    prev && prev.addEventListener('click', () => scrollByOne(-1));
    next && next.addEventListener('click', () => scrollByOne(1));
  })();
</script>
