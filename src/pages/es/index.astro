---
import Layout from '../../layouts/Layout.astro';
import ApplyForm from '../../components/ApplyForm.astro';
import { useTranslations } from '../../i18n/translations';

const t = useTranslations('es');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": t('home.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a1') }},
    { "@type": "Question", "name": t('home.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a2') }},
    { "@type": "Question", "name": t('home.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a3') }},
    { "@type": "Question", "name": t('home.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a4') }},
    { "@type": "Question", "name": t('home.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a5') }},
    { "@type": "Question", "name": t('home.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a6') }},
    { "@type": "Question", "name": t('home.faq.q7'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a7') }},
    { "@type": "Question", "name": t('home.faq.q8'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a8') }},
    { "@type": "Question", "name": t('home.faq.q9'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a9') }},
    { "@type": "Question", "name": t('home.faq.q10'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a10') }},
    { "@type": "Question", "name": t('home.faq.q11'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a11') }},
    { "@type": "Question", "name": t('home.faq.q12'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a12') }},
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Gestion OnlyFans",
  "provider": { "@type": "Organization", "name": "MANGO Agency" },
  "description": "Agencia de gestion de talento para creadoras de contenido. Operaciones de chatting, estrategia de marketing, generacion de trafico y optimizacion operativa.",
  "serviceType": "Agencia de Gestion de Talento",
  "areaServed": ["Europa", "Asia"],
};
---

<Layout title="MANGO | Agencia de Gestión OnlyFans para Creadoras" description="Agencia moderna de gestión de OnlyFans. Crecimiento, monetización y creator branding diseñados para escalar a creadoras de OnlyFans a largo plazo." activeNav="home" lang="es" transparentTop={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- 1. HERO — Unified full-bleed cinematic scene. Desktop: smooth left fade, no split. Mobile: distinct portrait crop. -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden">
    <!-- Full-bleed cinematic image — desktop -->
    <div class="absolute inset-0 bg-cover bg-no-repeat hidden md:block" style="background-image:url('/assets/hero-home-v4.jpg'); background-position: 62% center; background-size: cover; filter: brightness(0.92) contrast(1.06) saturate(1.04);"></div>
    <!-- Full-bleed cinematic image — mobile (tighter crop) -->
    <div class="absolute inset-0 bg-cover bg-no-repeat md:hidden" style="background-image:url('/assets/hero-mobile-v2.jpg'); background-position: 56% 62%; background-size: cover; filter: brightness(0.96) contrast(1.04) saturate(1.03);"></div>

    <!-- Desktop: soft left-to-transparent atmospheric fade — atmosphere stays visible behind text -->
    <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: linear-gradient(to right, rgba(5,5,5,0.72) 0%, rgba(5,5,5,0.55) 16%, rgba(5,5,5,0.34) 32%, rgba(5,5,5,0.16) 48%, rgba(5,5,5,0.05) 62%, transparent 75%);"></div>
    <!-- Desktop: magenta bleed from image into text zone -->
    <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: radial-gradient(ellipse 50% 60% at 30% 52%, rgba(168,52,92,0.12), transparent 70%), radial-gradient(ellipse 35% 45% at 12% 38%, rgba(132,38,62,0.08), transparent 65%);"></div>
    <!-- Desktop: vertical vignette -->
    <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: linear-gradient(to bottom, rgba(0,0,0,0.32) 0%, transparent 16%, transparent 76%, rgba(0,0,0,0.55) 100%);"></div>
    <!-- Desktop: full-frame vignette -->
    <div class="absolute inset-0 pointer-events-none hidden md:block" style="background: radial-gradient(ellipse 110% 100% at 55% 50%, transparent 60%, rgba(0,0,0,0.4));"></div>

    <!-- Mobile: top-left diagonal darkness — softer so atmosphere remains visible -->
    <div class="absolute inset-0 pointer-events-none md:hidden" style="background: linear-gradient(150deg, rgba(5,5,5,0.74) 0%, rgba(5,5,5,0.52) 22%, rgba(5,5,5,0.26) 44%, rgba(5,5,5,0.08) 62%, transparent 78%);"></div>
    <!-- Mobile: subtle top fade behind headline -->
    <div class="absolute inset-x-0 top-0 pointer-events-none md:hidden" style="height:50%; background: linear-gradient(to bottom, rgba(5,5,5,0.38) 0%, transparent);"></div>
    <!-- Mobile: bottom soft vignette -->
    <div class="absolute inset-x-0 bottom-0 pointer-events-none md:hidden" style="height:30%; background: linear-gradient(to top, rgba(0,0,0,0.5), transparent);"></div>

    <!-- Subtle grain -->
    <div class="grain absolute inset-0 pointer-events-none" style="opacity:0.55;"></div>

    <!-- CONTENT -->
    <div class="relative z-10 h-full max-w-7xl mx-auto px-6 lg:px-10 flex items-start md:items-center pt-28 md:pt-0">
      <div class="flex flex-col items-start gap-5 md:gap-9 md:w-[55%] max-w-[15ch] md:max-w-none">
        <h1 class="font-display text-[34px] sm:text-6xl md:text-6xl lg:text-7xl xl:text-[96px] text-white leading-[1.02] md:leading-[0.92] tracking-[-0.025em] text-left">
          <span class="md:hidden">Gesti&oacute;n<br />de OnlyFans<br /><span class="font-serif italic font-normal tracking-[-0.01em]">para creadoras</span><br />que quieren<br />m&aacute;s.</span>
          <span class="hidden md:inline">Gesti&oacute;n de OnlyFans<br />para creadoras que quieren m&aacute;s.</span>
        </h1>
        <p class="text-white/80 text-[14px] md:text-base lg:text-lg leading-relaxed font-body max-w-[22ch] sm:max-w-md text-left">
          Crecimiento, monetizaci&oacute;n y gesti&oacute;n construidos para escalar creadoras a largo plazo.
        </p>
        <a href="#apply" class="inline-block bg-accent text-black font-bold px-7 py-3.5 md:py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all">
          Aplicar para trabajar con nosotros
        </a>
        <p class="text-[10px] uppercase tracking-[0.3em] text-white/45 font-medium mt-1">Para creadoras, por creadoras.</p>
      </div>
    </div>
  </section>

  <!-- 1b. EDITORIAL METRICS — 4 horizontal cards (unified magenta/burgundy atmosphere) -->
  <section class="relative py-20 md:py-52 overflow-hidden">
    <div class="grain absolute inset-0 pointer-events-none"></div>
    <div class="atmosphere-glow magenta" style="top:-10%;right:-6%;width:520px;height:520px;opacity:0.5;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
        {[
          { metric: '24/7', size: 'text-7xl md:text-7xl lg:text-[5.5rem]', title: 'Monetización', text: 'Chatting nativo en inglés y español enfocado en retención y LTV a largo plazo.', glow: 'warm' },
          { metric: '5–6 Cifras', size: 'text-5xl md:text-5xl lg:text-[3.5rem]', title: 'Escalado Mensual', text: 'Crecimiento estructurado diseñado para escalar creadoras de $1k a múltiples 6 cifras.', glow: null },
          { metric: '+5B', size: 'text-5xl md:text-6xl lg:text-[4rem]', title: 'Visitas Generadas', text: 'Crecimiento en Instagram construido sobre viralidad, posicionamiento y creator branding.', glow: 'crimson' },
          { metric: '+30% LTV', size: 'text-5xl md:text-5xl lg:text-[3.25rem]', title: 'Mayor Valor del Fan', text: 'Chatting diseñado para aumentar el gasto del fan y la monetización a largo plazo.', glow: null },
        ].map(c => (
          <div
            class="relative rounded-2xl px-7 py-10 md:px-10 md:py-16 lg:px-11 lg:py-20 flex flex-col justify-between min-h-[240px] md:min-h-[420px] transition-all duration-300 hover:bg-white/[0.028] overflow-hidden"
            style="background-color:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);"
          >
            {c.glow === 'warm' && (
              <div class="absolute pointer-events-none" style="top:-20%;right:-25%;width:80%;height:75%;border-radius:9999px;background:radial-gradient(circle, rgba(214,183,122,0.16), transparent 70%);filter:blur(36px);"></div>
            )}
            {c.glow === 'crimson' && (
              <div class="absolute pointer-events-none" style="bottom:-25%;left:-25%;width:85%;height:80%;border-radius:9999px;background:radial-gradient(circle, rgba(184,42,72,0.18), transparent 70%);filter:blur(40px);"></div>
            )}

            <div class="relative z-10">
              <p class={`font-display ${c.size} text-white leading-[0.92] tracking-[-0.025em]`} style="text-wrap:balance;">{c.metric}</p>
            </div>

            <div class="relative z-10 flex flex-col gap-4 mt-10 md:mt-16">
              <p class="text-[13px] uppercase tracking-[0.21em] font-semibold" style="color:#c8a96a;">{c.title}</p>
              <p class="text-[13px] md:text-sm text-white/65 leading-[1.6] max-w-[26ch] font-normal">{c.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2a. REELS ECOSYSTEM (virality / attention / creator culture) -->
  <section class="relative py-20 md:py-52 overflow-hidden">
    <div class="grain absolute inset-0 pointer-events-none"></div>
    <div class="atmosphere-glow magenta" style="top:8%;right:-8%;width:560px;height:560px;"></div>
    <div class="atmosphere-glow crimson" style="bottom:-10%;left:-8%;width:480px;height:480px;"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 mb-12 md:mb-24">
      <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-white leading-[0.96] md:leading-[0.94] tracking-[-0.025em] max-w-4xl">Millones de visitas generadas org&aacute;nicamente con nuestras estrategias.</h2>
      <p class="mt-5 md:mt-9 text-white/60 text-sm md:text-lg leading-relaxed max-w-md">Crecimiento estrat&eacute;gico de Instagram construido sobre viralidad, posicionamiento y creator branding.</p>
    </div>

    <div class="relative z-10 flex flex-col gap-5 md:gap-6">
      {[
        { ids: [1, 2, 3, 4, 5, 6], reverse: false, opacity: 1 },
        { ids: [7, 8, 9, 10, 11, 12], reverse: true, opacity: 0.92 },
        { ids: [13, 14, 15, 16, 17, 18], reverse: false, opacity: 1 },
      ].map(row => (
        <div class="reels-marquee" style={`opacity:${row.opacity};`}>
          <div class={row.reverse ? 'reels-track reverse' : 'reels-track'}>
            {[...row.ids, ...row.ids, ...row.ids].map(n => (
              <div class="reel-card">
                <img src={`/assets/reels/${n}.jpg`} alt={`Reel de Instagram ${n}`} loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 2b. PAIN / PROBLEM (unified deep black + magenta/burgundy atmosphere) -->
  <section class="relative py-24 md:py-56 overflow-hidden grain">
    <div class="atmosphere-glow crimson" style="top:18%;right:-12%;width:520px;height:520px;opacity:0.35;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-4xl md:text-7xl lg:text-7xl xl:text-8xl text-white leading-[0.95] md:leading-[0.92] tracking-[-0.025em]">El crecimiento en OnlyFans ahora es un juego de sistemas.</h2>
          <p class="mt-8 md:mt-10 text-white/65 text-base md:text-lg leading-relaxed max-w-sm">Las creadoras que escalan m&aacute;s r&aacute;pido hoy tienen equipos profesionales detr&aacute;s.</p>
        </div>

        <div class="lg:col-span-7 flex flex-col">
          {[
            { title: 'El mal chatting mata el crecimiento de la página.', text: 'Ventas agresivas, conversaciones débiles y mala ejecución dañan poco a poco la retención, la confianza del fan y el gasto a largo plazo. Una monetización fuerte requiere estructura, formación y consistencia detrás de cada interacción.' },
            { title: 'Tener seguidores no siempre significa ganar dinero de verdad.', text: 'Muchas creadoras ya tienen visitas y seguidores — la diferencia real viene de la monetización detrás de la página. El crecimiento a largo plazo depende de la retención, el gasto del fan y la ejecución fuerte dentro de los DMs.' },
            { title: 'Muchas creadoras se sienten como una más dentro de su agencia.', text: 'Estrategias genéricas, equipos compartidos y mala comunicación acaban limitando el crecimiento a largo plazo. Un escalado serio requiere estrategia personalizada y soporte dedicado detrás de la página.' },
            { title: 'Sin sistemas reales ni control de calidad, el crecimiento se vuelve inconsistente.', text: 'Los meses fuertes se vuelven impredecibles, los ingresos fluctúan y escalar se hace difícil de sostener a largo plazo. La consistencia viene de la estructura, la ejecución y el soporte operativo.' },
            { title: 'La mayoría de creadoras no pueden escalar solas para siempre.', text: 'En algún punto, el contenido, los mensajes, la publicación y la monetización son demasiado para que una sola persona los gestione bien. El crecimiento real requiere el equipo adecuado detrás de la página.' },
          ].map((row, idx) => (
            <div class={`py-10 md:py-20 ${idx === 0 ? '' : 'border-t'}`} style="border-color:rgba(255,255,255,0.08);">
              <h3 class="font-display text-2xl md:text-4xl lg:text-5xl text-white leading-[1.0] md:leading-[0.98] tracking-[-0.015em] mb-4 md:mb-6">{row.title}</h3>
              <p class="text-white/65 text-[15px] md:text-base leading-relaxed max-w-lg">{row.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2c. RESULTS PREVIEW (clean cinematic, softer atmosphere) -->
  <section class="relative py-24 md:py-56 section-cinematic grain overflow-hidden">
    <div class="atmosphere-glow magenta" style="top:14%;right:-14%;width:480px;height:480px;opacity:0.35;"></div>
    <div class="atmosphere-glow crimson" style="bottom:10%;left:-14%;width:420px;height:420px;opacity:0.35;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <!-- Header -->
      <div class="mb-16 md:mb-40 max-w-4xl">
        <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-on-surface leading-[0.96] md:leading-[0.94] tracking-[-0.025em]">Casos de &eacute;xito</h2>
        <div class="mt-6 md:mt-10 flex flex-col gap-4 md:gap-5 max-w-xl">
          <p class="text-on-surface/72 text-sm md:text-lg leading-relaxed">En Mango, el crecimiento es mucho m&aacute;s que vistas.</p>
          <p class="text-on-surface/65 text-sm md:text-lg leading-relaxed">Combinamos branding de creadora, posicionamiento en redes sociales y sistemas de monetizaci&oacute;n dise&ntilde;ados para convertir la atenci&oacute;n en ingresos sostenibles.</p>
          <p class="text-on-surface/65 text-sm md:text-lg leading-relaxed">Cada estrategia se construye alrededor de la creadora &mdash; su imagen, audiencia, posicionamiento y potencial de conversi&oacute;n.</p>
          <p class="text-on-surface/65 text-sm md:text-lg leading-relaxed">Del alcance viral a la retenci&oacute;n de fans, todo est&aacute; estructurado para construir negocios de creadora escalables y rentables.</p>
        </div>
      </div>

      <!-- Case 1 — MONETIZACIÓN (text left / screenshot right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-20 items-center mb-20 md:mb-44">
        <div class="lg:col-span-5 flex flex-col gap-4 md:gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Monetizaci&oacute;n</span>
          <p class="font-display text-2xl md:text-4xl lg:text-5xl text-on-surface leading-[1.05] md:leading-[1.0] tracking-[-0.015em]">$24,586/mes generados en 30 d&iacute;as</p>
          <p class="text-on-surface/65 text-sm md:text-base leading-relaxed max-w-sm">A trav&eacute;s de estrategias de chatting enfocadas en aumentar el gasto de los fans, la retenci&oacute;n y la monetizaci&oacute;n a largo plazo.</p>
          <a href="/es/results" class="group inline-flex items-baseline gap-3 text-on-surface font-display text-lg md:text-xl tracking-[-0.01em] hover:gap-5 transition-all duration-300 mt-2">
            Ver resultados completos
            <span class="text-on-surface/55 group-hover:text-on-surface transition-colors">&rarr;</span>
          </a>
        </div>
        <div class="lg:col-span-7">
          <img src="/assets/results/monetization.jpeg" alt="Screenshot de ingresos mensuales — $24,586 en 30 d&iacute;as" class="w-full h-auto block rounded-sm" style="box-shadow: 0 30px 80px -25px rgba(186,154,110,0.16), 0 30px 60px -25px rgba(0,0,0,0.7); border:1px solid rgba(255,255,255,0.08);" loading="lazy" />
        </div>
      </div>

      <!-- Case 2 — CRECIMIENTO EN REDES SOCIALES (screenshot left / text right, image at 85%) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-20 items-center mb-16 md:mb-40">
        <div class="lg:col-span-7 lg:order-1">
          <img src="/assets/results/growth.jpeg" alt="Anal&iacute;ticas de Instagram — +53k seguidores nuevos en 30 d&iacute;as" class="w-full h-auto block rounded-sm lg:max-w-[85%] lg:ml-auto" style="box-shadow: 0 30px 80px -25px rgba(186,154,110,0.16), 0 30px 60px -25px rgba(0,0,0,0.7); border:1px solid rgba(255,255,255,0.08);" loading="lazy" />
        </div>
        <div class="lg:col-span-5 lg:order-2 flex flex-col gap-4 md:gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Crecimiento en Redes</span>
          <p class="font-display text-2xl md:text-4xl lg:text-5xl text-on-surface leading-[1.05] md:leading-[1.0] tracking-[-0.015em]">+53k seguidores nuevos generados en 30 d&iacute;as</p>
          <p class="text-on-surface/65 text-sm md:text-base leading-relaxed max-w-sm">A trav&eacute;s de posicionamiento de creadora, sistemas de contenido viral y crecimiento estrat&eacute;gico de audiencia.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SYSTEMS BEHIND THE REVENUE (panel, sticky header + staggered systems) -->
  <section class="relative py-24 md:py-56 section-panel grain overflow-hidden">
    <div class="atmosphere-glow magenta" style="top:-8%;left:30%;width:560px;height:560px;opacity:0.35;"></div>
    <div class="atmosphere-glow crimson" style="bottom:10%;right:-10%;width:480px;height:480px;opacity:0.4;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-24">
        <!-- Sticky headline column -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-4xl md:text-7xl lg:text-7xl xl:text-8xl text-white leading-[0.96] md:leading-[0.92] tracking-[-0.025em]">Los sistemas detr&aacute;s de los ingresos.</h2>
        </div>

        <!-- Systems stacked right -->
        <div class="lg:col-span-7 flex flex-col gap-16 md:gap-32">
          {[
            { num: '01', title: 'Chatting y Monetización', text: 'Nuestro equipo interno de chatting se centra en retención, relaciones con fans y gasto a largo plazo — construyendo una monetización más fuerte detrás de la página, no solo ventas a corto plazo.' },
            { num: '02', title: 'Sistemas de Crecimiento', text: 'Sistemas multiplataforma de crecimiento que combinan Instagram, estrategia de contenido viral y fuentes de tráfico externo, diseñados para traer fans nuevos al ecosistema de forma constante.' },
            { num: '03', title: 'Protección e Infraestructura', text: 'Protección frente a filtraciones, soporte DMCA y seguridad de cuenta diseñados para que las creadoras escalen con confianza sin perder el control de su contenido.' },
          ].map(s => (
            <div class="flex flex-col gap-6">
              <h3 class="font-display text-3xl md:text-5xl lg:text-6xl text-white leading-[1.05] md:leading-[1.0] tracking-[-0.02em]">{s.title}</h3>
              <p class="text-white/65 text-base md:text-lg leading-relaxed max-w-lg">{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. HOW IT WORKS (dark panel, oversized step numbers) -->
  <section class="relative py-24 md:py-56 section-panel grain overflow-hidden">
    <div class="atmosphere-glow magenta" style="top:20%;right:-12%;width:480px;height:480px;opacity:0.35;"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-16 md:mb-40 max-w-4xl">
        <h2 class="font-display text-4xl md:text-7xl lg:text-8xl text-on-surface leading-[0.96] md:leading-[0.94] tracking-[-0.025em]">C&oacute;mo funciona.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-12 lg:gap-16">
        {[
          { num: '01', title: 'Aplicar', text: 'Aplicación breve para entender tu perfil, contenido y etapa actual.' },
          { num: '02', title: 'Auditoría', text: 'Revisamos tu página, posicionamiento, tráfico y estructura de monetización.' },
          { num: '03', title: 'Setup del Sistema', text: 'Construimos sistemas de crecimiento, chatting y monetización alrededor de tu página.' },
          { num: '04', title: 'Escalar y Optimizar', text: 'Optimización continua enfocada en crecimiento, retención e ingresos a largo plazo.' },
        ].map(step => (
          <div class="flex flex-col gap-6">
            <span class="font-display text-5xl md:text-7xl lg:text-8xl text-white/18 leading-[0.85] tracking-[-0.02em]">{step.num}</span>
