---
import Layout from '../../layouts/Layout.astro';
import ApplyForm from '../../components/ApplyForm.astro';
import { useTranslations } from '../../i18n/translations';

const t = useTranslations('es');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": t('home.faq.q1'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a1') }},
    { "@type": "Question", "name": t('home.faq.q2'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a2') }},
    { "@type": "Question", "name": t('home.faq.q3'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a3') }},
    { "@type": "Question", "name": t('home.faq.q4'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a4') }},
    { "@type": "Question", "name": t('home.faq.q5'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a5') }},
    { "@type": "Question", "name": t('home.faq.q6'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a6') }},
    { "@type": "Question", "name": t('home.faq.q7'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a7') }},
    { "@type": "Question", "name": t('home.faq.q8'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a8') }},
    { "@type": "Question", "name": t('home.faq.q9'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a9') }},
    { "@type": "Question", "name": t('home.faq.q10'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a10') }},
    { "@type": "Question", "name": t('home.faq.q11'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a11') }},
    { "@type": "Question", "name": t('home.faq.q12'), "acceptedAnswer": { "@type": "Answer", "text": t('home.faq.a12') }},
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Gestion OnlyFans",
  "provider": { "@type": "Organization", "name": "MANGO Agency" },
  "description": "Agencia de gestion de talento para creadoras de contenido. Operaciones de chatting, estrategia de marketing, generacion de trafico y optimizacion operativa.",
  "serviceType": "Agencia de Gestion de Talento",
  "areaServed": ["Europa", "Asia"],
};
---

<Layout title="MANGO | Agencia de Gestión OnlyFans para Creadoras" description="Agencia moderna de gestión de OnlyFans. Crecimiento, monetización y creator branding diseñados para escalar a creadoras de OnlyFans a largo plazo." activeNav="home" lang="es" transparentTop={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <!-- 1. HERO (minimal black editorial, asymmetric, oversized) -->
  <section class="relative h-screen -mt-16 w-full overflow-hidden" style="background-color:#111111;">
    <div class="absolute inset-0 flex items-center">
      <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-10 w-full">
        <div class="flex flex-col items-start gap-10 md:gap-14 max-w-[20ch]">
          <h1 class="font-display text-[40px] sm:text-6xl md:text-7xl lg:text-8xl xl:text-[120px] text-white leading-[0.92] tracking-[-0.025em] text-left">
            Gesti&oacute;n de OnlyFans<br />para creadoras que quieren m&aacute;s.
          </h1>
          <p class="text-white/65 text-[15px] md:text-base lg:text-lg leading-relaxed font-body max-w-md text-left">
            Crecimiento, monetizaci&oacute;n y gesti&oacute;n construidos para escalar creadoras a largo plazo.
          </p>
          <p class="text-[10px] uppercase tracking-[0.3em] text-white/35 font-medium mt-1 md:mt-2">Para creadoras, por creadoras.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 1b. AUTHORITY STRIP (thin editorial, off-white) -->
  <section class="py-32 md:py-44" style="background-color:#f7f3ee;">
    <div class="max-w-6xl mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-y-6 md:gap-x-8 lg:gap-x-12 text-center md:text-left">
        {[
          'Enfocados en el crecimiento a largo plazo.',
          'Millones de visitas generadas.',
          'Detrás de creadoras de alto rendimiento.',
          'Basado en sistemas, no en suposiciones.',
        ].map(line => (
          <p class="text-[13px] md:text-sm text-on-surface/70 font-medium leading-relaxed tracking-tight">{line}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- 2b. PAIN / PROBLEM (warm beige, sticky-header magazine) -->
  <section class="py-36 md:py-56" style="background-color:#D8C8B8;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
        <!-- Sticky headline column -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-5xl md:text-7xl lg:text-7xl xl:text-8xl text-on-surface leading-[0.92] tracking-[-0.025em]">El crecimiento en OnlyFans ahora es un juego de sistemas.</h2>
          <p class="mt-8 md:mt-10 text-on-surface/65 text-base md:text-lg leading-relaxed max-w-sm">Las creadoras que escalan m&aacute;s r&aacute;pido hoy tienen equipos profesionales detr&aacute;s.</p>
        </div>

        <!-- Pain points column -->
        <div class="lg:col-span-7 flex flex-col">
          {[
            { title: 'El mal chatting mata el crecimiento de la página.', text: 'Ventas agresivas, conversaciones débiles y mala ejecución dañan poco a poco la retención, la confianza del fan y el gasto a largo plazo. Una monetización fuerte requiere estructura, formación y consistencia detrás de cada interacción.' },
            { title: 'Tener seguidores no siempre significa ganar dinero de verdad.', text: 'Muchas creadoras ya tienen visitas y seguidores — la diferencia real viene de la monetización detrás de la página. El crecimiento a largo plazo depende de la retención, el gasto del fan y la ejecución fuerte dentro de los DMs.' },
            { title: 'Muchas creadoras se sienten como una más dentro de su agencia.', text: 'Estrategias genéricas, equipos compartidos y mala comunicación acaban limitando el crecimiento a largo plazo. Un escalado serio requiere estrategia personalizada y soporte dedicado detrás de la página.' },
            { title: 'Sin sistemas reales ni control de calidad, el crecimiento se vuelve inconsistente.', text: 'Los meses fuertes se vuelven impredecibles, los ingresos fluctúan y escalar se hace difícil de sostener a largo plazo. La consistencia viene de la estructura, la ejecución y el soporte operativo.' },
            { title: 'La mayoría de creadoras no pueden escalar solas para siempre.', text: 'En algún punto, el contenido, los mensajes, la publicación y la monetización son demasiado para que una sola persona los gestione bien. El crecimiento real requiere el equipo adecuado detrás de la página.' },
          ].map((row, idx) => (
            <div class={`py-14 md:py-20 ${idx === 0 ? '' : 'border-t'}`} style="border-color:rgba(17,17,17,0.22);">
              <h3 class="font-display text-3xl md:text-4xl lg:text-5xl text-on-surface leading-[0.98] tracking-[-0.015em] mb-5 md:mb-6">{row.title}</h3>
              <p class="text-on-surface/65 text-[15px] md:text-base leading-relaxed max-w-lg">{row.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2c. RESULTS PREVIEW (off-white, alternating case-study spreads) -->
  <section class="py-36 md:py-56 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <!-- Header -->
      <div class="mb-28 md:mb-40 max-w-4xl">
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-on-surface leading-[0.94] tracking-[-0.025em]">Resultados construidos sobre sistemas.</h2>
        <p class="mt-7 md:mt-9 text-on-surface/65 text-base md:text-lg leading-relaxed max-w-md">El crecimiento solo vale cuando la monetizaci&oacute;n escala detr&aacute;s.</p>
      </div>

      <!-- Case 1: text left / screenshot right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center mb-32 md:mb-44">
        <div class="lg:col-span-5 flex flex-col gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Crecimiento</span>
          <p class="font-display text-3xl md:text-4xl lg:text-5xl text-on-surface leading-[1.0] tracking-[-0.015em]">+53k seguidores generados en 30 d&iacute;as.</p>
        </div>
        <div class="lg:col-span-7">
          <img src="/assets/results/growth.jpeg" alt="Anal&iacute;ticas de Instagram — +53k seguidores en 30 d&iacute;as" class="w-full h-auto block" style="box-shadow: 0 24px 60px -24px rgba(17,17,17,0.15);" loading="lazy" />
        </div>
      </div>

      <!-- Case 2: screenshot left / text right -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center mb-32 md:mb-40">
        <div class="lg:col-span-7 lg:order-1">
          <img src="/assets/results/monetization.jpeg" alt="Screenshot de ingresos mensuales — $24,586" class="w-full h-auto block" style="box-shadow: 0 24px 60px -24px rgba(17,17,17,0.15);" loading="lazy" />
        </div>
        <div class="lg:col-span-5 lg:order-2 flex flex-col gap-6">
          <span class="text-[11px] uppercase tracking-[0.3em] text-on-surface/45 font-medium">Monetizaci&oacute;n</span>
          <p class="font-display text-3xl md:text-4xl lg:text-5xl text-on-surface leading-[1.0] tracking-[-0.015em]">$24,586/mes.</p>
        </div>
      </div>

      <!-- Editorial CTA link -->
      <div class="flex justify-start lg:justify-end">
        <a href="/es/results" class="group inline-flex items-baseline gap-4 text-on-surface font-display text-2xl md:text-3xl tracking-[-0.01em] hover:gap-6 transition-all duration-300">
          Ver resultados completos
          <span class="text-on-surface/55 group-hover:text-on-surface transition-colors">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. SYSTEMS BEHIND THE REVENUE (BLACK, sticky header + staggered systems) -->
  <section class="py-36 md:py-56" style="background-color:#111111;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
        <!-- Sticky headline column -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
          <h2 class="font-display text-5xl md:text-7xl lg:text-7xl xl:text-8xl text-white leading-[0.92] tracking-[-0.025em]">Los sistemas detr&aacute;s de los ingresos.</h2>
        </div>

        <!-- Systems stacked right -->
        <div class="lg:col-span-7 flex flex-col gap-24 md:gap-32">
          {[
            { num: '01', title: 'Chatting y Monetización', text: 'Nuestro equipo interno de chatting se centra en retención, relaciones con fans y gasto a largo plazo — construyendo una monetización más fuerte detrás de la página, no solo ventas a corto plazo.' },
            { num: '02', title: 'Sistemas de Crecimiento', text: 'Sistemas multiplataforma de crecimiento que combinan Instagram, estrategia de contenido viral y fuentes de tráfico externo, diseñados para traer fans nuevos al ecosistema de forma constante.' },
            { num: '03', title: 'Protección e Infraestructura', text: 'Protección frente a filtraciones, soporte DMCA y seguridad de cuenta diseñados para que las creadoras escalen con confianza sin perder el control de su contenido.' },
          ].map(s => (
            <div class="flex flex-col gap-6">
              <span class="text-[11px] uppercase tracking-[0.3em] text-white/40 font-medium">{s.num}</span>
              <h3 class="font-display text-4xl md:text-5xl lg:text-6xl text-white leading-[1.0] tracking-[-0.02em]">{s.title}</h3>
              <p class="text-white/65 text-base md:text-lg leading-relaxed max-w-lg">{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. HOW IT WORKS (off-white, oversized step numbers) -->
  <section class="py-36 md:py-56" style="background-color:#f7f3ee;">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">
      <div class="mb-28 md:mb-40 max-w-4xl">
        <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-on-surface leading-[0.94] tracking-[-0.025em]">C&oacute;mo funciona.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 md:gap-12 lg:gap-16">
        {[
          { num: '01', title: 'Aplicar', text: 'Aplicación breve para entender tu perfil, contenido y etapa actual.' },
          { num: '02', title: 'Auditoría', text: 'Revisamos tu página, posicionamiento, tráfico y estructura de monetización.' },
          { num: '03', title: 'Setup del Sistema', text: 'Construimos sistemas de crecimiento, chatting y monetización alrededor de tu página.' },
          { num: '04', title: 'Escalar y Optimizar', text: 'Optimización continua enfocada en crecimiento, retención e ingresos a largo plazo.' },
        ].map(step => (
          <div class="flex flex-col gap-6">
            <span class="font-display text-6xl md:text-7xl lg:text-8xl text-on-surface/22 leading-[0.85] tracking-[-0.02em]">{step.num}</span>
            <h3 class="font-display text-2xl md:text-3xl text-on-surface leading-[1.05] tracking-[-0.015em]">{step.title}</h3>
            <p class="text-on-surface/65 text-base leading-relaxed max-w-xs">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. APPLY -->
  <ApplyForm lang="es" />

  <!-- 7. FAQ (white) -->
  <section class="py-32 md:py-40 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <div class="mb-20 md:mb-28">
        <h2 class="font-display text-5xl md:text-7xl text-on-surface leading-[0.96] tracking-[-0.025em]">Preguntas frecuentes.</h2>
      </div>
      <div class="flex flex-col">
        {[
          {
            q: "¿Qué os diferencia de otras agencias?",
            a: `<p>La mayoría de agencias se basan en volumen — más contenido, más publicaciones, más mensajes.</p><p>Nosotros nos enfocamos en rendimiento.</p><p>Combinamos:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>Un equipo de marketing enfocado en generar tráfico consistente</li><li>Un equipo de chatting dedicado por modelo (no compartido entre cuentas)</li><li>Sistemas de ventas estructurados (dripping, upsells, retención)</li><li>Optimización semanal basada en datos reales de rendimiento (ingresos, conversión, LTV)</li></ul><p>No trabajamos con todo el mundo. Seleccionamos a las creadoras adecuadas y nos centramos en escalarlas correctamente.</p>`,
          },
          {
            q: "¿Por qué debería trabajar con una agencia?",
            a: `<p>Porque la mayoría de creadoras dejan dinero en la mesa — por ambos lados.</p><p>Tráfico sin monetización no escala.<br />Monetización sin tráfico no crece.</p><p>Nosotros nos encargamos de ambas.</p><p>El marketing trae tráfico consistente.<br />El chatting convierte ese tráfico en ingresos.</p><p>Para que puedas centrarte en el contenido mientras todo lo que hay detrás se optimiza.</p>`,
          },
          {
            q: "¿Cuánto puedo esperar crecer?",
            a: `<p>Depende de tu punto de partida.</p><p>La mayoría de creadoras con las que trabajamos ven:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>Mayor ingreso por suscriptor</li><li>Mejor conversión de fans a compradores</li><li>Ingresos diarios más consistentes</li></ul><p>En muchos casos, las creadoras pasan de ingresos inestables a ingresos mensuales predecibles mejorando tanto el tráfico como la monetización.</p>`,
          },
          {
            q: "¿Es seguro dar acceso a mi cuenta?",
            a: `<p>Sí.</p><p>Solo necesitamos tus credenciales una vez para conectar de forma segura tu cuenta a nuestro CRM.</p><p>Después, nuestro equipo trabaja a través de la plataforma sin necesitar acceso directo a tus datos de inicio de sesión.</p><p>Tu cuenta permanece protegida y tú mantienes el control total en todo momento.</p>`,
          },
          {
            q: "¿Vais a cambiar mi personalidad o cómo interactúo con los fans?",
            a: `<p>No.</p><p>Nos adaptamos a tu personalidad — no al revés.</p><p>Antes de empezar, recopilamos información detallada sobre tu tono, preferencias y límites para replicar tu estilo con la mayor precisión posible.</p>`,
          },
          {
            q: "¿Ayudáis con la creación de contenido?",
            a: `<p>Sí.</p><p>Proporcionamos estrategias de contenido claras, referencias y dirección basadas en lo que mejor funciona.</p><p>No tienes que adivinar qué publicar — te guiamos sobre lo que realmente convierte.</p>`,
          },
          {
            q: "¿Cómo funciona el proceso?",
            a: `<p>Aplica &rarr; Llamada de evaluación &rarr; Setup del sistema &rarr; Lanzamiento y optimización</p><p>Una vez alineado todo, podemos empezar rápidamente y mejorar tus ingresos desde el primer día.</p>`,
          },
          {
            q: "¿Mantengo el control de mi cuenta?",
            a: `<p>Siempre.</p><p>Mantienes la propiedad, visibilidad y control total en todo momento.</p>`,
          },
          {
            q: "¿Cómo mantenéis la calidad del chatting?",
            a: `<p>Usamos un enfoque basado en sistemas:</p><ul class="list-disc pl-5 space-y-1 mt-1"><li>Monitorización 24/7</li><li>Equipo de QA dedicado</li><li>Seguimiento de rendimiento por chatter</li><li>Optimización continua</li></ul><p>Todo se mide y se mejora constantemente.</p>`,
          },
          {
            q: "¿Puedo parar cuando quiera?",
            a: `<p>Sí.</p><p>No atamos a las creadoras con contratos a largo plazo.</p><p>Solo trabajamos juntos si tiene sentido para ambas partes.</p>`,
          },
          {
            q: "¿Cómo funcionan los pagos?",
            a: `<p>Trabajamos con un modelo basado en rendimiento.</p><p>Eso significa que solo ganamos dinero si tú ganas más.</p><p>Los detalles se discuten durante la llamada de evaluación para adaptarse a tu situación específica.</p>`,
          },
          {
            q: "¿Para quién NO es esto?",
            a: `<p>Para creadoras que no son consistentes, no se toman esto en serio o están empezando.</p><p>No trabajamos con todo el mundo.</p><p>Trabajamos con creadoras que ya tienen tracción y quieren escalar sus ingresos correctamente.<br />Nos centramos en construir sistemas — no en perseguir picos a corto plazo.</p>`,
          },
        ].map((faq, idx) => (
          <details class={`group ${idx === 0 ? 'border-y' : 'border-b'} hover:bg-on-surface/[0.02] transition-colors`} style="border-color:rgba(17,17,17,0.12);">
            <summary class="py-7 flex items-center justify-between cursor-pointer list-none select-none">
              <span class="font-display text-lg md:text-xl text-on-surface pr-6">{faq.q}</span>
              <span class="material-symbols-outlined expand-icon flex-shrink-0 transition-transform duration-300" style="color:#707B66;">add</span>
            </summary>
            <div class="pb-8 text-on-surface-variant text-sm md:text-base leading-relaxed flex flex-col gap-3 max-w-2xl" set:html={faq.a}></div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>
