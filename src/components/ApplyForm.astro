---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    headline: 'Ready for your next level?',
    subheadline: 'Apply to work with Mango. If we believe there’s potential together, we’ll invite you to a private evaluation call to see if we’re the right fit for each other.',
    formTitle: 'Application',
    name: 'Name / Stage Name',
    instagram: 'Instagram',
    instagramHint: 'We’ll review your profile to understand your potential',
    contact: 'Telegram / WhatsApp',
    contactHint: 'We’ll contact you here if there’s a fit',
    situation: 'What best describes your situation?',
    situationPlaceholder: 'Select one',
    situation1: 'Just starting',
    situation2: 'Growing but inconsistent',
    situation3: '$5k–$20k/month',
    situation4: '$20k+/month',
    goal: 'What’s your current situation and what’s holding you back?',
    income: 'Current monthly revenue (optional)',
    incomeHint: 'Helps us understand how to scale your account',
    incomePlaceholder: 'e.g. $3,200',
    submit: 'Apply for review',
    check1: 'Applications reviewed within 24–48h',
    check2: 'Only selected creators will be contacted',
    privacy: 'Your data is treated confidentially.',
    success: 'Application sent. We’ll reach out within 24–48h if selected.',
    error: 'Something went wrong. Try again or reach us at hello@mangova.agency',
  },
  es: {
    headline: '¿Lista para tu siguiente nivel?',
    subheadline: 'Aplica para trabajar con Mango. Si creemos que hay potencial juntos, te invitaremos a una llamada privada de evaluación para ver si encajamos.',
    formTitle: 'Solicitud',
    name: 'Nombre / Nombre artístico',
    instagram: 'Instagram',
    instagramHint: 'Revisaremos tu perfil para entender tu potencial',
    contact: 'Telegram / WhatsApp',
    contactHint: 'Te contactaremos por aquí si encajamos',
    situation: '¿Qué describe mejor tu situación?',
    situationPlaceholder: 'Selecciona una',
    situation1: 'Empezando',
    situation2: 'Creciendo pero inconsistente',
    situation3: '$5k–$20k/mes',
    situation4: '$20k+/mes',
    goal: '¿Cuál es tu situación actual y qué te está frenando?',
    income: 'Ingresos mensuales actuales (opcional)',
    incomeHint: 'Nos ayuda a entender cómo escalar tu cuenta',
    incomePlaceholder: 'ej. $3.200',
    submit: 'Solicitar revisión',
    check1: 'Las solicitudes se revisan en 24–48h',
    check2: 'Solo las creadoras seleccionadas serán contactadas',
    privacy: 'Tus datos se tratan de forma confidencial.',
    success: 'Solicitud enviada. Te contactaremos en 24–48h si eres seleccionada.',
    error: 'Algo salió mal. Inténtalo de nuevo o escríbenos a hello@mangova.agency',
  },
}[lang];
---

<section id="apply" class="py-32 md:py-44 bg-white">
  <div class="max-w-2xl mx-auto px-6 lg:px-8 flex flex-col items-center gap-10 md:gap-14">

    <!-- Editorial header -->
    <div class="flex flex-col items-center gap-6 text-center">
      <span class="text-[11px] font-semibold tracking-[0.3em] uppercase text-on-surface-variant">{t.formTitle}</span>
      <h2 class="font-display text-5xl md:text-7xl text-on-surface leading-[1.05]">{t.headline}</h2>
      <p class="text-on-surface-variant text-base md:text-lg leading-relaxed max-w-xl">{t.subheadline}</p>
    </div>

    <!-- Hairline divider -->
    <div class="w-16 h-px" style="background-color:#C8A96A;"></div>

    <!-- Form (no card, open layout) -->
    <form id="apply-form" class="flex flex-col gap-7 w-full max-w-xl">
      <div>
        <label for="name" class="text-[10px] font-semibold uppercase tracking-[0.22em] text-on-surface-variant mb-2 block">{t.name}</label>
        <input type="text" id="name" name="name" required
          class="w-full bg-transparent border-0 border-b border-outline-variant/60 px-0 py-3 text-base text-on-surface focus:outline-none focus:border-on-surface transition-colors" />
      </div>

      <div>
        <label for="instagram" class="text-[10px] font-semibold uppercase tracking-[0.22em] text-on-surface-variant mb-2 block">{t.instagram}</label>
        <input type="text" id="instagram" name="instagram" required
          class="w-full bg-transparent border-0 border-b border-outline-variant/60 px-0 py-3 text-base text-on-surface focus:outline-none focus:border-on-surface transition-colors" />
        <p class="text-xs text-outline mt-2">{t.instagramHint}</p>
      </div>

      <div>
        <label for="contact" class="text-[10px] font-semibold uppercase tracking-[0.22em] text-on-surface-variant mb-2 block">{t.contact}</label>
        <input type="text" id="contact" name="contact" required
          class="w-full bg-transparent border-0 border-b border-outline-variant/60 px-0 py-3 text-base text-on-surface focus:outline-none focus:border-on-surface transition-colors" />
        <p class="text-xs text-outline mt-2">{t.contactHint}</p>
      </div>

      <div>
        <label for="situation" class="text-[10px] font-semibold uppercase tracking-[0.22em] text-on-surface-variant mb-2 block">{t.situation}</label>
        <select id="situation" name="situation" required
          class="w-full bg-transparent border-0 border-b border-outline-variant/60 px-0 py-3 text-base text-on-surface focus:outline-none focus:border-on-surface transition-colors appearance-none cursor-pointer">
          <option value="" disabled selected>{t.situationPlaceholder}</option>
          <option value="just-starting">{t.situation1}</option>
          <option value="growing-inconsistent">{t.situation2}</option>
          <option value="5k-20k">{t.situation3}</option>
          <option value="20k-plus">{t.situation4}</option>
        </select>
      </div>

      <div>
        <label for="goal" class="text-[10px] font-semibold uppercase tracking-[0.22em] text-on-surface-variant mb-2 block">{t.goal}</label>
        <textarea id="goal" name="goal" rows="3"
          class="w-full bg-transparent border-0 border-b border-outline-variant/60 px-0 py-3 text-base text-on-surface focus:outline-none focus:border-on-surface transition-colors resize-none"></textarea>
      </div>

      <div>
        <label for="income" class="text-[10px] font-semibold uppercase tracking-[0.22em] text-on-surface-variant mb-2 block">{t.income}</label>
        <input type="text" id="income" name="income" placeholder={t.incomePlaceholder}
          class="w-full bg-transparent border-0 border-b border-outline-variant/60 px-0 py-3 text-base text-on-surface placeholder:text-outline focus:outline-none focus:border-on-surface transition-colors" />
        <p class="text-xs text-outline mt-2">{t.incomeHint}</p>
      </div>

      <button type="submit" id="submit-btn"
        class="bg-accent text-black font-bold py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all w-full mt-4">
        {t.submit}
      </button>

      <div class="flex flex-col gap-2 mt-2 items-center text-center">
        <p class="text-xs text-on-surface-variant">{t.check1}</p>
        <p class="text-xs text-on-surface-variant">{t.check2}</p>
        <p class="flex items-center justify-center gap-1.5 text-xs text-outline mt-1">
          <span class="material-symbols-outlined" style="font-size:14px;">lock</span>
          {t.privacy}
        </p>
      </div>
    </form>

    <!-- Success state -->
    <div id="form-success" class="hidden text-center py-12 max-w-xl">
      <span class="material-symbols-outlined mb-4 block" style="font-size:48px;font-variation-settings:'FILL' 1; color:#C8A96A;">check_circle</span>
      <p class="text-on-surface text-lg md:text-xl">{t.success}</p>
    </div>

    <!-- Error state -->
    <div id="form-error" class="hidden text-center py-4">
      <p class="text-error text-sm">{t.error}</p>
    </div>

  </div>
</section>

<script is:inline>
  document.getElementById('apply-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('submit-btn');
    const originalLabel = btn.textContent;
    const successEl = document.getElementById('form-success');
    const errorEl = document.getElementById('form-error');

    btn.disabled = true;
    btn.textContent = '...';
    errorEl.classList.add('hidden');

    const data = {
      name: form.name.value,
      instagram: form.instagram.value,
      contact: form.contact.value,
      situation: form.situation.value,
      goal: form.goal.value,
      income: form.income.value,
    };

    try {
      const res = await fetch('/api/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
      } else {
        throw new Error('Request failed');
      }
    } catch {
      errorEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = originalLabel;
    }
  });
</script>
