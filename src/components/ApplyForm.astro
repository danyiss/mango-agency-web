---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    headline: 'Apply to work with Mango.',
    sub2: 'If there’s a strong fit, our team will contact you personally to see if we’re the right fit for each other.',
    name: 'Name / Stage Name',
    namePlaceholder: 'Your name',
    instagram: 'Instagram',
    instagramPlaceholder: '@yourhandle',
    instagramHint: 'We’ll review your profile to understand your potential',
    contact: 'Telegram / WhatsApp',
    contactPlaceholder: '@username or +country phone',
    contactHint: 'We’ll contact you here if there’s a fit',
    situation: 'What best describes your situation?',
    situationPlaceholder: 'Select one',
    situation1: 'Just starting',
    situation2: 'Growing but inconsistent',
    situation3: '$5k–$20k/month',
    situation4: '$20k+/month',
    goal: 'What’s your current situation and what’s holding you back?',
    goalPlaceholder: 'Tell us briefly where you are and what you need',
    income: 'Current monthly revenue (optional)',
    incomeHint: 'Helps us understand how to scale your account',
    incomePlaceholder: 'e.g. $3,200',
    submit: 'Apply to work with us',
    note1: 'Applications reviewed within 24–48h.',
    note2: 'Only selected creators will be contacted.',
    note3: 'All information shared is kept confidential.',
    success: 'Application sent. We’ll reach out within 24–48h if selected.',
    error: 'Something went wrong. Try again or reach us at hello@mangova.agency',
  },
  es: {
    headline: 'Aplica para trabajar con Mango.',
    sub2: 'Si vemos un encaje claro, nuestro equipo te contactará personalmente para ver si somos el match adecuado para ambas.',
    name: 'Nombre / Nombre artístico',
    namePlaceholder: 'Tu nombre',
    instagram: 'Instagram',
    instagramPlaceholder: '@tuusuario',
    instagramHint: 'Revisaremos tu perfil para entender tu potencial',
    contact: 'Telegram / WhatsApp',
    contactPlaceholder: '@usuario o +tel con prefijo',
    contactHint: 'Te contactaremos por aquí si encajamos',
    situation: '¿Qué describe mejor tu situación?',
    situationPlaceholder: 'Selecciona una',
    situation1: 'Empezando',
    situation2: 'Creciendo pero inconsistente',
    situation3: '$5k–$20k/mes',
    situation4: '$20k+/mes',
    goal: '¿Cuál es tu situación actual y qué te está frenando?',
    goalPlaceholder: 'Cuéntanos brevemente dónde estás y qué necesitas',
    income: 'Ingresos mensuales actuales (opcional)',
    incomeHint: 'Nos ayuda a entender cómo escalar tu cuenta',
    incomePlaceholder: 'ej. $3.200',
    submit: 'Aplicar para trabajar con nosotros',
    note1: 'Las solicitudes se revisan en 24–48h.',
    note2: 'Solo las creadoras seleccionadas serán contactadas.',
    note3: 'Toda la información compartida se trata de forma confidencial.',
    success: 'Solicitud enviada. Te contactaremos en 24–48h si eres seleccionada.',
    error: 'Algo salió mal. Inténtalo de nuevo o escríbenos a hello@mangova.agency',
  },
}[lang];
---

<section id="apply" class="relative py-36 md:py-52 grain" style="background-color:#111111;">
  <div class="max-w-2xl mx-auto px-6 lg:px-8 flex flex-col items-center gap-14">

    <!-- Editorial header -->
    <div class="flex flex-col items-center gap-7 text-center max-w-xl">
      <h2 class="font-display text-5xl md:text-7xl lg:text-8xl text-white leading-[0.94] tracking-[-0.025em]">{t.headline}</h2>
      <p class="text-white/65 text-base md:text-lg leading-relaxed max-w-md">{t.sub2}</p>
    </div>

    <!-- Hairline divider in champagne gold -->
    <div class="w-12 h-px" style="background-color:#C8A96A;"></div>

    <!-- Form (dark glass container) -->
    <div class="w-full rounded-2xl" style="background-color:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);">
      <div class="px-7 md:px-12 py-12 md:py-14">
        <form id="apply-form" class="flex flex-col gap-8 w-full">
          <div>
            <label for="name" class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/75 mb-3 block">{t.name}</label>
            <input type="text" id="name" name="name" required placeholder={t.namePlaceholder}
              class="w-full bg-transparent border-0 border-b border-white/25 px-0 py-2.5 text-base text-white placeholder:text-white/30 focus:outline-none focus:border-white/70 transition-colors" />
          </div>

          <div>
            <label for="instagram" class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/75 mb-3 block">{t.instagram}</label>
            <input type="text" id="instagram" name="instagram" required placeholder={t.instagramPlaceholder}
              class="w-full bg-transparent border-0 border-b border-white/25 px-0 py-2.5 text-base text-white placeholder:text-white/30 focus:outline-none focus:border-white/70 transition-colors" />
            <p class="text-xs text-white/45 mt-2">{t.instagramHint}</p>
          </div>

          <div>
            <label for="contact" class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/75 mb-3 block">{t.contact}</label>
            <input type="text" id="contact" name="contact" required placeholder={t.contactPlaceholder}
              class="w-full bg-transparent border-0 border-b border-white/25 px-0 py-2.5 text-base text-white placeholder:text-white/30 focus:outline-none focus:border-white/70 transition-colors" />
            <p class="text-xs text-white/45 mt-2">{t.contactHint}</p>
          </div>

          <div>
            <label for="situation" class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/75 mb-3 block">{t.situation}</label>
            <select id="situation" name="situation" required
              class="w-full bg-transparent border-0 border-b border-white/25 px-0 py-2.5 text-base text-white focus:outline-none focus:border-white/70 transition-colors appearance-none cursor-pointer">
              <option value="" disabled selected style="background-color:#111111;color:rgba(255,255,255,0.5);">{t.situationPlaceholder}</option>
              <option value="just-starting" style="background-color:#111111;">{t.situation1}</option>
              <option value="growing-inconsistent" style="background-color:#111111;">{t.situation2}</option>
              <option value="5k-20k" style="background-color:#111111;">{t.situation3}</option>
              <option value="20k-plus" style="background-color:#111111;">{t.situation4}</option>
            </select>
          </div>

          <div>
            <label for="goal" class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/75 mb-3 block">{t.goal}</label>
            <textarea id="goal" name="goal" rows="3" placeholder={t.goalPlaceholder}
              class="w-full bg-transparent border-0 border-b border-white/25 px-0 py-2.5 text-base text-white placeholder:text-white/30 focus:outline-none focus:border-white/70 transition-colors resize-none"></textarea>
          </div>

          <div>
            <label for="income" class="text-[11px] font-semibold uppercase tracking-[0.22em] text-white/75 mb-3 block">{t.income}</label>
            <input type="text" id="income" name="income" placeholder={t.incomePlaceholder}
              class="w-full bg-transparent border-0 border-b border-white/25 px-0 py-2.5 text-base text-white placeholder:text-white/30 focus:outline-none focus:border-white/70 transition-colors" />
            <p class="text-xs text-white/45 mt-2">{t.incomeHint}</p>
          </div>

          <button type="submit" id="submit-btn"
            class="bg-accent text-black font-bold py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all w-full mt-4">
            {t.submit}
          </button>

          <div class="flex flex-col gap-1.5 mt-4 items-center text-center">
            <p class="text-xs text-white/55">{t.note1}</p>
            <p class="text-xs text-white/55">{t.note2}</p>
            <p class="text-xs text-white/55">{t.note3}</p>
          </div>
        </form>

        <!-- Success state -->
        <div id="form-success" class="hidden text-center py-10">
          <span class="material-symbols-outlined mb-4 block" style="font-size:48px;font-variation-settings:'FILL' 1; color:#C8A96A;">check_circle</span>
          <p class="text-white text-lg md:text-xl">{t.success}</p>
        </div>

        <!-- Error state -->
        <div id="form-error" class="hidden text-center py-4">
          <p class="text-error text-sm">{t.error}</p>
        </div>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  document.getElementById('apply-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('submit-btn');
    const originalLabel = btn.textContent;
    const successEl = document.getElementById('form-success');
    const errorEl = document.getElementById('form-error');

    btn.disabled = true;
    btn.textContent = '...';
    errorEl.classList.add('hidden');

    const data = {
      name: form.name.value,
      instagram: form.instagram.value,
      contact: form.contact.value,
      situation: form.situation.value,
      goal: form.goal.value,
      income: form.income.value,
    };

    try {
      const res = await fetch('/api/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
      } else {
        throw new Error('Request failed');
      }
    } catch {
      errorEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = originalLabel;
    }
  });
</script>
