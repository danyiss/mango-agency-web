---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const t = {
  en: {
    headline: 'Start maximizing your agency’s revenue.',
    subheadline: 'Increase revenue per model through structured chatting systems.',
    formTitle: 'Partner application',
    agencyName: 'Agency / Brand Name',
    instagram: 'Main Instagram / Agency Page',
    contact: 'Telegram / WhatsApp',
    accounts: 'How many accounts are you looking to scale?',
    accountsPlaceholder: 'Select range',
    accountOptions: [
      { value: '1', label: '1' },
      { value: '2-5', label: '2–5' },
      { value: '5-10', label: '5–10' },
      { value: '10-plus', label: '10+' },
    ],
    revenue: 'Average monthly revenue per creator/account',
    revenuePlaceholder: 'Select range',
    revenueOptions: [
      { value: 'under-5k', label: 'Under $5k/month' },
      { value: '5k-20k', label: '$5k–$20k/month' },
      { value: '20k-50k', label: '$20k–$50k/month' },
      { value: '50k-100k', label: '$50k–$100k/month' },
      { value: '100k-plus', label: '$100k+/month' },
    ],
    challenge: 'What is your biggest monetization challenge?',
    challengePlaceholder: 'Select one',
    challengeOptions: [
      { value: 'low-revenue', label: 'Low revenue per model' },
      { value: 'no-spend', label: 'Fans subscribe but don’t spend' },
      { value: 'stop-spending', label: 'Buyers stop spending too quickly' },
      { value: 'inconsistent', label: 'Inconsistent chatting quality' },
      { value: 'weak-retention', label: 'Weak retention and renewals' },
      { value: 'no-system', label: 'No structured chatting system' },
      { value: 'scaling', label: 'Scaling monetization across multiple models' },
      { value: 'no-control', label: 'Lack of control over chatting performance' },
      { value: 'other', label: 'Other' },
    ],
    submit: 'Apply for partnership',
    check1: 'Applications reviewed within 24–48h',
    check2: 'We only work with a limited number of partners',
    success: 'Application sent. We’ll reach out within 24–48h if there’s a fit.',
    error: 'Something went wrong. Try again or reach us at hello@mangova.agency',
  },
  es: {
    headline: 'Empieza a maximizar los ingresos de tu agencia.',
    subheadline: 'Aumenta los ingresos por modelo con sistemas de chatting estructurados.',
    formTitle: 'Solicitud de partner',
    agencyName: 'Nombre / Marca de la agencia',
    instagram: 'Instagram principal / Página de la agencia',
    contact: 'Telegram / WhatsApp',
    accounts: '¿Cuántas cuentas quieres escalar?',
    accountsPlaceholder: 'Selecciona rango',
    accountOptions: [
      { value: '1', label: '1' },
      { value: '2-5', label: '2–5' },
      { value: '5-10', label: '5–10' },
      { value: '10-plus', label: '10+' },
    ],
    revenue: 'Ingresos mensuales medios por creadora/cuenta',
    revenuePlaceholder: 'Selecciona rango',
    revenueOptions: [
      { value: 'under-5k', label: 'Menos de $5k/mes' },
      { value: '5k-20k', label: '$5k–$20k/mes' },
      { value: '20k-50k', label: '$20k–$50k/mes' },
      { value: '50k-100k', label: '$50k–$100k/mes' },
      { value: '100k-plus', label: '$100k+/mes' },
    ],
    challenge: '¿Cuál es tu mayor reto de monetización?',
    challengePlaceholder: 'Selecciona una',
    challengeOptions: [
      { value: 'low-revenue', label: 'Ingresos bajos por modelo' },
      { value: 'no-spend', label: 'Los fans se suscriben pero no gastan' },
      { value: 'stop-spending', label: 'Los compradores dejan de gastar demasiado rápido' },
      { value: 'inconsistent', label: 'Calidad de chatting inconsistente' },
      { value: 'weak-retention', label: 'Retención y renovaciones débiles' },
      { value: 'no-system', label: 'Sin sistema de chatting estructurado' },
      { value: 'scaling', label: 'Escalar la monetización entre múltiples modelos' },
      { value: 'no-control', label: 'Falta de control sobre el rendimiento del chatting' },
      { value: 'other', label: 'Otro' },
    ],
    submit: 'Solicitar partnership',
    check1: 'Las solicitudes se revisan en 24–48h',
    check2: 'Solo trabajamos con un número limitado de partners',
    success: 'Solicitud enviada. Te contactaremos en 24–48h si encajamos.',
    error: 'Algo salió mal. Inténtalo de nuevo o escríbenos a hello@mangova.agency',
  },
}[lang];
---

<!-- Intro block (pre-form CTA) -->
<section class="pt-24 md:pt-28 pb-8 bg-white">
  <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center flex flex-col gap-5">
    <h2 class="font-display text-4xl md:text-6xl text-on-surface leading-[1.05]">{t.headline}</h2>
    <p class="text-on-surface-variant text-lg md:text-xl leading-relaxed max-w-2xl mx-auto">{t.subheadline}</p>
  </div>
</section>

<!-- Form -->
<section id="agency-apply" class="pb-24 md:pb-28 bg-white">
  <div class="max-w-2xl mx-auto px-6 lg:px-8">
    <div class="bg-surface-container-lowest border border-outline-variant/20 rounded-2xl p-7 md:p-9">
      <h3 class="text-[11px] font-bold uppercase tracking-[0.22em] text-outline mb-5">{t.formTitle}</h3>
      <form id="agency-apply-form" class="flex flex-col gap-4">
        <div>
          <label for="agencyName" class="text-[11px] font-bold uppercase tracking-[0.18em] text-on-surface-variant mb-1.5 block">{t.agencyName}</label>
          <input type="text" id="agencyName" name="agencyName" required
            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
        </div>

        <div>
          <label for="instagram" class="text-[11px] font-bold uppercase tracking-[0.18em] text-on-surface-variant mb-1.5 block">{t.instagram}</label>
          <input type="text" id="instagram" name="instagram" required
            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
        </div>

        <div>
          <label for="contact" class="text-[11px] font-bold uppercase tracking-[0.18em] text-on-surface-variant mb-1.5 block">{t.contact}</label>
          <input type="text" id="contact" name="contact" required
            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
        </div>

        <div>
          <label for="accounts" class="text-[11px] font-bold uppercase tracking-[0.18em] text-on-surface-variant mb-1.5 block">{t.accounts}</label>
          <select id="accounts" name="accounts" required
            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all appearance-none cursor-pointer">
            <option value="" disabled selected>{t.accountsPlaceholder}</option>
            {t.accountOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="revenue" class="text-[11px] font-bold uppercase tracking-[0.18em] text-on-surface-variant mb-1.5 block">{t.revenue}</label>
          <select id="revenue" name="revenue" required
            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all appearance-none cursor-pointer">
            <option value="" disabled selected>{t.revenuePlaceholder}</option>
            {t.revenueOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="challenge" class="text-[11px] font-bold uppercase tracking-[0.18em] text-on-surface-variant mb-1.5 block">{t.challenge}</label>
          <select id="challenge" name="challenge" required
            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-4 py-2.5 text-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all appearance-none cursor-pointer">
            <option value="" disabled selected>{t.challengePlaceholder}</option>
            {t.challengeOptions.map(opt => (
              <option value={opt.value}>{opt.label}</option>
            ))}
          </select>
        </div>

        <button type="submit" id="agency-submit-btn"
          class="bg-accent text-black font-bold py-3.5 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all w-full mt-3">
          {t.submit}
        </button>

        <div class="flex flex-col gap-1.5 mt-2">
          <div class="flex items-center gap-2 text-xs text-on-surface-variant">
            <span class="material-symbols-outlined text-primary" style="font-size:16px;font-variation-settings:'FILL' 1;">check_circle</span>
            {t.check1}
          </div>
          <div class="flex items-center gap-2 text-xs text-on-surface-variant">
            <span class="material-symbols-outlined text-primary" style="font-size:16px;font-variation-settings:'FILL' 1;">check_circle</span>
            {t.check2}
          </div>
        </div>
      </form>

      <div id="agency-form-success" class="hidden text-center py-10">
        <span class="material-symbols-outlined text-primary mb-4 block" style="font-size:48px;font-variation-settings:'FILL' 1;">check_circle</span>
        <p class="text-on-surface font-bold text-lg">{t.success}</p>
      </div>

      <div id="agency-form-error" class="hidden text-center py-4">
        <p class="text-error text-sm">{t.error}</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById('agency-apply-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = document.getElementById('agency-submit-btn');
    const originalLabel = btn.textContent;
    const successEl = document.getElementById('agency-form-success');
    const errorEl = document.getElementById('agency-form-error');

    btn.disabled = true;
    btn.textContent = '...';
    errorEl.classList.add('hidden');

    const data = {
      agencyName: form.agencyName.value,
      instagram: form.instagram.value,
      contact: form.contact.value,
      accounts: form.accounts.value,
      revenue: form.revenue.value,
      challenge: form.challenge.value,
    };

    try {
      const res = await fetch('/api/apply-agency', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successEl.classList.remove('hidden');
      } else {
        throw new Error('Request failed');
      }
    } catch {
      errorEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = originalLabel;
    }
  });
</script>
