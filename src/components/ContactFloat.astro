---
import { waLink, tgLink, hasWhatsapp, hasTelegram } from '../data/contact';

interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;

const t = {
  en: {
    open: 'Contact us',
    wa: 'WhatsApp',
    tg: 'Telegram',
    msg: "Hi MANGO, I'm coming from your website and I'd like more info about the agency.",
  },
  es: {
    open: 'Escríbenos',
    wa: 'WhatsApp',
    tg: 'Telegram',
    msg: 'Hola MANGO, vengo de vuestra web y me gustaría más información sobre la agencia.',
  },
}[lang];

const wa = hasWhatsapp() ? waLink(t.msg) : null;
const tg = hasTelegram() ? tgLink() : null;
const pill = 'cf-pill flex items-center gap-2.5 pl-3.5 pr-4 py-2.5 rounded-full text-[13px] font-semibold text-white whitespace-nowrap';
---

{(wa || tg) && (
  <div id="contact-float" class="fixed z-40 bottom-5 right-5 md:bottom-7 md:right-7 flex flex-col items-end gap-2.5">
    <div id="cf-actions" class="flex flex-col items-end gap-2.5" aria-hidden="true">
      {wa && (
        <a href={wa} target="_blank" rel="noopener" class={pill} data-contact="whatsapp">
          <svg viewBox="0 0 24 24" class="w-[17px] h-[17px] shrink-0" fill="#25D366" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.8 11.8 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.9 11.9 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413"/>
          </svg>
          {t.wa}
        </a>
      )}
      {tg && (
        <a href={tg} target="_blank" rel="noopener" class={pill} data-contact="telegram">
          <svg viewBox="0 0 24 24" class="w-[17px] h-[17px] shrink-0" fill="#29A9EB" aria-hidden="true">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.5.5 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024q-.16.036-5.061 3.345-.719.494-1.302.48c-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789q.04-.324.893-.663c3.498-1.524 5.83-2.529 6.998-3.015 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          {t.tg}
        </a>
      )}
    </div>

    <button type="button" id="cf-toggle" aria-expanded="false" aria-controls="cf-actions" aria-label={t.open}
      class="w-14 h-14 rounded-full flex items-center justify-center transition-transform hover:scale-105 active:scale-95"
      style="background-color:#C8A96A; box-shadow:0 10px 30px -8px rgba(0,0,0,0.65), 0 0 0 1px rgba(255,255,255,0.06);">
      <svg id="cf-icon-chat" viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="#0a0a0a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
      <svg id="cf-icon-close" viewBox="0 0 24 24" class="w-6 h-6 hidden" fill="none" stroke="#0a0a0a" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <style>
    /* Las pastillas nacen ocultas y suben al abrir: sin esto el usuario se come
       dos enlaces flotantes fijos tapando la pagina en movil. */
    #cf-actions { opacity: 0; transform: translateY(8px); pointer-events: none; transition: opacity .25s ease, transform .25s ease; }
    #contact-float.is-open #cf-actions { opacity: 1; transform: translateY(0); pointer-events: auto; }
    .cf-pill { background-color: rgba(18,18,18,.94); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(8px); box-shadow: 0 10px 28px -10px rgba(0,0,0,.7); transition: border-color .2s ease, transform .2s ease; }
    .cf-pill:hover { border-color: rgba(200,169,106,.6); transform: translateX(-2px); }
    @media (prefers-reduced-motion: reduce) { #cf-actions, .cf-pill { transition: none; } }
  </style>

  <script is:inline>
    (function () {
      var box = document.getElementById('contact-float');
      var btn = document.getElementById('cf-toggle');
      if (!box || !btn) return;
      var chat = document.getElementById('cf-icon-chat');
      var close = document.getElementById('cf-icon-close');
      var acts = document.getElementById('cf-actions');
      function set(open) {
        box.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        acts.setAttribute('aria-hidden', open ? 'false' : 'true');
        chat.classList.toggle('hidden', open);
        close.classList.toggle('hidden', !open);
      }
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        set(!box.classList.contains('is-open'));
      });
      // Cerrar al tocar fuera o con Escape: si no, en movil se queda abierto tapando.
      document.addEventListener('click', function (e) { if (!box.contains(e.target)) set(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
    })();
  </script>
)}
