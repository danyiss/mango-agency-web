---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getLocalizedPath, type Lang } from '../i18n/translations';
import { cities } from '../data/cities';
import ContactFloat from '../components/ContactFloat.astro';

interface Props {
  title: string;
  description?: string;
  activeNav?: string;
  lang?: Lang;
  ogImage?: string;
  transparentTop?: boolean;
}

const currentLang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const altLang = currentLang === 'en' ? 'es' : 'en';

const defaultOgImage = currentLang === 'es' ? '/og-image-es.png' : '/og-image.png';
const { title, description = t('home.hero.subtitle'), activeNav = '', ogImage = defaultOgImage, transparentTop = false } = Astro.props;
const buildDate = new Date();
const currentYear = buildDate.getFullYear();
const buildDateIso = buildDate.toISOString().slice(0, 10);
const buildDateLabel = currentLang === 'es'
  ? buildDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
  : buildDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Canonical and alternate URLs
const siteUrl = 'https://www.mangova.agency';
const basePath = Astro.url.pathname.replace(/^\/(es|en)/, '').replace(/\/$/, '') || '/';
const canonicalUrl = `${siteUrl}${Astro.url.pathname.replace(/\/$/, '') || '/'}`;
const altUrl = altLang === 'en' ? basePath : `/es${basePath === '/' ? '' : basePath}`;
const altFullUrl = `${siteUrl}${altUrl}`;
const ogImageUrl = `${siteUrl}${ogImage}`;

function localPath(path: string) {
  return getLocalizedPath(path, currentLang);
}

// Canonical brand definition — the "MANGO is..." passage AI engines and
// search engines will read as the authoritative entity description. Kept
// in schema only so the visible UI stays clean; AI engines fully ingest
// schema descriptions for entity-definition queries.
const orgDescription = currentLang === 'es'
  ? "MANGO es una agencia de gestión de OnlyFans que escala a creadoras de contenido combinando un equipo de chatting interno y dedicado, sistemas estructurados de monetización y crecimiento en redes sociales liderado por Instagram. Operando bajo un modelo basado en rendimiento, MANGO trabaja con creadoras en Europa y Asia en inglés y español — enfocada en retención, LTV del fan e ingresos mensuales predecibles, no en picos cortoplacistas."
  : "MANGO is an OnlyFans management agency that scales content creators by combining a dedicated in-house chatting team, structured monetization systems and Instagram-led social media growth. Operating on a performance-based model, MANGO works with creators in Europe and Asia in both English and Spanish — focused on retention, fan LTV and predictable monthly revenue rather than short-term spikes.";

// Organization schema (on every page) — enriched with legal entity,
// founding date, address and founder so search engines and AI engines
// can build a complete entity card.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "MANGO",
  "legalName": "AG MEDIA PRO LLC",
  "alternateName": ["Mangova Agency", "MANGO Agency"],
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "image": `${siteUrl}/og-image.png`,
  "description": orgDescription,
  "foundingDate": "2025-04",
  "numberOfEmployees": { "@type": "QuantitativeValue", "value": 1 },
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "US",
    "addressRegion": "Wyoming",
  },
  "founder": {
    "@type": "Person",
    "name": "Aitor González Rivera",
    "jobTitle": "Founder",
    "url": `${siteUrl}/about`,
    "sameAs": ["https://de.linkedin.com/in/aitorgonzalezrivera"],
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "hello@mangova.agency",
    "contactType": "sales",
    "availableLanguage": ["English", "Spanish"],
  },
  "areaServed": [
    { "@type": "Place", "name": "Europe" },
    { "@type": "Place", "name": "Asia" },
  ],
  "sameAs": [
    "https://instagram.com/mango.creators",
    "https://t.me/manna131",
    "https://de.linkedin.com/in/aitorgonzalezrivera",
  ],
};

// WebSite schema — helps Google show "MANGO" as the site name in SERP,
// and exposes a SearchAction so Google can render the sitelink search box
// for branded queries ("mango agency").
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "MANGO",
  "alternateName": "Mangova Agency",
  "url": siteUrl,
  "inLanguage": currentLang === 'es' ? 'es' : 'en',
  "publisher": { "@type": "Organization", "name": "MANGO" },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

// BreadcrumbList — derived from the URL path. Skipped on the locale-root pages
// where it would be a single-item list ("Home" -> "Home").
const breadcrumbHomeName = currentLang === 'es' ? 'Inicio' : 'Home';
const breadcrumbLabelMap: Record<string, { en: string; es: string }> = {
  '/results': { en: 'Results', es: 'Resultados' },
  '/for-agencies': { en: 'Chatting Service', es: 'Servicio de Chatting' },
  '/about': { en: 'About', es: 'Sobre MANGO' },
  '/legal': { en: 'Legal', es: 'Legal' },
  '/blog': { en: 'Blog', es: 'Blog' },
};
// Dynamic match: if the basePath is a known city slug, build a label from
// city data instead of the static map.
const citySlug = basePath.replace(/^\//, '');
const matchedCity = cities.find((c) => c.slug === citySlug);
const pageLabels = breadcrumbLabelMap[basePath]
  ?? (matchedCity ? { en: matchedCity.name, es: matchedCity.name } : undefined);
const homeUrl = currentLang === 'es' ? `${siteUrl}/es` : siteUrl;
const breadcrumbSchema = (basePath !== '/' && pageLabels)
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": breadcrumbHomeName, "item": homeUrl },
        { "@type": "ListItem", "position": 2, "name": pageLabels[currentLang], "item": canonicalUrl },
      ],
    }
  : null;
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <!-- Mark JS as available ASAP so editorial-step content only hides when the reveal observer can run -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Canonical & hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={currentLang} href={canonicalUrl} />
    <link rel="alternate" hreflang={altLang} href={altFullUrl} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${basePath}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={currentLang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:locale:alternate" content={altLang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:site_name" content="MANGO Agency" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Vercel Web Analytics (privacy-friendly visitor analytics, free on Pro). -->
    <!-- Speed Insights skipped to avoid the $10/mo upcharge — we use free
         alternatives (PageSpeed Insights, Lighthouse) for CWV monitoring. -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- Fonts — Inter is render-blocking (critical for hero text), Material Symbols is async-loaded. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet';" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" /></noscript>

    <title>{title}</title>

    <!-- Organization + WebSite Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Extra head slot for page-specific schema -->
    <slot name="head" />
  </head>
  <body class="font-body antialiased">
    <!-- Navigation -->
    <header class={`fixed top-0 left-0 right-0 z-50 glass-nav${transparentTop ? '' : ' scrolled'}`} data-transparent-top={transparentTop ? 'true' : 'false'}>
      <div class="px-4 sm:px-6 md:px-8 lg:px-10 h-16 flex items-center justify-between">
        <a href={localPath('/')} class="flex items-center" aria-label="MANGO Talent Management">
          <img src="/logo.png" alt="MANGO Talent Management" class="nav-logo h-6 md:h-7 w-auto" />
        </a>
        <nav class="hidden md:flex items-center gap-6">
          <a href={localPath('/')} class="nav-link text-sm font-medium">{t('nav.home')}</a>
          <a href={localPath('/results')} class="nav-link text-sm font-medium">{t('nav.results')}</a>
          <a href={localPath('/for-agencies')} class="nav-link text-sm font-medium">{t('nav.forAgencies')}</a>
        </nav>
        <div class="flex items-center gap-3 md:gap-4">
          <a href={altUrl} class="nav-link text-xs font-semibold uppercase tracking-wider">
            {altLang === 'en' ? 'EN' : 'ES'}
          </a>
          <a href="#apply" class="hidden sm:inline-block bg-accent text-black px-5 py-2 text-sm font-bold rounded-[7px] hover:brightness-95 hover:scale-[1.02] transition-all">
            {t('nav.applyNow')}
          </a>
          <button id="mobile-menu-btn" class="md:hidden nav-link p-2 -mr-2" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <span class="material-symbols-outlined text-[26px] block" aria-hidden="true">menu</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile menu overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-[60] bg-white hidden flex-col opacity-0 transition-opacity duration-200" role="dialog" aria-modal="true" aria-label="Navigation">
      <div class="h-16 px-4 sm:px-6 flex items-center justify-between border-b border-outline-variant/20">
        <a href={localPath('/')} class="flex items-center" aria-label="MANGO Talent Management">
          <img src="/logo.png" alt="MANGO Talent Management" class="h-6 w-auto" />
        </a>
        <button id="mobile-menu-close" class="p-2 -mr-2 text-on-surface" aria-label="Close menu">
          <span class="material-symbols-outlined text-[26px] block" aria-hidden="true">close</span>
        </button>
      </div>
      <nav class="flex-1 px-6 py-10 flex flex-col gap-6">
        <a href={localPath('/')} class="text-3xl font-black text-on-surface tracking-tight">{t('nav.home')}</a>
        <a href={localPath('/results')} class="text-3xl font-black text-on-surface tracking-tight">{t('nav.results')}</a>
        <a href={localPath('/for-agencies')} class="text-3xl font-black text-on-surface tracking-tight">{t('nav.forAgencies')}</a>
        <a href={altUrl} class="mt-2 text-xs font-semibold text-outline uppercase tracking-widest">
          {altLang === 'en' ? 'Switch to English' : 'Cambiar a Espa\u00f1ol'}
        </a>
      </nav>
      <div class="p-6 border-t border-outline-variant/20">
        <a href="#apply" class="block text-center bg-accent text-black font-bold py-4 rounded-[7px] text-sm tracking-wide hover:brightness-95 hover:scale-[1.02] transition-all" data-close-menu>
          {t('nav.applyNow')}
        </a>
      </div>
    </div>
    <script is:inline>
      (function(){
        const nav = document.querySelector('.glass-nav');
        if (nav) {
          const isTransparent = nav.dataset.transparentTop === 'true';

          // Glass effect (only when transparentTop=true) — and only while nav is visible
          if (isTransparent) {
            function syncGlass(){
              const visible = !nav.classList.contains('nav-hidden');
              if (window.scrollY > 20 && visible) nav.classList.add('scrolled');
              else if (window.scrollY <= 20) nav.classList.remove('scrolled');
            }
            syncGlass();
            window.addEventListener('scroll', syncGlass, { passive: true });
          }

          // Hide on scroll down, show on scroll up
          let lastY = window.scrollY;
          let ticking = false;
          const HIDE_AFTER = 20;   // hide as soon as user leaves the very top
          const DELTA = 6;         // ignore tiny scroll jitter
          function syncHide(){
            const y = window.scrollY;
            const dy = y - lastY;
            if (Math.abs(dy) < DELTA) { ticking = false; return; }
            const menuEl = document.getElementById('mobile-menu');
            const menuOpen = menuEl && !menuEl.classList.contains('hidden');
            if (menuOpen) { lastY = y; ticking = false; return; }
            if (dy > 0 && y > HIDE_AFTER) {
              nav.classList.add('nav-hidden');
              // On transparent-top pages also drop .scrolled so we don't
              // flash the frosted background while the bar slides off.
              if (isTransparent) nav.classList.remove('scrolled');
            } else if (dy < 0) {
              nav.classList.remove('nav-hidden');
              if (isTransparent && y > 20) nav.classList.add('scrolled');
            }
            lastY = y;
            ticking = false;
          }
          window.addEventListener('scroll', () => {
            if (!ticking) {
              window.requestAnimationFrame(syncHide);
              ticking = true;
            }
          }, { passive: true });
        }

        const menu = document.getElementById('mobile-menu');
        const btnOpen = document.getElementById('mobile-menu-btn');
        const btnClose = document.getElementById('mobile-menu-close');
        if (!menu || !btnOpen || !btnClose) return;
        function open(){
          menu.classList.remove('hidden');
          menu.classList.add('flex');
          requestAnimationFrame(() => menu.classList.replace('opacity-0', 'opacity-100'));
          document.body.style.overflow = 'hidden';
          btnOpen.setAttribute('aria-expanded', 'true');
        }
        function close(){
          menu.classList.replace('opacity-100', 'opacity-0');
          setTimeout(() => {
            menu.classList.add('hidden');
            menu.classList.remove('flex');
          }, 200);
          document.body.style.overflow = '';
          btnOpen.setAttribute('aria-expanded', 'false');
        }
        btnOpen.addEventListener('click', open);
        btnClose.addEventListener('click', close);
        // Close when any nav link inside menu is clicked
        menu.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
        document.addEventListener('keydown', e => { if (e.key === 'Escape' && !menu.classList.contains('hidden')) close(); });
      })();
    </script>

    <!-- Editorial step scroll reveal: subtle fade + rise via IntersectionObserver.
         Runs after DOM is parsed so the slot content (.editorial-step blocks) exists. -->
    <script is:inline>
      (function(){
        function init(){
          var targets = document.querySelectorAll('.editorial-step');
          if (!targets.length) return;
          if (!('IntersectionObserver' in window)) {
            targets.forEach(function(t){ t.classList.add('is-visible'); });
            return;
          }
          var io = new IntersectionObserver(function(entries){
            entries.forEach(function(entry){
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
          targets.forEach(function(t){ io.observe(t); });
          // Safety net: reveal anything still hidden after load (e.g. observer edge cases)
          window.addEventListener('load', function(){
            setTimeout(function(){
              document.querySelectorAll('.editorial-step:not(.is-visible)').forEach(function(t){
                var r = t.getBoundingClientRect();
                if (r.top < window.innerHeight && r.bottom > 0) t.classList.add('is-visible');
              });
            }, 400);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>

    <main class="pt-16">
      <slot />
    </main>

    <!-- Footer (pure black, compact editorial — brand centered as focal point) -->
    <footer class="relative overflow-hidden" style="background-color:#000000;">
      <div class="relative z-10 max-w-[1440px] mx-auto px-6 md:px-10 pt-14 md:pt-20 pb-8 md:pb-10 w-full">

        <!-- BRAND row — logo + socials centered as the focal block -->
        <div class="flex flex-col items-center gap-7 md:gap-9 pb-12 md:pb-16">
          <a href={localPath('/')} class="inline-flex items-center" aria-label="MANGO Talent Management">
            <img src="/logo.png" alt="MANGO Talent Management" class="h-14 md:h-20 lg:h-24 w-auto" style="filter:invert(1) brightness(2);" />
          </a>

          <div class="flex items-center gap-5">
            <a
              href="https://instagram.com/mango.creators"
              target="_blank"
              rel="noopener"
              aria-label="Instagram @mango.creators"
              class="inline-flex items-center justify-center text-white hover:text-white/70 transition-colors duration-300"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
            </a>
            <a
              href="https://t.me/manna131"
              target="_blank"
              rel="noopener"
              aria-label="Telegram @manna131"
              class="inline-flex items-center justify-center text-white hover:text-white/70 transition-colors duration-300"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0Zm5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.139-.26.249-.51.249l.181-2.572 4.692-4.242c.203-.18-.044-.281-.32-.101l-5.799 3.654-2.486-.78c-.54-.165-.55-.54.122-.81l9.713-3.745c.451-.164.853.107.707.717Z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Services + Company — centered as a pair below the brand -->
        <div class="grid grid-cols-2 gap-16 sm:gap-24 md:gap-32 max-w-2xl mx-auto pb-10 md:pb-14 justify-items-center">

          <!-- Services -->
          <div class="flex flex-col gap-5 md:gap-6 items-center text-center">
            <h4 class="text-[10px] uppercase tracking-[0.32em] text-white font-medium">{currentLang === 'es' ? 'Servicios' : 'Services'}</h4>
            <ul class="flex flex-col gap-2.5 md:gap-3 items-center">
              <li><a href={`${localPath('/')}#chatting-monetization`} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Chatting y Monetización' : 'Chatting & Monetization'}</span></a></li>
              <li><a href={`${localPath('/')}#social-media-growth`} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Crecimiento en Redes' : 'Social Media Growth'}</span></a></li>
              <li><a href={`${localPath('/')}#content-strategy`} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Estrategia de Contenido' : 'Content Strategy'}</span></a></li>
              <li><a href={`${localPath('/')}#personalized-management`} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Gestión de Creadora' : 'Creator Management'}</span></a></li>
              <li><a href={`${localPath('/')}#protection-support`} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Protección y Soporte' : 'Protection & Support'}</span></a></li>
            </ul>
          </div>

          <!-- Company -->
          <div class="flex flex-col gap-5 md:gap-6 items-center text-center">
            <h4 class="text-[10px] uppercase tracking-[0.32em] text-white font-medium">{currentLang === 'es' ? 'Empresa' : 'Company'}</h4>
            <ul class="flex flex-col gap-2.5 md:gap-3 items-center">
              <li><a href={localPath('/about')} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Sobre MANGO' : 'About'}</span></a></li>
              <li><a href={localPath('/results')} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Resultados' : 'Results'}</span></a></li>
              <li><a href={localPath('/for-agencies')} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Servicio de Chatting' : 'Chatting Service'}</span></a></li>
              <li><a href={localPath('/blog')} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">Blog</span></a></li>
              <li><a href={`${localPath('/')}#apply`} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Aplicar Ahora' : 'Apply Now'}</span></a></li>
              <li><a href={localPath('/legal')} class="group inline-flex items-center text-white hover:text-white/70 text-[13px] md:text-sm transition-colors duration-300"><span class="border-b border-transparent group-hover:border-white pb-[2px] transition-colors duration-300">{currentLang === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}</span></a></li>
            </ul>
          </div>

        </div>

        <!-- Quiet copyright bar -->
        <div class="pt-8 md:pt-10 border-t border-white/10 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
          <p class="text-[10px] text-white tracking-[0.28em] uppercase">&copy; {currentYear} MANGO. {currentLang === 'es' ? 'TODOS LOS DERECHOS RESERVADOS.' : 'ALL RIGHTS RESERVED.'}</p>
          <p class="text-[10px] text-white tracking-[0.28em] uppercase">{currentLang === 'es' ? 'PARA CREADORAS, POR CREADORAS.' : 'FOR CREATORS, BY CREATORS.'}</p>
        </div>
        <p class="mt-4 md:mt-6 text-[10px] text-white/40 tracking-[0.18em] uppercase text-center md:text-right">
          {currentLang === 'es' ? 'Actualizado' : 'Last updated'}: <time datetime={buildDateIso}>{buildDateLabel}</time>
        </p>
      </div>
    </footer>

    <ContactFloat lang={currentLang} />
  </body>
</html>
